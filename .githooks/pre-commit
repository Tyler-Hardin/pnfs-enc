#!/bin/sh
# Record which revision of each checkout this commit's artifacts belong with.
#
# linux/ and bcachefs-tools/ are repositories of their own, so a commit here - a
# test, a note, a regenerated patch - only means something next to the revisions
# it was made against.  That is what CHECKOUTS is, and this keeps it current
# rather than trusting whoever is committing to remember.
set -e

# Git exports its own repository location to hooks.  In a linked worktree GIT_DIR
# and GIT_INDEX_FILE are absolute paths into this worktree, and an exported
# GIT_DIR wins over `git -C`, so without this the checkouts below would answer as
# this repository - with this repository's index, so every nested checkout would
# look like it had every file deleted.  The `git add` at the end wants the
# discovery to find this repository, which it does from the working directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

root=$(git rev-parse --show-toplevel)

{
	echo "# The checkout revisions these artifacts belong with, regenerated by"
	echo "# .githooks/pre-commit on every commit (see README.md).  A revision"
	echo "# marked +dirty had uncommitted changes when this commit was made."
	for r in linux bcachefs-tools; do
		# -e, not -d: in a linked worktree of this repository the checkout
		# is itself a worktree, and its .git is a file.
		[ -e "$root/$r/.git" ] || continue
		sha=$(git -C "$root/$r" rev-parse HEAD)
		if [ -n "$(git -C "$root/$r" status --porcelain)" ]; then
			sha="$sha+dirty"
		fi
		branch=$(git -C "$root/$r" rev-parse --abbrev-ref HEAD)
		subject=$(git -C "$root/$r" log -1 --format=%s)
		printf '%-15s %s  %-8s %s\n' "$r" "$sha" "$branch" "$subject"
	done
} > "$root/CHECKOUTS"

git add "$root/CHECKOUTS"
