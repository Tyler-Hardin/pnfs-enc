 	 * So the three layers are: @opts is policy, @csum_type is intent, @crc
 	 * is fact. Anything that changes the buffer must update @crc with it.
+	 *
+	 * BCH_WRITE_encoded_only narrows that: a payload that cannot go out
+	 * exactly as it stands is refused (with more buckets asked for, so a
+	 * full write point is a retry and not a failure) rather than falling
+	 * into bch2_write_op_decode(). The encoded-extent serving path sets it
+	 * so that "the server never decoded a peer's payload" is a guarantee
+	 * rather than a hope.
 	 */
 	struct bch_extent_crc_unpacked crc;
 
diff --git a/fs/encoded_extent.c b/fs/encoded_extent.c
new file mode 100644
index 000000000..e7a38d45a
--- /dev/null
+++ b/fs/encoded_extent.c
@@ -0,0 +1,1286 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Encoded-extent serving for bcachefs.
+ *
+ * This is bcachefs's backend for the kernel's encoded_extent_ops, and so the
+ * only bcachefs-specific piece of the pNFS encoded-extent layout type: the
+ * layout, the data service and the client are filesystem-agnostic and live in
+ * the kernel tree. What bcachefs has to supply is
+ *
+ *   - unit_max/unit_align: the largest encoded payload it will produce
+ *     (encoded_extent_max) and the alignment an encoded offset and length must
+ *     respect (block_size);
+ *   - probe/read: find the extent covering a range and describe it, or hand
+ *     back its compressed, checksum-verified bytes without decoding them;
+ *   - write: store a peer's already-compressed payload through bcachefs's own
+ *     allocation and checksum path, never decoding and re-compressing it.
+ *
+ * None of that I/O is new. The rebalance/move path already reads a whole
+ * encoded unit and writes one back as it stands; the mechanism is the
+ * BCH_READ_encoded read flag (see data/read.c) and BCH_WRITE_data_encoded with
+ * a populated op->crc (see data/write.c). This file is the serving front end:
+ * it finds the extent, moves the bytes, and classifies every refusal.
+ *
+ * The contract with a peer, and what is refused on purpose:
+ *
+ *   - checksums are bcachefs's. Read verifies the stored checksum before
+ *     handing a payload back; write computes one over the bytes it received.
+ *     A peer never reproduces checksum code, and a payload is never stored
+ *     without a checksum that describes it.
+ *   - encryption is refused rather than implemented: the payload would be
+ *     ciphertext and the key is not on the wire.
+ *   - a hole, an inline extent, an uncompressed extent or a reflink target is
+ *     refused: there is no codec work to offload, or the extent is not the
+ *     peer's to reinterpret.
+ *   - a write is stored only if its codec is what the inode's own policy asks
+ *     for, and only if it is smaller than the unit. Anything else would let a
+ *     peer's payload stop matching what a local write would have produced, or
+ *     record compressed data that did not compress.
+ *
+ * Every refusal is -ENODATA, which to the data service means "not served
+ * encoded" and to the NFS client means "use the MDS instead" - always correct,
+ * just not offloaded. Anything else is a real error and is passed through.
+ *
+ * Build note: the interface and the codec registry exist only when the kernel
+ * has CONFIG_ENCODED_EXTENT_CODECS (selected by the layout type). Without it
+ * this file compiles to nothing, so bcachefs-tools still builds against a stock
+ * kernel and the export ops simply omit .encoded_extent_ops.
+ */
+
+#include "bcachefs.h"
+
+#if IS_ENABLED(CONFIG_ENCODED_EXTENT_CODECS)
+
+#include <linux/bio.h>
+#include <linux/encoded_extent.h>
+#include <linux/highmem.h>
+#include <linux/module.h>
+#include <linux/nfs4.h>
+#include <linux/slab.h>
+#include <linux/zstd.h>
+
+#include "alloc/buckets.h"
+#include "alloc/foreground.h"
+#include "btree/bkey_buf.h"
+#include "btree/iter.h"
+#include "data/checksum.h"
+#include "data/compress.h"
+#include "data/extents.h"
+#include "data/read.h"
+#include "data/write.h"
+#include "fs/inode.h"
+#include "snapshots/subvolume.h"
+#include "util/util.h"
+#include "vfs/fs.h"
+#include "vfs/io.h"
+#include "vfs/pagecache.h"
+
+/*
+ * Used by init/fs.c (registration) and vfs/fs.c (the export ops); declared
+ * here as well so the definitions have a prototype in scope.
+ */
+int bch2_encoded_extent_codecs_init(void);
+void bch2_encoded_extent_codecs_exit(void);
+
+/* ------------------------------------------------------- the encoded unit -- */
+
+/*
+ * One extent as the lookup found it: the logical offset the unit starts at, and
+ * the extent's checksum entry, which carries the codec, the payload length and
+ * the decoded length.
+ */
+struct bch_encoded_unit {
+	u64				logical_offset;
+	struct bch_extent_crc_unpacked	crc;
+	/*
+	 * Why a probe refused, when it did. Internal to this file; the probe
+	 * copies it out to the caller's descriptor, which is where a refusal
+	 * can be counted by cause rather than only counted.
+	 */
+	u32				refusal;
+};
+
+static inline u64 bch2_encoded_unit_len(const struct bch_encoded_unit *u)
+{
+	return (u64) u->crc.uncompressed_size << 9;
+}
+
+static inline u64 bch2_encoded_payload_len(const struct bch_encoded_unit *u)
+{
+	return (u64) u->crc.compressed_size << 9;
+}
+
+/*
+ * The whole encoded error class means "this range is not served encoded": a
+ * hole, an inline/encrypted/nocow/reflink extent, a codec we will not hand out.
+ * The caller's answer is ordinary I/O, so at this boundary it is -ENODATA.
+ * Anything else is a real error and keeps its meaning.
+ */
+static int bch2_encoded_err(int ret)
+{
+	if (bch2_err_matches(ret, BCH_ERR_encoded))
+		return -ENODATA;
+	return bch2_err_class(ret);
+}
+
+/* ------------------------------------------------------------- the lookup -- */
+
+/*
+ * Validate one pointer's crc against what this path requires, and fill in the
+ * parts of @out that describe it: not the reflink/hole/direct-data checks,
+ * which are about the *key*, the same for every pointer it has, but everything
+ * that is a property of the pointer bch2_bkey_pick_read_device() actually
+ * picked - compression, checksum, encryption, size.
+ *
+ * Shared between __bch2_encoded_find(), which calls this once to validate the
+ * pointer it will ask the read path to use, and bch2_encoded_read_unit(),
+ * which calls it again after the read completes: bch2_read_extent() picks its
+ * own pointer internally and may not agree with the first pick when an extent
+ * has more than one - narrow_crcs rewrites one pointer's crc in place, and a
+ * promoted or rebalanced replica can carry different compression or checksum
+ * types for the same live range. A descriptor built from the lookup's pick but
+ * a payload read via a different one would describe bytes that are not the
+ * ones the peer is about to receive, silently: not a wrong checksum (the
+ * payload is genuinely valid for *its own* crc), but the wrong codec, or the
+ * wrong frame length, for what is actually on the wire. Validating again
+ * against the pointer that was actually read is what catches that - and
+ * because it is the same code both times, a crc neither call would have
+ * accepted is refused identically wherever it turns up.
+ */
+static int bch2_encoded_unit_from_crc(struct bch_fs *c,
+				      struct bch_extent_crc_unpacked crc,
+				      u64 key_size, struct bch_encoded_unit *out)
+{
+	u64 unit_len, plain_offset, payload_len;
+
+	if (bch2_csum_type_is_encryption(crc.csum_type)) {
+		out->refusal = ENCODED_REFUSAL_ENCRYPTED;
+		return bch_err_throw(c, encoded_encrypted);
+	}
+
+	if (!bch2_checksum_type_valid(c, crc.csum_type)) {
+		out->refusal = ENCODED_REFUSAL_CSUM_INVALID;
+		return bch_err_throw(c, encoded_metadata_invalid);
+	}
+
+	/*
+	 * An extent stored without a codec has no codec work to offload: the
+	 * peer would be decoding plaintext. This is the same answer read gives,
+	 * and it is why a probe never sends a caller looking for a codec it
+	 * cannot use.
+	 */
+	if (!crc_is_compressed(crc)) {
+		out->refusal = ENCODED_REFUSAL_NOT_COMPRESSED;
+		return bch_err_throw(c, encoded_no_extent);
+	}
+
+	/*
+	 * A unit is described by its live range, not by its frame.
+	 *
+	 * The frame was written for a range of some length and the key is what
+	 * says how much of it still belongs to the file: a later write over the
+	 * extent trims or splits the key and cannot change the frame, so
+	 * uncompressed_size - the frame's plaintext length - keeps describing
+	 * bytes the key no longer owns, and crc.offset says how far into that
+	 * plaintext the live part begins. live_size is the key's size (see
+	 * bch2_extent_crc_unpack), so it is what can be handed out. The two
+	 * answer different questions - where the live range starts inside the
+	 * frame, and how long it is - and a description that gets either wrong
+	 * hands a peer bytes that are not the file's.
+	 *
+	 * A peer decodes from the frame's start, so how far it has to decode to
+	 * reach the live end is what has to fit the wire's ceiling.
+	 */
+	unit_len	= (u64) crc.live_size << 9;
+	plain_offset	= (u64) crc.offset << 9;
+	payload_len	= (u64) crc.compressed_size << 9;
+
+	if (plain_offset + unit_len > c->opts.encoded_extent_max ||
+	    payload_len > c->opts.encoded_extent_max) {
+		out->refusal = ENCODED_REFUSAL_TOO_LARGE;
+		return bch_err_throw(c, encoded_bad_size);
+	}
+
+	/*
+	 * live_size is the key's size by construction, so this cannot fire
+	 * today; it is here because everything else follows from it, and a
+	 * change that broke it would otherwise hand out a length the key does
+	 * not back.
+	 */
+	if (unit_len != key_size << 9)
+		return bch_err_throw(c, encoded_bad_size);
+
+	out->crc = crc;
+	/*
+	 * The unit's length is the live one, so the accessor everything
+	 * downstream uses reports that and not the frame's.
+	 */
+	out->crc.uncompressed_size = unit_len >> 9;
+	return 0;
+}
+
+/*
+ * Find the encoded extent covering @offset and describe it. @sk is filled with
+ * a reassembled copy of the key and @k_out points into it, because the caller's
+ * read needs a key that outlives the iterator.
+ *
+ * A refusal here is about the extent, not about I/O: everything that cannot be
+ * handed to a peer is thrown with a BCH_ERR_encoded code so the caller maps it
+ * to a fallback in one place.
+ */
+static int __bch2_encoded_find(struct btree_trans *trans, subvol_inum inum,
+			       u64 offset, struct bkey_buf *sk,
+			       struct bch_encoded_unit *out,
+			       struct bkey_s_c *k_out,
+			       unsigned *offset_into_extent)
+{
+	struct bch_fs *c = trans->c;
+	struct extent_ptr_decoded pick;
+	struct bkey_s_c k;
+	u32 snapshot;
+	int ret;
+
+	/*
+	 * bch2_trans_begin() belongs to the caller's restart loop, not here:
+	 * both callers run this inside bch2_trans_do(), whose lockrestart_do()
+	 * calls begin() and then compares the restart count it returned against
+	 * trans->restart_count when the do-block succeeds. A second begin() on
+	 * the success path would advance that count behind its back and trip
+	 * the success-after-restart check.
+	 */
+	CLASS(btree_iter, iter)(trans, BTREE_ID_extents,
+				POS(inum.inum, offset >> 9), BTREE_ITER_slots);
+
+	ret = bch2_subvolume_get_snapshot(trans, inum.subvol, &snapshot);
+	if (ret)
+		return ret;
+
+	bch2_btree_iter_set_snapshot(&iter, snapshot);
+
+	k = bch2_btree_iter_peek_slot(&iter);
+	ret = bkey_err(k);
+	if (ret)
+		return ret;
+
+	/*
+	 * Reflink targets are shared: reading one is fine, but a peer that
+	 * names one is not getting a unit it may later rewrite, so the
+	 * indirect pointer itself is refused.
+	 */
+	if (k.k->type == KEY_TYPE_reflink_p) {
+		out->refusal = ENCODED_REFUSAL_REFLINK;
+		return bch_err_throw(c, encoded_reflink);
+	}
+
+	/* Hole, reservation, inline data: no separate payload to move. */
+	if (!bkey_extent_is_direct_data(k.k)) {
+		out->refusal = ENCODED_REFUSAL_NOT_DIRECT;
+		return bch_err_throw(c, encoded_no_extent);
+	}
+
+	ret = bch2_bkey_buf_reassemble(sk, k);
+	if (ret)
+		return ret;
+	k = bkey_i_to_s_c(sk->k);
+
+	ret = bch2_bkey_pick_read_device(c, k, NULL, &pick, -1, 0);
+	if (ret < 0)
+		return ret;
+	if (!ret) {
+		out->refusal = ENCODED_REFUSAL_NO_TARGET;
+		return bch_err_throw(c, encoded_no_extent);
+	}
+
+	ret = bch2_encoded_unit_from_crc(c, pick.crc, k.k->size, out);
+	if (ret)
+		return ret;
+
+	*offset_into_extent	= iter.pos.offset - bkey_start_offset(k.k);
+	out->logical_offset	= bkey_start_offset(k.k) << 9;
+	*k_out			= k;
+	return 0;
+}
+
+static int __bch2_encoded_probe(struct btree_trans *trans, subvol_inum inum,
+				u64 offset, struct bch_encoded_unit *out)
+{
+	struct bkey_buf sk __cleanup(bch2_bkey_buf_exit);
+	struct bkey_s_c k;
+	unsigned offset_into_extent;
+
+	bch2_bkey_buf_init(&sk);
+
+	return __bch2_encoded_find(trans, inum, offset, &sk, out, &k,
+				   &offset_into_extent);
+}
+
+/* ------------------------------------------------------------- the read -- */
+
+static void bch2_encoded_read_end_io(struct bio *bio)
+{
+	complete(bio->bi_private);
+}
+
+static int __bch2_encoded_read(struct btree_trans *trans, subvol_inum inum,
+			       u64 offset, struct bch_encoded_unit *out,
+			       struct bch_read_bio *rbio)
+{
+	struct bkey_buf sk __cleanup(bch2_bkey_buf_exit);
+	struct bkey_s_c k;
+	unsigned offset_into_extent;
+	int ret;
+
+	bch2_bkey_buf_init(&sk);
+
+	ret = __bch2_encoded_find(trans, inum, offset, &sk, out, &k,
+				  &offset_into_extent);
+	if (ret)
+		return ret;
+
+	/*
+	 * The extent is known and whole: read it as it sits on disk. Anything
+	 * that can come back synchronously is a transaction restart or ENOMEM.
+	 * The caller runs this in a bch2_trans_do() restart loop, so a restart
+	 * re-enters here with a fresh transaction (and the lookup above is
+	 * redone), while ENOMEM fails the attempt and the caller falls back.
+	 * Anything after this point fails the bio.
+	 */
+	return bch2_read_extent(trans, rbio, POS(inum.inum, offset >> 9),
+				BTREE_ID_extents, k, offset_into_extent,
+				BCH_READ_encoded|BCH_READ_last_fragment);
+}
+
+/*
+ * Read the encoded unit covering @offset into @dst (capacity @dst_cap), with
+ * the payload length in *@payload_len and the descriptor in @out.
+ *
+ * The read path wants a bio, and the data service hands us a linear buffer, so
+ * the payload lands in the bio's pages first and is copied out. That extra copy
+ * is the price of keeping the I/O path exactly the one the move code uses;
+ * it is not on the decoded-data path.
+ */
+static int bch2_encoded_read_unit(struct bch_fs *c, subvol_inum inum, u64 offset,
+				  void *dst, size_t dst_cap, size_t *payload_len,
+				  struct bch_encoded_unit *out)
+{
+	struct bch_read_bio *rbio;
+	struct bio *bio;
+	size_t bytes = c->opts.encoded_extent_max;
+	DECLARE_COMPLETION_ONSTACK(done);
+	int ret;
+
+	if (offset & (ENCODED_EXTENT_SECTOR_SIZE - 1))
+		return bch_err_throw(c, encoded_bad_size);
+
+	/*
+	 * Sized for the largest payload the fs allows: the exact length is not
+	 * known until the extent is looked up, and the read path rewrites the
+	 * iterator down to it before the device sees it. The pages are attached
+	 * here so the device writes straight into them.
+	 */
+	/*
+	 * Never ask the bio layer for more vectors than it has: bvec_alloc()
+	 * BUGs rather than failing, so a unit above that ceiling is refused
+	 * here, where the caller still has somewhere to fall back to. The
+	 * ceiling is the same one bch2_encoded_extent_unit_max() advertises, so
+	 * a unit that reaches this is one this build cannot read at all.
+	 */
+	if (bytes > BIO_MAX_VECS * PAGE_SIZE)
+		return bch_err_throw(c, encoded_bad_size);
+
+	bio = bio_alloc_bioset(NULL, DIV_ROUND_UP(bytes, PAGE_SIZE),
+			       REQ_OP_READ, GFP_NOIO, &c->bio_read);
+	if (!bio)
+		return -ENOMEM;
+
+	rbio = rbio_init(bio, c, (struct bch_inode_opts) { 0 },
+			 bch2_encoded_read_end_io);
+	rbio->bio.bi_private		= &done;
+	rbio->bio.bi_iter.bi_sector	= offset >> 9;
+
+	bch2_bio_alloc_pages_pool(c, &rbio->bio, ENCODED_EXTENT_SECTOR_SIZE, bytes,
+				  GFP_NOIO|__GFP_SKIP_ZERO);
+
+	/*
+	 * A restart here is normal under btree lock contention, and it must be
+	 * consumed by a restart loop: bch2_trans_put() panics on a restarted
+	 * transaction, so a plain bch2_trans_run() would turn lock contention
+	 * into a kernel panic. bch2_trans_do() re-begins the transaction and
+	 * retries until __bch2_encoded_read() stops returning a restart.
+	 */
+	ret = bch2_trans_do(c, __bch2_encoded_read(trans, inum, offset, out, rbio));
+	if (ret)
+		goto err;
+
+	wait_for_completion(&done);
+
+	if (rbio->ret) {
+		ret = rbio->ret;
+		goto err;
+	}
+
+	/*
+	 * __bch2_encoded_find() validated the pointer it picked and filled
+	 * @out from it, but bch2_read_extent() (inside __bch2_encoded_read())
+	 * picks again, independently, and an extent with more than one pointer
+	 * can have the two disagree: narrow_crcs rewrites a single pointer's
+	 * crc in place, and a promoted or differently-recompressed replica can
+	 * carry its own compression and checksum type for the same live range.
+	 * rbio->pick is what bch2_read_extent() actually used - the device the
+	 * bytes in @bio came from - so the descriptor has to describe *that*
+	 * pick, re-validated the same way the first one was: a crc the lookup
+	 * would have refused must be refused here too, not handed to a peer
+	 * because an earlier, different pointer happened to pass.
+	 *
+	 * out->crc.uncompressed_size already carries the key's live size
+	 * (bch2_encoded_unit_from_crc() set it from k.k->size, which is a
+	 * property of the key and the same for every pointer it has), so it is
+	 * what this second validation checks the actual pick against.
+	 */
+	ret = bch2_encoded_unit_from_crc(c, rbio->pick.crc,
+					 out->crc.uncompressed_size, out);
+	if (ret)
+		goto err;
+
+	/*
+	 * The read path sized the bio to the payload, so it holds exactly
+	 * crc.compressed_size sectors - nothing to trim.
+	 */
+	if (bio_sectors(bio) != out->crc.compressed_size) {
+		ret = bch_err_throw(c, encoded_metadata_invalid);
+		goto err;
+	}
+
+	*payload_len = bch2_encoded_payload_len(out);
+	if (*payload_len > dst_cap) {
+		ret = bch_err_throw(c, encoded_bad_size);
+		goto err;
+	}
+
+	memcpy_from_bio(dst, bio, bio->bi_iter);
+	ret = 0;
+err:
+	/*
+	 * The pages came from the bounce pool and bio_put() does not return them,
+	 * so they have to go back explicitly - before the put, and in that order,
+	 * because the free zeroes bi_vcnt and the put must not see them. The
+	 * normal read path does this (fs/data/read.c). Without it a read leaked
+	 * encoded_extent_max (256 KiB by default) per unit, which is ~7.5 GiB
+	 * over a suite run: the server ran out of memory and panicked.
+	 */
+	bch2_bio_free_pages_pool(c, bio);
+	bio_put(bio);
+	return ret;
+}
+
+/* ------------------------------------------------------------ the write -- */
+
+struct bch_encoded_write {
+	struct completion	done;
+	struct bio_vec		*bvecs;
+	struct bch_write_op	op;
+};
+
+static void bch2_encoded_write_end_io(struct bch_write_op *op)
+{
+	struct bch_encoded_write *w =
+		container_of(op, struct bch_encoded_write, op);
+
+	complete(&w->done);
+}
+
+/*
+ * bch2_write_inode()'s set-fn for an encoded write: bump mtime/ctime, and grow
+ * bi_size in the btree if the request reached past it. @p is the request's own
+ * end offset (req_offset + req_len), not the frame's: see the caller.
+ */
+static int bch2_encoded_write_set_fn(struct btree_trans *trans,
+				     struct bch_inode_info *inode,
+				     struct bch_inode_unpacked *bi,
+				     void *p)
+{
+	struct bch_fs *c = trans->c;
+	u64 req_end = *(u64 *)p;
+	u64 now = bch2_current_time(c);
+
+	bi->bi_mtime = now;
+	bi->bi_ctime = now;
+	if (req_end > bi->bi_size)
+		bi->bi_size = req_end;
+
+	return 0;
+}
+
+/*
+ * A POSIX write updates mtime, ctime and - when it extends the file - i_size;
+ * the local path gets that from file_modified() plus the buffered/direct
+ * write's own i_size_write(), and a serving path that never goes through the
+ * VFS write path has to do it here.
+ *
+ * The times are not cosmetic, and what they are for is worth being precise
+ * about: this filesystem publishes no change cookie (it has no fetch_iversion
+ * and sets no SB_I_VERSION), so nfsd's change_attribute is derived from the
+ * *ctime of the VFS inode* - and a write that only touches the btree never
+ * moves it. Without this the file does not look written to anyone who asks: a
+ * second client's close-to-open check sees the same attributes and keeps
+ * serving what it had cached, and so does a local reader. Bumping the times
+ * writes the inode key, which also advances bi_journal_seq - the sequence an
+ * fsync checks.
+ *
+ * The size is handled separately from, and more carefully than, the rest of
+ * what bch2_inode_update_after_write() carries back to the VFS inode.
+ * bch2_write_inode() calls update_after_write() with the same @fields this
+ * passes to bch2_write_inode() itself, and VFS ATTR_SIZE there means
+ * "i_size_write(bi_size)" unconditionally (bch2_inode_update_after_write(),
+ * fs/vfs/fs.c) - correct for truncate/setattr, which hold i_rwsem and the
+ * pagecache block across the whole call, but not here.
+ *
+ * This path takes neither lock: it only holds bch2_pagecache_block(), which
+ * keeps a *buffered writer* from re-dirtying the unit's own range underneath
+ * the invalidation, but does nothing about a buffered write to a *different*
+ * range of the same file completing concurrently. bcachefs's own buffered
+ * write extends the VFS i_size the moment it copies into the page cache
+ * (fs/vfs/buffered.c, well before the btree catches up at writeback), so the
+ * VFS i_size legitimately runs ahead of bi_size whenever there is dirty data
+ * past what the btree has committed. Passing ATTR_SIZE through here would
+ * call i_size_write(bi_size) and pull the VFS size back down to this write's
+ * own range - behind an MDS write that has already extended it, and ahead of
+ * that MDS write's own dirty pages being written back.
+ *
+ * That clobber is not merely cosmetic either: bcachefs's writepage zeroes and
+ * undirties whatever is past i_size on every single writepage call, because a
+ * folio straddling i_size may be mmapped (fs/vfs/buffered.c). So the VFS size
+ * briefly reading low is not the bug by itself - a GETATTR racing the clobber
+ * would see a short size and nothing more - the bug is that it is also wrong
+ * at the moment writeback visits the dirty tail folio, which then discards
+ * exactly the bytes an MDS write had just placed there. A client whose writes
+ * interleave an MDS fallback (the file's unaligned tail, declined up front)
+ * with data-service writes for earlier, aligned ranges - which is the common
+ * shape, not a rare one, since the MDS write is issued immediately and the
+ * data-service write is queued behind a client-side compress - sees its own
+ * tail silently truncated back to the last encoded unit.
+ *
+ * So: never pass ATTR_SIZE to update_after_write from here. Grow bi_size in
+ * the btree (never shrink: a write in the middle of a file must not truncate
+ * it), and separately grow the VFS i_size under i_lock exactly the way
+ * bch2_dio_write_end() does for a write that also bypasses the page cache -
+ * max(current, request's end), which cannot regress a VFS size an MDS write
+ * already pushed further out, and costs nothing when this write is not the
+ * one extending the file.
+ */
+static int bch2_encoded_write_times_update(struct bch_fs *c,
+					   struct bch_inode_info *inode,
+					   u64 req_offset, u64 req_len)
+{
+	u64 req_end = req_offset + req_len;
+	int ret;
+
+	guard(mutex)(&inode->ei_update_lock);
+	ret = bch2_write_inode(c, inode, bch2_encoded_write_set_fn, &req_end,
+			       ATTR_MTIME|ATTR_CTIME);
+	if (ret)
+		return ret;
+
+	guard(spinlock)(&inode->v.i_lock);
+	if (req_end > inode->v.i_size)
+		i_size_write(&inode->v, req_end);
+
+	return 0;
+}
+
+/*
+ * Store @len bytes of @data as the encoded unit covering @offset, with the
+ * inode's own allocation options. The checksum is computed here, over the bytes
+ * actually received, which is what lets a peer skip checksum code entirely and
+ * still never store an extent its checksum does not describe.
+ */
+static int bch2_encoded_write_unit(struct bch_fs *c,
+				   struct bch_inode_info *inode,
+				   u64 req_offset, u64 req_len,
+				   const void *data, size_t len,
+				   const struct encoded_extent_write_desc *desc)
+{
+	subvol_inum inum = inode_inum(inode);
+	struct bch_inode_unpacked inode_u;
+	struct bch_inode_opts io_opts;
+	struct bch_extent_crc_unpacked crc = {};
+	struct bch_encoded_write *w;
+	struct bch_write_op *op;
+	struct bio *bio;
+	enum bch_compression_type want;
+	struct nonce nonce;
+	u8 want_csum;
+	unsigned nr_vecs;
+	size_t padded_len;
+	u64 unencoded_offset, valid_len;
+	int ret;
+
+	/*
+	 * What is being stored is a whole, block-aligned frame, and the request
+	 * range it is for has to be inside it.
+	 *
+	 * The frame is a whole number of blocks - that is the granule a key's
+	 * lengths are in - so it reaches past the request at either end. Which
+	 * of those bytes are the file's is what @req_offset/@req_len say, and
+	 * they are the only place that says it: the geometry the key needs is
+	 * derived from the two halves of the call together
+	 * (encoded_extent_unit_geometry()), so there is one computation of it
+	 * rather than two that have to be kept in step. A key that names bytes
+	 * the peer never sent is invisible everywhere else, and the write
+	 * succeeds with the wrong bytes being the file's.
+	 */
+	if (!encoded_extent_range_valid(req_offset, req_len, desc) ||
+	    !len || !req_len ||
+	    (desc->unit_offset & (block_bytes(c) - 1)) ||
+	    (desc->unit_len & (block_bytes(c) - 1)) ||
+	    desc->unit_len > c->opts.encoded_extent_max ||
+	    req_offset > MAX_LFS_FILESIZE ||
+	    req_len > MAX_LFS_FILESIZE - req_offset) {
+		return bch_err_throw(c, encoded_bad_size);
+	}
+
+	encoded_extent_unit_geometry(req_offset, req_len, desc,
+				     &unencoded_offset, &valid_len);
+
+	/*
+	 * A codec that did not shrink the unit has nothing to offload, and a
+	 * local write of that data would have recorded it as incompressible
+	 * rather than zstd - so it is not the extent the inode's policy says
+	 * this file holds. The caller falls back to ordinary I/O, which
+	 * compresses or not on its own.
+	 */
+	padded_len = round_up(len, block_bytes(c));
+	/*
+	 * Whether the codec shrank the unit is a question about the frame, not
+	 * about what the frame costs once it is padded out to a block: a 4096
+	 * byte unit whose frame is a hundred bytes compressed forty times over,
+	 * and comparing the padding instead refused it and sent the write to
+	 * the MDS - which is what made a two-unit minimum look necessary, and
+	 * that in turn is what wrote zeros over the file's own bytes.
+	 */
+	if (padded_len > c->opts.encoded_extent_max || len >= desc->unit_len) {
+		return bch_err_throw(c, encoded_bad_size);
+	}
+
+	ret = bch2_inode_find_by_inum(c, inum, &inode_u);
+	if (ret)
+		return ret;
+
+	/* Only a regular file's data is served encoded. */
+	if (!S_ISREG(inode_u.bi_mode)) {
+		return bch_err_throw(c, encoded_no_extent);
+	}
+
+	bch2_inode_opts_get_inode(c, &inode_u, &io_opts);
+
+	/*
+	 * The codec is the filesystem's policy, not the peer's choice. Comparing
+	 * it here is what keeps a file's recorded compression describing its
+	 * data: a peer that compressed with something else is refused, not
+	 * silently accepted. (A peer using a different *checksum* type is not a
+	 * problem - the write path recomputes one without decoding - but we
+	 * refuse encryption outright, because storing ciphertext without a key
+	 * is not something this interface can describe.)
+	 */
+	want = bch2_compression_opt_to_type(io_opts.compression);
+	if (desc->compression != want)
+		return bch_err_throw(c, encoded_policy_mismatch);
+
+	if ((io_opts.nocow && c->opts.nocow_enabled) || c->sb.encryption_type)
+		return bch_err_throw(c, encoded_encrypted);
+
+	want_csum = bch2_data_checksum_type(c, io_opts);
+	if (bch2_csum_type_is_encryption(want_csum))
+		return bch_err_throw(c, encoded_encrypted);
+
+	crc.compression_type	= desc->compression;
+	crc.compressed_size	= padded_len >> 9;
+	/*
+	 * The frame is the whole unit; the key is only the sectors the request
+	 * owns.
+	 *
+	 * The frame has to be desc->unit_len bytes of plaintext: that is what
+	 * the codec produced and what uncompressed_size has to say for any
+	 * reader, local or peer, to decode it. Nothing says the *key* has to
+	 * cover all of it. The request's data ends at valid_len, so the key
+	 * ends at the request's last sector: crc.offset is where the file's
+	 * bytes begin inside the frame and live_size is how many the file
+	 * owns. Ending the key with the data is what stops a write from
+	 * reaching into pages it was never given - whatever the client put in
+	 * the frame past that point (and it has to put something there) is
+	 * dead, and a later write to those bytes trims or replaces a key that
+	 * stops where the data does rather than one that reaches over it.
+	 *
+	 * live_size rounds up to a sector because a key's lengths are in
+	 * sectors: at most 511 bytes of the request's last sector are named
+	 * that the request did not itself carry, and filling exactly those
+	 * from the file is what the client is told to do. It can never exceed
+	 * uncompressed_size - unit_len is block aligned (checked above), so a
+	 * valid_len at or below it rounds up to at most unit_len.
+	 */
+	crc.uncompressed_size	= desc->unit_len >> 9;
+	crc.live_size		= (round_up(valid_len, ENCODED_EXTENT_SECTOR_SIZE) -
+				   unencoded_offset) >> 9;
+	crc.offset		= unencoded_offset >> 9;
+	crc.nonce		= 0;
+	crc.csum_type		= want_csum;
+
+	nr_vecs = DIV_ROUND_UP(padded_len, PAGE_SIZE);
+	w = kzalloc(sizeof(*w), GFP_NOIO);
+	if (!w)
+		return bch_err_throw(c, ENOMEM_bio_write_init);
+
+	w->bvecs = kmalloc_array(nr_vecs, sizeof(struct bio_vec), GFP_NOIO);
+	if (!w->bvecs) {
+		kfree(w);
+		return bch_err_throw(c, ENOMEM_bio_write_init);
+	}
+	init_completion(&w->done);
+
+	op = &w->op;
+	bch2_write_op_init(op, c, io_opts);
+
+	bio = &op->wbio.bio;
+	bio_init(bio, NULL, w->bvecs, nr_vecs, REQ_OP_WRITE);
+	/* __GFP_ZERO so the block padding behind the frame is zero. */
+	if (bch2_bio_alloc_pages(bio, c->opts.block_size, padded_len,
+				 GFP_NOIO|__GFP_ZERO)) {
+		ret = bch_err_throw(c, ENOMEM_bio_write_init);
+		goto err;
+	}
+
+	bio->bi_iter.bi_size = len;
+	memcpy_to_bio(bio, bio->bi_iter, data);
+	bio->bi_iter.bi_size = padded_len;
+	bio->bi_iter.bi_sector = desc->unit_offset >> 9;
+
+	/* The checksum covers the padded unit, exactly as the reader verifies it. */
+	nonce = extent_nonce(ZERO_VERSION, crc);
+	crc.csum = bch2_checksum_bio(c, crc.csum_type, nonce, bio);
+
+	/*
+	 * data_encoded + a populated op->crc says "this buffer already is the
+	 * extent"; encoded_only makes "and do not decode it to make it one" a
+	 * guarantee. pages_stable/pages_owned say the payload will not move and
+	 * the write path may keep it.
+	 */
+	op->flags		= BCH_WRITE_data_encoded|
+				  BCH_WRITE_pages_stable|
+				  BCH_WRITE_pages_owned|
+				  BCH_WRITE_encoded_only|
+				  BCH_WRITE_check_enospc;
+	op->crc			= crc;
+	op->version		= ZERO_VERSION;
+	op->nonce		= 0;
+	op->csum_type		= want_csum;
+	op->compression_opt	= io_opts.compression;
+	op->incompressible	= 0;
+	op->target		= io_opts.foreground_target;
+	op->nr_replicas		= io_opts.data_replicas;
+	op->res.nr_replicas	= io_opts.data_replicas;
+	/*
+	 * Hash the write point by the inode, as the buffered write path does
+	 * (writepoint_hashed(inode->ei_last_dirtied), fs/vfs/buffered.c), rather
+	 * than by the writing task. The data service runs one write per unit from
+	 * whichever of its threads picked up the RPC, so hashing by @current
+	 * spreads one file's extents across every thread's write point - dozens
+	 * of partially filled buckets the allocator cannot retire, and a
+	 * whole-extent write that keeps needing fresh buckets. One write point
+	 * per inode packs a file's units into a bucket that fills and retires
+	 * cleanly. Two writes to one inode cannot overlap anyway:
+	 * bch2_encoded_extent_write() holds bch2_pagecache_block() across the
+	 * whole write.
+	 */
+	op->write_point		= writepoint_hashed((unsigned long) inode);
+	op->subvol		= inum.subvol;
+	op->pos			= POS(inum.inum, (desc->unit_offset +
+					       unencoded_offset) >> 9);
+	/*
+	 * Never shrink: a write in the middle of a file must not truncate it,
+	 * and a write past the end must extend it. The unit is block-aligned by
+	 * the check above, which also keeps this out of the small-write inline
+	 * path - the payload is packed data, not plaintext.
+	 */
+	/*
+	 * The file's size is where the peer's data ends, which is the frame's
+	 * length only when the request filled a whole block. Taking the frame's
+	 * length here would leave every file written by a partial unit longer
+	 * than it was written.
+	 */
+	op->new_i_size		= max_t(u64, inode_u.bi_size,
+					 req_offset + req_len);
+	op->end_io		= bch2_encoded_write_end_io;
+
+	ret = bch2_disk_reservation_get(c, &op->res, padded_len >> 9,
+					io_opts.data_replicas, 0);
+	if (ret)
+		goto err;
+
+	closure_call(&op->cl, bch2_write, NULL, NULL);
+	wait_for_completion(&w->done);
+
+	/*
+	 * The write path reports what the extent changed the file's sector count
+	 * by and leaves applying it to the caller: the page cache and direct
+	 * paths do it in their completions (bch2_i_sectors_acct), because the
+	 * VFS inode's i_blocks is not part of the btree update. A path that
+	 * reaches the btree without one has to do it here.
+	 *
+	 * Without this the in-memory inode's i_blocks never grows for an
+	 * encoded write. The file's contents are still right and its bi_sectors
+	 * is still right, so nothing fails - until the next thing that takes
+	 * sectors away from the file (the O_TRUNC a writer opens with, a
+	 * truncate, an overwrite) accounts against a count that never grew, and
+	 * bcachefs logs it and counts an fsck error. What a user sees in the
+	 * meantime is `stat` reporting no blocks for a file that has them.
+	 */
+	bch2_i_sectors_acct(c, inode, NULL, op->i_sectors_delta);
+
+	/*
+	 * Anything that means "this payload cannot be stored as it stands" is a
+	 * fallback, not an error the peer should see: a full write point
+	 * (retried with fresh buckets by the write path, and only surfacing if
+	 * there is really no room), or a payload that turned out not to be a
+	 * whole extent. Everything else keeps its meaning.
+	 */
+	if (bch2_err_matches(op->error, BCH_ERR_encoded) ||
+	    bch2_err_matches(op->error, BCH_ERR_data_write_encoded_not_whole_extent) ||
+	    bch2_err_matches(op->error, BCH_ERR_data_write_need_fresh_buckets))
+		ret = -ENODATA;
+	else
+		ret = bch2_err_class(op->error);
+
+	if (!ret)
+		ret = bch2_encoded_write_times_update(c, inode, req_offset, req_len);
+err:
+	bch2_disk_reservation_put(c, &op->res);
+	bch2_bio_free_pages_pool(c, bio);
+	kfree(w->bvecs);
+	kfree(w);
+	return ret;
+}
+
+/* ------------------------------------------------------- the encoded_extent_ops -- */
+
+/*
+ * The encoded read is the filesystem's own data path - the extent btree and the
+ * device - and not the page cache's. That is only correct while nothing newer
+ * is still dirty in the page cache: an MDS write (an NFS WRITE that fell back,
+ * a local buffered writer, an NFSv3 writer) updates the cache and leaves the
+ * extent key in the btree as it was, so an encoded read that skipped the cache
+ * would hand out pre-write plaintext with status 0 - no -ENODATA, so no
+ * fallback, and the peer decodes stale bytes.
+ *
+ * bch2_direct_IO_read() has the same requirement and meets it the same way:
+ * filemap_write_and_wait_range() before the btree is consulted. The cheap
+ * "needs writeback" test keeps an ordinary clean read off the writeback path.
+ * The other direction is already handled by the encoded write, which
+ * invalidates the cache under bch2_pagecache_block().
+ */
+static int bch2_encoded_readback_flush(struct file *file, u64 offset, size_t len)
+{
+	struct address_space *mapping = file_inode(file)->i_mapping;
+	loff_t start = offset;
+	loff_t end = offset + len - 1;
+
+	if (!len || !filemap_range_needs_writeback(mapping, start, end))
+		return 0;
+
+	return filemap_write_and_wait_range(mapping, start, end);
+}
+
+static int bch2_encoded_extent_probe(struct file *file, u64 offset, size_t len,
+				     struct encoded_extent_read_desc *desc)
+{
+	struct bch_fs *c = file_inode(file)->i_sb->s_fs_info;
+	struct bch_inode_info *inode = to_bch_ei(file_inode(file));
+	struct bch_encoded_unit unit;
+	int ret;
+
+	ret = bch2_encoded_readback_flush(file, offset, len);
+	if (ret)
+		return ret;
+
+	memset(&unit, 0, sizeof(unit));
+	ret = bch2_trans_do(c, __bch2_encoded_probe(trans, inode_inum(inode),
+						    offset, &unit));
+	if (ret) {
+		desc->refusal = unit.refusal;
+		return bch2_encoded_err(ret);
+	}
+
+	desc->unit_offset	= unit.logical_offset;
+	desc->unit_len		= bch2_encoded_unit_len(&unit);
+	desc->plain_offset	= (u64) unit.crc.offset << 9;
+	desc->compression	= unit.crc.compression_type;
+	desc->encrypted		= false;
+	return 0;
+}
+
+static int bch2_encoded_extent_read(struct file *file, u64 offset, size_t len,
+				    void *dst, size_t *dst_len,
+				    struct encoded_extent_read_desc *desc)
+{
+	struct bch_fs *c = file_inode(file)->i_sb->s_fs_info;
+	struct bch_inode_info *inode = to_bch_ei(file_inode(file));
+	struct bch_encoded_unit unit;
+	size_t payload_len = 0;
+	int ret;
+
+	ret = bch2_encoded_readback_flush(file, offset, len);
+	if (ret)
+		return ret;
+
+	memset(&unit, 0, sizeof(unit));
+	ret = bch2_encoded_read_unit(c, inode_inum(inode), offset, dst, *dst_len,
+				     &payload_len, &unit);
+	if (ret) {
+		/*
+		 * The read path reaches the same refusal sites the probe does,
+		 * so the reason is already on the unit. It has to leave through
+		 * the descriptor because bch2_encoded_err() turns every one of
+		 * them into a bare -ENODATA, and a bare -ENODATA is what the
+		 * service counts as "not served" without knowing why.
+		 */
+		desc->refusal = unit.refusal;
+		return bch2_encoded_err(ret);
+	}
+
+	desc->unit_offset	= unit.logical_offset;
+	desc->unit_len		= bch2_encoded_unit_len(&unit);
+	desc->plain_offset	= (u64) unit.crc.offset << 9;
+	desc->compression	= unit.crc.compression_type;
+	desc->encrypted		= false;
+	*dst_len = payload_len;
+	return 0;
+}
+
+/*
+ * Store the encoded unit. A successful write has reached the btree and the
+ * journal, not the disk, which is what the sync that follows settles: see
+ * encoded_extent_sync().
+ */
+static int bch2_encoded_extent_write(struct file *file, u64 req_offset,
+				     u64 req_len,
+				     const void *src, size_t len,
+				     const struct encoded_extent_write_desc *desc,
+				     enum encoded_extent_stable how,
+				     enum encoded_extent_stable *committed)
+{
+	struct bch_fs *c = file_inode(file)->i_sb->s_fs_info;
+	struct bch_inode_info *inode = to_bch_ei(file_inode(file));
+	int ret;
+
+	/*
+	 * The unit is written into the btree, not through the page cache, so
+	 * every folio cached for the range is stale the moment it lands. This is
+	 * what O_DIRECT invalidates for and for the same reason: without it a
+	 * reader that goes through the cache - a local one, or the MDS serving
+	 * a READ from this node - is handed the old contents of a file that has
+	 * already changed. Holding the pagecache block keeps a concurrent
+	 * buffered write from re-dirtying the range behind the invalidation.
+	 */
+	guard(bch2_pagecache_block)(inode);
+	if (unlikely(inode->v.i_mapping->nrpages)) {
+		ret = bch2_write_invalidate_inode_pages_range(inode->v.i_mapping,
+					desc->unit_offset,
+					desc->unit_offset + desc->unit_len - 1);
+		if (ret)
+			return ret;
+	}
+
+	ret = bch2_encoded_err(
+		bch2_encoded_write_unit(c, inode, req_offset, req_len, src, len,
+					desc));
+	if (ret)
+		return ret;
+
+	return encoded_extent_sync(file, desc->unit_offset, desc->unit_len,
+				   how, committed);
+}
+
+static u32 bch2_encoded_extent_unit_max(struct inode *inode)
+{
+	struct bch_fs *c = inode->i_sb->s_fs_info;
+
+	/*
+	 * A unit is read with one bio, and the bio vector pool stops at
+	 * BIO_MAX_VECS pages: asking for more BUGs inside bvec_alloc(), in a
+	 * request path, which takes the serving thread with it - the client
+	 * reads that as a timeout, retries, and dies again, while every other
+	 * read falls back to the MDS. bcachefs's own data paths clamp to the
+	 * same limit for the same reason (fs/data/write.c).
+	 *
+	 * So this is the largest unit the service can serve, and a filesystem
+	 * formatted larger is clamped rather than killed. It is not merely a
+	 * smaller layout: bch2_encoded_read_unit() refuses anything above it, so
+	 * on such a filesystem encoded reads go to the MDS until it is
+	 * reformatted with --encoded_extent_max=1M or less. That is why this
+	 * says so out loud, once, at the point where the number is decided.
+	 */
+	if (c->opts.encoded_extent_max > BIO_MAX_VECS * PAGE_SIZE) {
+		pr_err_once("bcachefs: encoded_extent_max is %u bytes, but the "
+			    "encoded-extent data service can read at most %lu "
+			    "(one bio, BIO_MAX_VECS pages): no layout will be "
+			    "offered for this filesystem and clients will read "
+			    "through the MDS. Reformat with "
+			    "--encoded_extent_max=%lu or less for full service.\n",
+			    c->opts.encoded_extent_max,
+			    (unsigned long)BIO_MAX_VECS * PAGE_SIZE,
+			    (unsigned long)BIO_MAX_VECS * PAGE_SIZE);
+		/*
+		 * 0: this filesystem cannot be served encoded at all. The read
+		 * path cannot build a bio for a unit that large, and because
+		 * the refusal is keyed on the option, advertising a smaller
+		 * ceiling would mean refusing every range - a layout that can
+		 * never be used. So there is no layout: the client reads
+		 * through the MDS, which is correct, and the message above
+		 * says why. A caller that asks anyway is refused by the read
+		 * op (bch2_encoded_read_unit()) and by the data service, which
+		 * treats a zero unit_max as "not served".
+		 */
+		return 0;
+	}
+
+	return c->opts.encoded_extent_max;
+}
+
+static u32 bch2_encoded_extent_unit_align(struct inode *inode)
+{
+	struct bch_fs *c = inode->i_sb->s_fs_info;
+
+	return c->opts.block_size;
+}
+
+/* ------------------------------------------------------------- the codecs -- */
+
+/*
+ * bcachefs's zstd extents, as the peer needs them. The framing is bcachefs's
+ * and not a bare zstd frame: data/compress.c puts the exact compressed length
+ * in a little-endian u32 in front of the frame, because zstd's decoder needs
+ * the exact size and the on-disk payload is sector-padded. A peer that used a
+ * plain zstd frame here would produce extents bcachefs itself cannot read, so
+ * this is exactly the code the filesystem's own codec path runs, with the
+ * workspace coming from the call instead of from a mount.
+ *
+ * The name is deliberately not the bare "zstd" that the btrfs backend
+ * registers: the registry refuses two codecs with the same name under one
+ * layout type, and the framing is not the same, so the two must be told apart.
+ */
+
+/* bcachefs rescales its own level (data/compress.c); this is a mid-range one. */
+#define BCH2_ENCODED_ZSTD_LEVEL		3
+
+/*
+ * The window a unit of the largest size the wire carries needs: the peer
+ * encodes units of at most the layout's unit_max, which is bounded by the
+ * data service's 2 MiB payload ceiling, and zstd sizes its window from the
+ * input, so 2 MiB is the window both sides have to be able to hold.
+ */
+#define BCH2_ENCODED_ZSTD_WINDOW_LOG	21
+
+/*
+ * Read the exact compressed length out of the frame's little-endian u32. It is
+ * four bytes at the start of the payload, which the on-disk format places at
+ * the start of the unit; reading it through the page iterator rather than a
+ * dereference keeps a payload that starts near the end of a page honest.
+ */
+static int bch2_encoded_prefix_get(const struct encoded_extent_pages *src,
+				   size_t *framed_len)
+{
+	struct encoded_extent_iter it;
+	__le32 prefix;
+	u8 *p = (u8 *)&prefix;
+	unsigned int got = 0;
+
+	if (src->len < sizeof(prefix))
+		return -EIO;
+
+	encoded_extent_iter_init(&it, src);
+	while (got < sizeof(prefix)) {
+		struct page *page;
+		void *addr;
+		size_t n = encoded_extent_iter_chunk(&it, &page);
+
+		n = min_t(size_t, n, sizeof(prefix) - got);
+		addr = kmap_local_page(page);
+		memcpy(p + got, addr + it.off, n);
+		kunmap_local(addr);
+		encoded_extent_iter_advance(&it, n);
+		got += n;
+	}
+
+	*framed_len = le32_to_cpu(prefix);
+	if (*framed_len > src->len - sizeof(prefix))
+		return -EIO;
+
+	return 0;
+}
+
+static void bch2_encoded_prefix_put(const struct encoded_extent_pages *dst,
+				    u32 framed_len)
+{
+	struct encoded_extent_iter it;
+	__le32 prefix = cpu_to_le32(framed_len);
+	const u8 *p = (const u8 *)&prefix;
+	unsigned int done = 0;
+
+	encoded_extent_iter_init(&it, dst);
+	while (done < sizeof(prefix)) {
+		struct page *page;
+		void *addr;
+		size_t n = encoded_extent_iter_chunk(&it, &page);
+
+		n = min_t(size_t, n, sizeof(prefix) - done);
+		addr = kmap_local_page(page);
+		memcpy(addr + it.off, p + done, n);
+		kunmap_local(addr);
+		encoded_extent_iter_advance(&it, n);
+		done += n;
+	}
+}
+
+static int bch2_encoded_zstd_decode(const struct encoded_extent_pages *src,
+				    const struct encoded_extent_pages *dst,
+				    size_t *dst_len)
+{
+	struct encoded_extent_pages frame;
+	size_t framed_len;
+	int ret;
+
+	ret = bch2_encoded_prefix_get(src, &framed_len);
+	if (ret)
+		return ret;
+	if (!framed_len)
+		return -EIO;
+
+	/*
+	 * The prefix is the frame's exact length; the stored payload behind it
+	 * is padded, so the frame is a sub-range of the pages and the padding
+	 * is never looked at.
+	 */
+	frame = (struct encoded_extent_pages) {
+		.pages		= src->pages,
+		.nr_pages	= src->nr_pages,
+		.offset		= src->offset + sizeof(u32),
+		.len		= framed_len,
+	};
+
+	return encoded_extent_zstd_decode(&frame, dst,
+					  1U << BCH2_ENCODED_ZSTD_WINDOW_LOG,
+					  dst_len);
+}
+
+static int bch2_encoded_zstd_encode(const struct encoded_extent_pages *src,
+				    const struct encoded_extent_pages *dst,
+				    size_t *dst_len)
+{
+	struct encoded_extent_pages frame;
+	size_t framed_len;
+	int ret;
+
+	/* Room for the length prefix, at least. */
+	if (dst->len <= sizeof(u32))
+		return -E2BIG;
+
+	frame = (struct encoded_extent_pages) {
+		.pages		= dst->pages,
+		.nr_pages	= dst->nr_pages,
+		.offset		= dst->offset + sizeof(u32),
+		.len		= dst->len - sizeof(u32),
+	};
+
+	ret = encoded_extent_zstd_encode(src, &frame, BCH2_ENCODED_ZSTD_LEVEL,
+					 BCH2_ENCODED_ZSTD_WINDOW_LOG,
+					 &framed_len);
+	if (ret)
+		return ret;
+	if (!framed_len)
+		return -EIO;
+
+	bch2_encoded_prefix_put(dst, framed_len);
+	*dst_len = framed_len + sizeof(u32);
+	return 0;
+}
+
+/*
+ * The frame is bcachefs's own framing - a little-endian u32 exact length, then
+ * one zstd frame - so a whole unit can be checked against the length the
+ * descriptor claims without decoding it. See the note on ->validate in
+ * linux/encoded_extent.h for why that check is worth having at all.
+ */
+static int bch2_encoded_zstd_validate(const void *payload, size_t len,
+				      size_t plain_len)
+{
+	__le32 prefix;
+	size_t framed_len, got;
+
+	if (len < sizeof(prefix))
+		return -EIO;
+
+	memcpy(&prefix, payload, sizeof(prefix));
+	framed_len = le32_to_cpu(prefix);
+	if (!framed_len || framed_len > len - sizeof(prefix))
+		return -EIO;
+
+	if (encoded_extent_zstd_frame_size(payload + sizeof(prefix), framed_len,
+					   &got))
+		return -EIO;
+
+	return got == plain_len ? 0 : -EIO;
+}
+
+static const struct encoded_extent_codec bch2_encoded_zstd_codec = {
+	.owner		= THIS_MODULE,
+	.compression	= BCH_COMPRESSION_TYPE_zstd,
+	.name		= "bcachefs-zstd",
+	.decode		= bch2_encoded_zstd_decode,
+	.encode		= bch2_encoded_zstd_encode,
+	.validate	= bch2_encoded_zstd_validate,
+};
+
+static const struct encoded_extent_codec * const bch2_encoded_codecs[] = {
+	&bch2_encoded_zstd_codec,
+};
+
+/* What a peer sees of this filesystem's encoded extents: the ops and the codec
+ * table above, which is where a descriptor's codec position is resolved - this
+ * filesystem's positions, not every registrant's. */
+const struct encoded_extent_ops bch2_encoded_extent_ops = {
+	.codecs		= bch2_encoded_codecs,
+	.nr_codecs	= ARRAY_SIZE(bch2_encoded_codecs),
+	.unit_max	= bch2_encoded_extent_unit_max,
+	.unit_align	= bch2_encoded_extent_unit_align,
+	.read		= bch2_encoded_extent_read,
+	.write		= bch2_encoded_extent_write,
+	.probe		= bch2_encoded_extent_probe,
+};
+
+/*
+ * How a peer that does not have this codec finds the module that does: it asks
+ * for the alias, and modprobe loads bcachefs.ko. This is the whole reason the
+ * name a codec registers under has to be the name a layout carries.
+ */
+MODULE_ALIAS_ENCODED_EXTENT_CODEC("bcachefs-zstd");
+
+/*
+ * Registered under the layout type this backend is served with. A codec
+ * bcachefs stores but has not registered (lz4, gzip) has a perfectly valid
+ * number in a descriptor but no name a peer can resolve, so those extents fall
+ * back to ordinary I/O - which is the correct degradation, and is why this
+ * table rather than the on-disk numbering decides what is served encoded.
+ */
+int bch2_encoded_extent_codecs_init(void)
+{
+	return encoded_extent_codec_register(LAYOUT_BCACHEFS_ENCODED,
+					     bch2_encoded_codecs,
+					     ARRAY_SIZE(bch2_encoded_codecs));
+}
+
+void bch2_encoded_extent_codecs_exit(void)
+{
+	encoded_extent_codec_unregister(LAYOUT_BCACHEFS_ENCODED,
+					bch2_encoded_codecs);
+}
+
+#endif /* CONFIG_ENCODED_EXTENT_CODECS */
