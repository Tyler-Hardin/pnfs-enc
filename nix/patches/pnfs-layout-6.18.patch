diff --git a/include/linux/encoded_extent.h b/include/linux/encoded_extent.h
new file mode 100644
index 000000000..c0ea44258
--- /dev/null
+++ b/include/linux/encoded_extent.h
@@ -0,0 +1,290 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_ENCODED_EXTENT_H
+#define _LINUX_ENCODED_EXTENT_H
+
+#include <linux/types.h>
+#include <linux/fs.h>
+
+struct inode;
+struct module;
+
+/*
+ * Encoded extent I/O: move a filesystem's compressed, checksummed extents
+ * without decoding them.
+ *
+ * The unit is one whole encoded extent as the filesystem stores it. A caller
+ * sees a descriptor, not the on-disk format:
+ *
+ *   - @unit_max and @unit_align are the largest encoded payload a backend will
+ *     produce and the alignment an encoded offset and length must respect. A
+ *     caller that cannot align a request falls back to ordinary I/O. A
+ *     @unit_max of 0 means this filesystem cannot be served encoded at all: a
+ *     layout must not be offered for it, and a caller that asks anyway is
+ *     refused. That is how a backend reports a limit of its own serving path
+ *     rather than dying inside it;
+ *   - @compression is the backend's own codec numbering, so a client can
+ *     decode with the matching codec - the counter half of the offload;
+ *   - @unit_offset and @unit_len are the plaintext range the encoded unit
+ *     covers. The requested range may start inside it, which is how page- or
+ *     block-padded encodings are described, and @unencoded_offset says where
+ *     the requested range starts within the unit's plaintext;
+ *   - @encrypted: encoded I/O deliberately does not touch encryption. An
+ *     encrypted extent is refused (-ENODATA) and the caller falls back, so no
+ *     key handling is duplicated here.
+ *
+ * Checksums are the backend's business: it verifies on read and computes on
+ * write, so an encoded payload is never trusted blindly and no checksum code
+ * is duplicated by the caller. A backend refuses a payload it cannot describe
+ * rather than storing something no reader could decode - the same rule the
+ * on-disk format would enforce for a local writer.
+ *
+ * Encoded I/O is a serving facility: it exists so a filesystem can be exported
+ * to a client that does the codec work itself, which is why the ops hang off
+ * export_operations. A filesystem that cannot be exported does not need them,
+ * and a backend only needs to implement what it can do honestly - anything it
+ * refuses falls back to ordinary I/O, which is always correct.
+ */
+struct encoded_extent_desc {
+	u64	unit_offset;		/* logical offset of the unit's start */
+	u64	unit_len;		/* plaintext the unit covers */
+	u64	unencoded_offset;	/* start of the requested range in it */
+	u32	compression;		/* backend's codec numbering */
+	bool	encrypted;
+};
+
+/*
+ * How durable a write has to be, and how durable it turned out.
+ *
+ * These are NFS's three write-stability levels with the same values, named here
+ * because encoded I/O exists to serve NFS and the levels are the far end's
+ * contract: a backend may always do more than it was asked, and must never
+ * claim more than it has done. @ENCODED_EXTENT_UNSTABLE is a page cache write -
+ * a client that needs the data on stable storage must come back and ask for
+ * more; @ENCODED_EXTENT_DATA_SYNC is the data on stable storage with metadata
+ * possibly still in flight; @ENCODED_EXTENT_FILE_SYNC is both.
+ */
+enum encoded_extent_stable {
+	ENCODED_EXTENT_UNSTABLE		= 0,
+	ENCODED_EXTENT_DATA_SYNC	= 1,
+	ENCODED_EXTENT_FILE_SYNC	= 2,
+};
+
+/*
+ * The durability half of an encoded write, which is the same on every backend:
+ * the payload reached the page cache, so the level the caller asked for is
+ * honoured by syncing the unit's own plaintext range - the data alone for a data
+ * sync, the data and the metadata for a file sync - and what actually happened
+ * is handed back. A level below a data sync needs no work and is reported as
+ * what it is.
+ *
+ * The range is the *unit's*, not the requested range: a request may start inside
+ * a unit, and syncing past the unit's end would make this call responsible for
+ * data it did not write.
+ */
+static inline int encoded_extent_sync(struct file *file, u64 offset, u64 len,
+				      enum encoded_extent_stable how,
+				      enum encoded_extent_stable *committed)
+{
+	loff_t start = offset;
+	loff_t end = offset + len - 1;
+	int ret;
+
+	if (how < ENCODED_EXTENT_DATA_SYNC) {
+		*committed = ENCODED_EXTENT_UNSTABLE;
+		return 0;
+	}
+
+	ret = vfs_fsync_range(file, start, end,
+			      how == ENCODED_EXTENT_DATA_SYNC);
+	if (ret)
+		return ret;
+
+	*committed = how;
+	return 0;
+}
+
+/*
+ * A codec a filesystem stores encoded extents with, and what the peer that does
+ * the codec work needs to run it.
+ *
+ * The two halves of a codec have different owners, which is why this exists
+ * rather than a bare number on the wire. The exporting filesystem owns the
+ * numbering: @compression is the number its own encoded_extent_desc carries, and
+ * only it knows which of its codecs a given extent used. The peer owns the
+ * implementation, because the peer is the one decoding and encoding - which also
+ * means it must have the codec, and that a codec it does not have is a range it
+ * cannot serve. @name is the identity that crosses between them.
+ *
+ * So a filesystem registers the codecs it may store extents with, a peer
+ * resolves a name to an implementation, and a name that does not resolve is a
+ * range that falls back to ordinary I/O - which is always correct. Nothing on
+ * either side has to know the other's numbering, and the backend's numbering is
+ * never on the wire.
+ *
+ * Registration is per layout type: the same codec name can mean different
+ * framing to two filesystems, and the layout type identifies the format.
+ *
+ * A provider is usually a module, and the only thing that names it is the
+ * codec's own name, so the module that implements one advertises
+ * MODULE_ALIAS_ENCODED_EXTENT_CODEC(@name) and a peer that cannot resolve a
+ * name asks for that module before giving up. A provider built into the kernel
+ * needs nothing.
+ */
+
+/* Bytes, no terminator: how long a codec name may be to be asked for by name. */
+#define ENCODED_EXTENT_CODEC_NAME_MAX	32
+
+/* The module alias a codec's provider advertises, and what is asked for. */
+#define ENCODED_EXTENT_CODEC_MODULE_PREFIX	"encoded-extent-codec-"
+
+#define MODULE_ALIAS_ENCODED_EXTENT_CODEC(name) \
+	MODULE_ALIAS(ENCODED_EXTENT_CODEC_MODULE_PREFIX name)
+struct encoded_extent_codec {
+	struct module	*owner;
+	u32		compression;
+	const char	*name;
+	/*
+	 * Decode @src into @dst, at most @dst_cap bytes; *@dst_len is the
+	 * plaintext length on success. A codec that will not store encoded
+	 * extents fills in only the naming half and leaves these NULL; a peer
+	 * that needs one and finds it missing does not serve the range
+	 * encoded.
+	 */
+	int		(*decode)(const void *src, size_t src_len,
+				  void *dst, size_t dst_cap, size_t *dst_len);
+	int		(*encode)(const void *src, size_t src_len,
+				  void *dst, size_t dst_cap, size_t *dst_len);
+};
+
+/*
+ * The filesystem that stores them registers its codecs; a peer looks them up by
+ * layout type, by name (what the wire carries) or by the filesystem's own
+ * numbering, and @index, filled in by the latter, is the codec's position in the
+ * registered table - the number that goes on the wire in the descriptor's place.
+ * @names() and those positions agree by construction, which is what keeps a
+ * unit's codec number and the layout's list of names consistent.
+ *
+ * A lookup holds a reference to the codec's module, released with
+ * @encoded_extent_codec_put, so a codec cannot be unloaded under a layout that
+ * is still using it.
+ */
+int encoded_extent_codec_register(u32 layout_type,
+		const struct encoded_extent_codec * const *codecs,
+		unsigned int nr_codecs);
+void encoded_extent_codec_unregister(u32 layout_type,
+		const struct encoded_extent_codec * const *codecs);
+/*
+ * Resolve a name to a codec: if it does not resolve, ask for the module that
+ * advertises it (MODULE_ALIAS_ENCODED_EXTENT_CODEC()) and look again. A name
+ * whose provider cannot be loaded, or whose characters cannot be part of an
+ * alias, is left unresolved - which is a hole the caller falls back over, never
+ * an error. Repeated asks for one name are rate limited, because the name came
+ * from a peer.
+ */
+const struct encoded_extent_codec *encoded_extent_codec_find_or_load(
+		u32 layout_type, const char *name);
+/* How many times a provider has been asked for, for tests and debugging. */
+unsigned long encoded_extent_codec_load_attempts(void);
+void encoded_extent_codec_put(const struct encoded_extent_codec *codec);
+
+struct encoded_extent_ops {
+	/*
+	 * The codecs this filesystem stores encoded extents with, in the order a
+	 * layout names them. A descriptor's codec is a position in *this* list,
+	 * not in every codec registered for the layout type: two filesystems can
+	 * be exported under one layout type at once, and a position resolved
+	 * against a merged list would name one filesystem's codec to the peer
+	 * and another's to the server. The same array is registered by name (see
+	 * encoded_extent_codec_register()) so that a peer which does not have
+	 * the codec can find an implementation for it.
+	 */
+	const struct encoded_extent_codec * const *codecs;
+	unsigned int	nr_codecs;
+
+	/*
+	 * The largest encoded payload a backend will produce, and the alignment
+	 * an encoded offset and length must respect. Per-mount values (btrfs's
+	 * sector size, bcachefs's block size and encoded extent ceiling), so
+	 * they are calls rather than constants.
+	 */
+	u32 (*unit_max)(struct inode *inode);
+	u32 (*unit_align)(struct inode *inode);
+
+	/*
+	 * Read the encoded unit covering [offset, offset + len) into @dst,
+	 * whose capacity is *@dst_len on entry; on success *@dst_len is the
+	 * payload length. Returns -ENODATA if the range has no encoded unit
+	 * (hole, inline, nocow, uncompressed, encrypted) and the caller must
+	 * fall back to ordinary reads.
+	 */
+	int (*read)(struct file *file, u64 offset, size_t len,
+		    void *dst, size_t *dst_len,
+		    struct encoded_extent_desc *desc);
+
+	/*
+	 * Insert @len bytes of encoded payload as the unit covering
+	 * [offset, offset + @desc->unit_len), with the inode's and the
+	 * filesystem's normal allocation policy. Returns -ENODATA if the
+	 * backend will not store encoded data here (an encrypted or nocow
+	 * inode, a codec mismatch, a payload that is not a whole unit) and the
+	 * caller must fall back to ordinary writes; -EINVAL only for a
+	 * malformed request.
+	 *
+	 * @how is what the caller needs to survive, and *@committed is what the
+	 * backend actually reached: @how when it honoured the request, a lower
+	 * level when it could not. A backend whose writes land in the page cache
+	 * reports @ENCODED_EXTENT_UNSTABLE unless it synced, which is the whole
+	 * point of the pair: a caller must be able to tell a write that survives
+	 * a power cut from one that does not. A backend that is always durable
+	 * (write-through to stable storage) may report more than it was asked
+	 * for.
+	 */
+	int (*write)(struct file *file, u64 offset,
+		     const void *src, size_t len,
+		     const struct encoded_extent_desc *desc,
+		     enum encoded_extent_stable how,
+		     enum encoded_extent_stable *committed);
+
+	/*
+	 * Describe the encoded unit covering [offset, offset + len) without
+	 * transferring it, so a caller can align requests and choose between
+	 * the encoded path and the fallback. -ENODATA as above.
+	 */
+	int (*probe)(struct file *file, u64 offset, size_t len,
+		     struct encoded_extent_desc *desc);
+};
+
+/*
+ * The codec at a position in a filesystem's own list, or NULL if it has none
+ * there - which is what a descriptor naming a position past the end means, and
+ * a range that is not served encoded.
+ */
+static inline const struct encoded_extent_codec *
+encoded_extent_codec_by_position(const struct encoded_extent_ops *ops,
+				 unsigned int position)
+{
+	return position < ops->nr_codecs ? ops->codecs[position] : NULL;
+}
+
+/*
+ * The position of the codec with a filesystem's own numbering, or NULL if it
+ * has no such codec registered - a codec the filesystem stores extents with
+ * but does not offer to peers, which those extents' ranges fall back over.
+ */
+static inline const struct encoded_extent_codec *
+encoded_extent_codec_by_compression(const struct encoded_extent_ops *ops,
+				    u32 compression, unsigned int *position)
+{
+	unsigned int i;
+
+	for (i = 0; i < ops->nr_codecs; i++)
+		if (ops->codecs[i]->compression == compression) {
+			if (position)
+				*position = i;
+			return ops->codecs[i];
+		}
+
+	return NULL;
+}
+
+#endif /* _LINUX_ENCODED_EXTENT_H */
diff --git a/include/linux/encoded_extent_ds.h b/include/linux/encoded_extent_ds.h
new file mode 100644
index 000000000..ad1ddf43e
--- /dev/null
+++ b/include/linux/encoded_extent_ds.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_ENCODED_EXTENT_DS_H
+#define _LINUX_ENCODED_EXTENT_DS_H
+
+#include <linux/types.h>
+
+/*
+ * The encoded-extent data service: how a client gets a filesystem's stored
+ * extents without the server decoding them.
+ *
+ * It is an RPC program of its own rather than new NFS operations, for two
+ * reasons. It rides on sunrpc, so it inherits the transport work a network
+ * filesystem otherwise reimplements - reconnect, request slots, keepalives,
+ * timeouts, multiple requests in flight - and it can be developed without
+ * touching the NFS protocol. And the payload is not NFS-shaped: one whole
+ * encoded extent plus the small descriptor needed to decode it, which reads
+ * awkwardly as a READ with a length.
+ *
+ * Files are addressed the way NFS addresses them: the file handle the MDS
+ * handed out in the layout, resolved by nfsd's own fh_verify(), so this works
+ * for any filesystem that can be exported and needs no filesystem-specific
+ * identity on the wire. The address is what an MDS that is also the data
+ * service knows - the address the client reached it at - which is exactly
+ * flexfiles' trick. A file handle is only meaningful relative to an export, and
+ * fh_verify() finds that export by fsid for the client that presented the
+ * handle, which is why the wire carries no export name: the export comes from
+ * the handle and the presenting client, so a caller cannot name one it is not
+ * allowed.
+ *
+ * Status: 0 for success, or -errno as an s32. -ENODATA means "not served
+ * encoded" - a hole, an uncompressed, inline, nocow or encrypted extent, an
+ * extent whose codec the exporting filesystem has not registered, a payload the
+ * backend refuses - and the caller uses ordinary NFS I/O, which is
+ * always correct.
+ *
+ * PROGRAM NUMBER: unregistered and experimental. A submission would take a
+ * number from IANA's RPC program registry, or a vendor range.
+ *
+ * Procedure arguments, in order (all opaques are XDR length-prefixed):
+ *
+ *   NULL   ()
+ *   PROBE  (addr, offset u64, len u64)              -> probe reply
+ *   READ   (addr, offset u64, buf_size u32)         -> read reply, payload
+ *   WRITE  (addr, offset u64, desc, stable u32, data opaque) -> write reply
+ *
+ *   addr   = fh opaque
+ *   desc   = unit_offset u64, unit_len u64, unencoded_offset u64,
+ *            codec u32, encrypted u32
+ *   probe reply = status s32, desc
+ *   read reply  = status s32, desc, payload (absent unless status is 0)
+ *   write reply = status s32, committed u32, writeverf[8]
+ *
+ * @stable is how durable the writer needs this unit to be, as NFS's three
+ * levels (0 unstable, 1 data sync, 2 file sync), and @committed is what the
+ * service actually reached - never more than it can back, and never more than
+ * @stable. A service whose backend stores the unit in the page cache says
+ * unstable, and the writer has to come back and commit; claiming otherwise
+ * would lose an acknowledged write on a power cut.
+ *
+ * @writeverf is the 8-byte write verifier of the serving nfsd net namespace -
+ * the same value, from the same source, that this server's own NFS WRITE and
+ * COMMIT replies carry. A client that writes unstably and commits later
+ * compares it against the one the commit returns, which is how it learns that
+ * a server restart lost the data; so the two paths must agree, not merely be
+ * restart-unique.
+ *
+ * @codec is a position in the codec list the layout carried, not the
+ * filesystem's own numbering for the codec: the layout names the codecs the
+ * export may use, in the order these positions index, and a peer resolves the
+ * position to a name to an implementation. The filesystem's numbering never
+ * crosses the wire, so neither side needs the other's.
+ */
+
+#define ENCODED_DS_PROGRAM	0x2000BC01
+#define ENCODED_DS_VERSION	2
+
+enum encoded_ds_proc {
+	ENCODED_DS_NULL		= 0,
+	ENCODED_DS_PROBE	= 1,
+	ENCODED_DS_READ		= 2,
+	ENCODED_DS_WRITE	= 3,
+	ENCODED_DS_NR_PROCS
+};
+
+#define ENCODED_DS_MAX_FH	128	/* bytes; an NFSv4 handle is at most 128 */
+/*
+ * The most one encoded extent can be on the wire: 2 MiB, bcachefs's own
+ * maximum unit. It is not a promise that a unit that large can be *served* -
+ * the read path builds one bio per unit and the bio vector pool stops at
+ * BIO_MAX_VECS pages (1 MiB), so a backend must refuse a payload it cannot
+ * read rather than dying in bvec_alloc(). The layout's unit_max is what says
+ * what this service will actually answer for.
+ */
+#define ENCODED_DS_MAX_PAYLOAD	(2U << 20)
+#define ENCODED_DS_MAX_CODECS	8	/* codecs one layout may name */
+#define ENCODED_DS_MAX_CODEC_NAME 16	/* bytes, no terminator on the wire */
+#define ENCODED_DS_WRITEVERF	8	/* bytes; NFS's write verifier size */
+
+/*
+ * What a reader needs to decode the payload. @codec indexes the layout's codec
+ * list. The checksum is deliberately absent: the backend verifies it on read and
+ * computes it on write, so a peer never reproduces the filesystem's checksum
+ * code.
+ */
+struct encoded_ds_desc {
+	__u64	unit_offset;
+	__u64	unit_len;
+	__u64	unencoded_offset;
+	__u32	codec;
+	__u32	encrypted;
+};
+
+/*
+ * Server side (fs/nfsd/encoded_ds.c). The service is started and stopped with
+ * nfsd; @encoded_ds_get_port returns 0 while it is not running, which is what a
+ * layout uses to say "no data service" to a client.
+ */
+int encoded_ds_start(void);
+void encoded_ds_stop(void);
+unsigned short encoded_ds_get_port(void);
+
+#endif /* _LINUX_ENCODED_EXTENT_DS_H */
