diff --git a/fs/encoded_extent.c b/fs/encoded_extent.c
new file mode 100644
index 000000000..0cbca4eb8
--- /dev/null
+++ b/fs/encoded_extent.c
@@ -0,0 +1,266 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Encoded extent codecs: the table that connects the filesystem which stores an
+ * encoded extent to the peer that decodes it.
+ *
+ * A filesystem registers the codecs its encoded extents may use, under the
+ * layout type (the format) and with its own numbering for each. A peer looks one
+ * up by the name the wire carries. Neither side needs the other's numbering, and
+ * a name the peer cannot resolve is simply a range it does not serve encoded.
+ *
+ * A layout type may have more than one registrant - two filesystems can be
+ * exported under the same layout type - but a codec name means one thing within
+ * a layout type, so a second registration that would shadow a name is refused.
+ * That is the only conflict the table has: everything else about two
+ * filesystems' codecs coexists.
+ *
+ * The registration is a pointer to the caller's static array rather than a copy,
+ * so a module's array must outlive its registration, which module_init and
+ * module_exit give it. Lookups take a reference to the codec's module so that
+ * the exit path cannot run under a user of a codec.
+ *
+ * One lock for the whole table: registration is a module load and lookups are a
+ * layout or a single unit of I/O, so there is nothing to gain from anything
+ * finer.
+ */
+#include <linux/encoded_extent.h>
+#include <linux/ctype.h>
+#include <linux/kmod.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+struct encoded_extent_codec_set {
+	struct list_head	list;
+	u32			layout_type;
+	const struct encoded_extent_codec * const *codecs;
+	unsigned int		nr_codecs;
+};
+
+static LIST_HEAD(codec_sets);
+static DEFINE_MUTEX(codec_lock);
+
+/*
+ * Every set registered under @layout_type, in registration order - which is the
+ * order a peer sees the names in, and so the numbering its descriptors use.
+ */
+#define for_each_codec_set(set, layout_type)				\
+	list_for_each_entry(set, &codec_sets, list)			\
+		if (set->layout_type == (layout_type))
+
+/*
+ * A name has to mean one codec within a layout type, or a peer resolving it
+ * would get the other filesystem's decoder.
+ */
+static bool codec_name_taken(u32 layout_type, const char *name)
+{
+	struct encoded_extent_codec_set *set;
+	unsigned int i;
+
+	for_each_codec_set(set, layout_type)
+		for (i = 0; i < set->nr_codecs; i++)
+			if (!strcmp(set->codecs[i]->name, name))
+				return true;
+	return false;
+}
+
+int encoded_extent_codec_register(u32 layout_type,
+		const struct encoded_extent_codec * const *codecs,
+		unsigned int nr_codecs)
+{
+	struct encoded_extent_codec_set *set;
+	unsigned int i;
+	int ret = 0;
+
+	if (!codecs || !nr_codecs)
+		return -EINVAL;
+
+	/*
+	 * Every registered codec is offered to peers by name, so one without a
+	 * name is not a codec this table can describe.
+	 */
+	for (i = 0; i < nr_codecs; i++)
+		if (!codecs[i] || !codecs[i]->name)
+			return -EINVAL;
+
+	set = kzalloc(sizeof(*set), GFP_KERNEL);
+	if (!set)
+		return -ENOMEM;
+
+	mutex_lock(&codec_lock);
+	for (i = 0; i < nr_codecs && !ret; i++)
+		if (codec_name_taken(layout_type, codecs[i]->name))
+			ret = -EEXIST;
+	if (!ret) {
+		set->layout_type = layout_type;
+		set->codecs = codecs;
+		set->nr_codecs = nr_codecs;
+		list_add_tail(&set->list, &codec_sets);
+	}
+	mutex_unlock(&codec_lock);
+
+	if (ret)
+		kfree(set);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(encoded_extent_codec_register);
+
+void encoded_extent_codec_unregister(u32 layout_type,
+		const struct encoded_extent_codec * const *codecs)
+{
+	struct encoded_extent_codec_set *set;
+
+	mutex_lock(&codec_lock);
+	list_for_each_entry(set, &codec_sets, list)
+		if (set->layout_type == layout_type && set->codecs == codecs) {
+			list_del(&set->list);
+			kfree(set);
+			break;
+		}
+	mutex_unlock(&codec_lock);
+}
+EXPORT_SYMBOL_GPL(encoded_extent_codec_unregister);
+
+/* A codec of @name registered for @layout_type, or NULL; a reference on it. */
+static const struct encoded_extent_codec *encoded_extent_codec_find(
+		u32 layout_type, const char *name)
+{
+	struct encoded_extent_codec_set *set;
+	const struct encoded_extent_codec *codec = NULL;
+	unsigned int i;
+
+	if (!name)
+		return NULL;
+
+	mutex_lock(&codec_lock);
+	for_each_codec_set(set, layout_type)
+		for (i = 0; i < set->nr_codecs; i++)
+			if (!strcmp(set->codecs[i]->name, name)) {
+				codec = set->codecs[i];
+				if (!try_module_get(codec->owner))
+					codec = NULL;
+				goto out;
+			}
+out:
+	mutex_unlock(&codec_lock);
+
+	return codec;
+}
+
+/*
+ * Asking for a codec's provider module.
+ *
+ * A codec name is the only thing that names the module implementing it, so an
+ * unresolved name is worth one request_module() and a second look. Two things
+ * have to be true before that happens. The name came off the wire, and it ends
+ * up in a module alias, so it is only used if every character could be part of
+ * one. And it is only asked for once in a while: a peer that names a hundred
+ * codecs, or a layout that keeps being fetched, must not turn into a hundred
+ * modprobes - so an attempt is remembered for a while, and forgotten as soon as
+ * the name resolves. A provider that loads later by any other route is found by
+ * the ordinary lookup, so nothing here is load-bearing for that case.
+ */
+#define ENCODED_EXTENT_CODEC_RETRY_INTERVAL	(30 * HZ)
+#define ENCODED_EXTENT_CODEC_ATTEMPTS		8
+
+struct encoded_extent_codec_attempt {
+	char		name[ENCODED_EXTENT_CODEC_NAME_MAX + 1];
+	unsigned long	when;
+};
+
+static DEFINE_MUTEX(codec_attempt_lock);
+static struct encoded_extent_codec_attempt
+	codec_attempts[ENCODED_EXTENT_CODEC_ATTEMPTS];
+static unsigned int codec_attempt_next;
+static atomic_long_t codec_load_attempts = ATOMIC_LONG_INIT(0);
+
+/* Could this name be part of a module alias? The wire says nothing about it. */
+static bool codec_name_loadable(const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; name[i]; i++) {
+		unsigned char c = name[i];
+
+		if (!isalnum(c) && c != '-' && c != '_')
+			return false;
+	}
+
+	return i > 0 && i <= ENCODED_EXTENT_CODEC_NAME_MAX;
+}
+
+/* Remember this attempt; false if the same name was tried recently. */
+static bool codec_attempt_begin(const char *name)
+{
+	unsigned int i, slot = codec_attempt_next;
+	unsigned long now = jiffies;
+	bool retry = true;
+
+	mutex_lock(&codec_attempt_lock);
+	for (i = 0; i < ARRAY_SIZE(codec_attempts); i++) {
+		if (!strcmp(codec_attempts[i].name, name)) {
+			slot = i;
+			retry = time_after(now, codec_attempts[i].when +
+					ENCODED_EXTENT_CODEC_RETRY_INTERVAL);
+			break;
+		}
+	}
+
+	if (retry) {
+		strscpy(codec_attempts[slot].name, name,
+			sizeof(codec_attempts[slot].name));
+		codec_attempts[slot].when = now;
+		codec_attempt_next = (slot + 1) % ARRAY_SIZE(codec_attempts);
+	}
+	mutex_unlock(&codec_attempt_lock);
+
+	return retry;
+}
+
+/* The provider is there now: do not hold the name against a later request. */
+static void codec_attempt_forget(const char *name)
+{
+	unsigned int i;
+
+	mutex_lock(&codec_attempt_lock);
+	for (i = 0; i < ARRAY_SIZE(codec_attempts); i++)
+		if (!strcmp(codec_attempts[i].name, name))
+			codec_attempts[i].name[0] = '\0';
+	mutex_unlock(&codec_attempt_lock);
+}
+
+const struct encoded_extent_codec *encoded_extent_codec_find_or_load(
+		u32 layout_type, const char *name)
+{
+	const struct encoded_extent_codec *codec;
+
+	codec = encoded_extent_codec_find(layout_type, name);
+	if (codec || !name || !codec_name_loadable(name))
+		return codec;
+
+	if (codec_attempt_begin(name)) {
+		atomic_long_inc(&codec_load_attempts);
+		request_module(ENCODED_EXTENT_CODEC_MODULE_PREFIX "%s", name);
+		codec = encoded_extent_codec_find(layout_type, name);
+		if (codec)
+			codec_attempt_forget(name);
+	}
+
+	return codec;
+}
+EXPORT_SYMBOL_GPL(encoded_extent_codec_find_or_load);
+
+unsigned long encoded_extent_codec_load_attempts(void)
+{
+	return atomic_long_read(&codec_load_attempts);
+}
+EXPORT_SYMBOL_GPL(encoded_extent_codec_load_attempts);
+
+void encoded_extent_codec_put(const struct encoded_extent_codec *codec)
+{
+	if (codec)
+		module_put(codec->owner);
+}
+EXPORT_SYMBOL_GPL(encoded_extent_codec_put);
