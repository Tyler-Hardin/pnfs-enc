diff --git a/fs/nfsd/bcachefs_layout.c b/fs/nfsd/bcachefs_layout.c
new file mode 100644
index 000000000..9590fb386
--- /dev/null
+++ b/fs/nfsd/bcachefs_layout.c
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * pNFS layout type for bcachefs encoded extents: the server side.
+ *
+ * A pNFS layout type says "this file's data is served by a data service with a
+ * layout-specific protocol, not by NFS READ/WRITE". Everything else about the
+ * file - namespace, attributes, coherence, state, locks, recovery - stays
+ * stock NFS, which is the point of using a layout type instead of a filesystem
+ * of our own.
+ *
+ * The data service is a small RPC program of its own (linux/encoded_extent_ds.h
+ * describes the wire). This file only negotiates the layout: it hands the
+ * client everything it needs to reach the data service for this file - the
+ * address the client reached *us* at (flexfiles' trick for an MDS that is also
+ * the DS) and the file handle - and nothing else. The extent map, block size,
+ * encoded extent ceiling and codec set come from the data service itself, so
+ * they cannot go stale against its own view.
+ *
+ * Deliberate deviations from what a pNFS layout is "supposed" to be:
+ *
+ *   - no deviceid, so no GETDEVICEINFO and no deviceid hash for what is one
+ *     server; the addressing rides in our own layout body. The stubs below
+ *     exist only so an insistent client gets an error, not a NULL deref;
+ *   - LAYOUTCOMMIT is a no-op: the data service writes through the filesystem,
+ *     so the inode's size and times are already right, exactly flexfiles'
+ *     situation. (The MDS's own cached attribute view is the open question the
+ *     spike notes call out; a real LAYOUTCOMMIT is where that gets fixed.)
+ *   - recalls are disabled: the data service is the only copy, not a cache
+ *     tier, so there is nothing to recall.
+ */
+
+#include <linux/slab.h>
+#include <linux/dcache.h>
+#include <linux/nfs4.h>
+#include <linux/nfsd/debug.h>
+#include <linux/sunrpc/addr.h>
+#include <linux/encoded_extent.h>
+#include <linux/encoded_extent_ds.h>
+
+#include "pnfs.h"
+#include "vfs.h"
+
+#define NFSDDBG_FACILITY	NFSDDBG_PNFS
+
+#define NFSD_BC_LAYOUT_VERSION	4
+#define NFSD_BC_ADDR_MAX	64
+
+/*
+ * The data service's port comes from the data service itself (encoded_ds.c):
+ * it binds the port, so it owns the number. 0 means no data service is
+ * running, and a client that gets a layout with no address falls back to MDS
+ * I/O. The declarations are in encoded_extent_ds.h.
+ */
+
+struct nfsd4_bc_layout {
+	u8		fh[ENCODED_DS_MAX_FH];
+	u32		fh_len;
+	u32		port;
+	char		addr[NFSD_BC_ADDR_MAX];
+	u32		addr_len;
+
+	/*
+	 * The encoded extent ceiling and alignment for this file, from the
+	 * filesystem that exports it. The MDS is also the data service here, so
+	 * these are the same values the data service will apply: nothing goes
+	 * stale, and the client can size its requests without a round trip.
+	 * (If the two are ever split, this - not the extent map - is what would
+	 * have to become a call to the data service.)
+	 */
+	u32		unit_max;
+	u32		unit_align;
+
+	/*
+	 * The codecs this export may serve extents with, named, in the order the
+	 * data service's descriptors index them. This is how a peer learns which
+	 * codecs it may be asked to run without knowing anything about the
+	 * exporting filesystem's own numbering for them; see
+	 * include/linux/encoded_extent.h. Empty means the filesystem registered
+	 * no codecs, so nothing is served encoded and the client uses the MDS.
+	 */
+	const char	*codec[ENCODED_DS_MAX_CODECS];
+	u32		nr_codecs;
+};
+
+static __be32
+nfsd4_bc_proc_layoutget(struct svc_rqst *rqstp, struct inode *inode,
+			const struct svc_fh *fhp, struct nfsd4_layoutget *args)
+{
+	struct nfsd4_layout_seg *seg = &args->lg_seg;
+	const struct encoded_extent_ops *ops;
+	struct nfsd4_bc_layout *bl;
+	unsigned int i;
+
+	ops = inode->i_sb->s_export_op->encoded_extent_ops;
+	if (!ops)
+		return nfserr_serverfault;
+
+	/*
+	 * A backend that says it cannot serve this filesystem at all - a unit
+	 * larger than its read path can carry, which it has already logged
+	 * about - gets no layout. Handing one out would send the client to a
+	 * service that refuses every range, and NFS4ERR_LAYOUTTRYLATER is
+	 * exactly "use the MDS for now, ask me again later".
+	 */
+	if (!ops->unit_max(inode))
+		return nfserr_layouttrylater;
+
+	/*
+	 * The data service authenticates AUTH_NULL/AUTH_UNIX and checks the
+	 * caller against nfsd's client list; it does not speak RPCSEC_GSS yet.
+	 * Rather than hand a GSS mount a layout it would then fall back from on
+	 * every range - or, worse, be tempted to serve over AUTH_UNIX - decline
+	 * the layout outright: the client uses MDS I/O and the data service is
+	 * never in the picture for that mount. AUTH_UNIX is the flavor the
+	 * service both authenticates and authorizes.
+	 */
+	if (rqstp->rq_cred.cr_flavor != RPC_AUTH_UNIX)
+		return nfserr_layouttrylater;
+
+	/*
+	 * A layout is what tells a client where the data service is, so this is
+	 * where it has to exist; a failure here means port 0 in the layout and
+	 * a client that falls back to MDS I/O, which is correct.
+	 */
+	encoded_ds_start();
+
+	bl = kzalloc(sizeof(*bl), GFP_KERNEL);
+	if (!bl)
+		return nfserrno(-ENOMEM);
+	args->lg_content = bl;
+
+	bl->fh_len = fhp->fh_handle.fh_size;
+	if (bl->fh_len > sizeof(bl->fh))
+		bl->fh_len = sizeof(bl->fh);
+	memcpy(bl->fh, &fhp->fh_handle.fh_raw, bl->fh_len);
+
+	bl->port = encoded_ds_get_port();
+	bl->addr_len = rpc_ntop((struct sockaddr *) &rqstp->rq_daddr,
+				bl->addr, sizeof(bl->addr));
+	if (bl->addr_len >= sizeof(bl->addr))
+		bl->addr_len = 0;
+
+	bl->unit_max = ops->unit_max(inode);
+	bl->unit_align = ops->unit_align(inode);
+	/*
+	 * This filesystem's own codecs, in its own order: the peer resolves the
+	 * positions against the names it is given here, and there may be another
+	 * filesystem under the same layout type whose codecs are numbered
+	 * differently.
+	 */
+	bl->nr_codecs = min(ops->nr_codecs, (unsigned int)ARRAY_SIZE(bl->codec));
+	for (i = 0; i < bl->nr_codecs; i++)
+		bl->codec[i] = ops->codecs[i]->name;
+
+	/*
+	 * Whole file. Which ranges are servable encoded is the data service's
+	 * answer, not the layout's: an encoded extent is whatever the
+	 * filesystem stored, and a hole, an inline or encrypted extent, or a
+	 * nocow inode is not.
+	 */
+	seg->offset = 0;
+	seg->length = NFS4_MAX_UINT64;
+
+	return nfs_ok;
+}
+
+static __be32
+nfsd4_bc_encode_layoutget(struct xdr_stream *xdr,
+			  const struct nfsd4_layoutget *lgp)
+{
+	const struct nfsd4_bc_layout *bl = lgp->lg_content;
+	u32 len, i;
+
+	/*
+	 * lo_content is an opaque, and the layout driver is the thing that
+	 * knows its length: the generic encoder writes the layout4 header and
+	 * then hands us the stream, so the length prefix is ours to write
+	 * (flexfiles does the same). Without it the client reads the first
+	 * four body bytes as the length and sees a two-byte layout.
+	 */
+	len = 4 + 4 +				/* version, port */
+	      4 + xdr_align_size(bl->addr_len) +
+	      4 + xdr_align_size(bl->fh_len) +
+	      4 + 4 +				/* unit_max, unit_align */
+	      4;				/* nr_codecs */
+	for (i = 0; i < bl->nr_codecs; i++)
+		len += 4 + xdr_align_size(strlen(bl->codec[i]));
+
+	if (xdr_stream_encode_u32(xdr, len) != XDR_UNIT)
+		return nfserr_resource;
+	if (xdr_stream_encode_u32(xdr, NFSD_BC_LAYOUT_VERSION) != XDR_UNIT)
+		return nfserr_resource;
+	if (xdr_stream_encode_u32(xdr, bl->port) != XDR_UNIT)
+		return nfserr_resource;
+	if (xdr_stream_encode_opaque(xdr, bl->addr, bl->addr_len) < 0)
+		return nfserr_resource;
+	if (xdr_stream_encode_opaque(xdr, bl->fh, bl->fh_len) < 0)
+		return nfserr_resource;
+	if (xdr_stream_encode_u32(xdr, bl->unit_max) != XDR_UNIT)
+		return nfserr_resource;
+	if (xdr_stream_encode_u32(xdr, bl->unit_align) != XDR_UNIT)
+		return nfserr_resource;
+	if (xdr_stream_encode_u32(xdr, bl->nr_codecs) != XDR_UNIT)
+		return nfserr_resource;
+	for (i = 0; i < bl->nr_codecs; i++)
+		if (xdr_stream_encode_opaque(xdr, bl->codec[i],
+					     strlen(bl->codec[i])) < 0)
+			return nfserr_resource;
+
+	return nfs_ok;
+}
+
+/* No deviceid is ever handed out, so a well-behaved client never asks. */
+static __be32
+nfsd4_bc_proc_getdeviceinfo(struct super_block *sb, struct svc_rqst *rqstp,
+			    struct nfs4_client *clp,
+			    struct nfsd4_getdeviceinfo *gdp)
+{
+	return nfserr_inval;
+}
+
+static __be32
+nfsd4_bc_encode_getdeviceinfo(struct xdr_stream *xdr,
+			      const struct nfsd4_getdeviceinfo *gdp)
+{
+	return nfserr_inval;
+}
+
+static __be32
+nfsd4_bc_proc_layoutcommit(struct inode *inode, struct svc_rqst *rqstp,
+			   struct nfsd4_layoutcommit *lcp)
+{
+	return nfs_ok;
+}
+
+const struct nfsd4_layout_ops bc_layout_ops = {
+	.notify_types		= 0,
+	.disable_recalls	= true,
+	.proc_getdeviceinfo	= nfsd4_bc_proc_getdeviceinfo,
+	.encode_getdeviceinfo	= nfsd4_bc_encode_getdeviceinfo,
+	.proc_layoutget		= nfsd4_bc_proc_layoutget,
+	.encode_layoutget	= nfsd4_bc_encode_layoutget,
+	.proc_layoutcommit	= nfsd4_bc_proc_layoutcommit,
+};
diff --git a/fs/nfsd/encoded_ds.c b/fs/nfsd/encoded_ds.c
new file mode 100644
index 000000000..6eadfe312
--- /dev/null
+++ b/fs/nfsd/encoded_ds.c
@@ -0,0 +1,1062 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The encoded-extent data service: move a filesystem's compressed, checksummed
+ * extents to a peer that does the codec work itself.
+ *
+ * This is the server half of the pNFS layout type in bcachefs_layout.c, but it
+ * is deliberately not pNFS-shaped. It is a small RPC program of its own, so it
+ * rides on sunrpc - transport, request slots, reconnects, timeouts, a thread
+ * pool - and can be developed and tested without touching the NFS protocol.
+ * The wire is linux/encoded_extent_ds.h.
+ *
+ * Files are addressed the way NFS addresses them, an export path plus the file
+ * handle the MDS handed out, and resolved with exportfs. So this works for any
+ * filesystem that can be exported, and everything filesystem-specific is one
+ * vtable (linux/encoded_extent.h). Checksums stay the filesystem's: it verifies
+ * them on read and computes them on write, so no csum code is copied here and a
+ * client cannot store an extent whose checksum does not describe it.
+ *
+ * The codec is named, not numbered, on the wire: the layout carries the names
+ * the export's filesystem registered and a descriptor carries a position in
+ * that list, so this file is one of the only two places the filesystem's own
+ * numbering is translated - see the codec section below.
+ *
+ * Authorization: the service runs nfsd's own checks, not a policy of its own.
+ * Its RPC program shares nfsd's authentication class ("nfsd"), so
+ * svc_set_client() resolves the caller against the same client list the exports
+ * use; each file is then resolved and opened through nfsd_open(), which finds
+ * the export by fsid for that client, checks the handle is inside the export
+ * (nfsd_acceptable), drops to the client's credentials with root/all-squash,
+ * and checks the inode mode and the export's read-only flag. A caller reaching
+ * this port gets exactly the access the MDS would give it for the same file,
+ * and no more. RPCSEC_GSS is not implemented on the data path, so a mount that
+ * requires it is never offered a layout at all (see bcachefs_layout.c) rather
+ * than being quietly downgraded to AUTH_UNIX.
+ *
+ * The other half of the contract is the backend's: what a caller cannot do is
+ * store something the filesystem would not have written itself. Every write
+ * goes through the filesystem's own block allocation, checksum and validation,
+ * and a payload the backend will not describe is refused rather than stored.
+ *
+ * Status: the program number is unregistered and experimental.
+ */
+
+#include <linux/module.h>
+#include <linux/cred.h>
+#include <linux/debugfs.h>
+#include <linux/exportfs.h>
+#include <linux/file.h>
+#include <linux/freezer.h>
+#include <linux/fs.h>
+#include <linux/fs_struct.h>
+#include <linux/namei.h>
+#include <linux/nfs4.h>
+#include <linux/sunrpc/auth.h>
+#include <linux/sunrpc/svc.h>
+#include <linux/sunrpc/svcsock.h>
+#include <linux/encoded_extent.h>
+#include <linux/encoded_extent_ds.h>
+
+#include "nfsd.h"	/* NFSD_MAXVERS, via netns.h below */
+#include "nfsfh.h"	/* key_len(), the knfsd handle layout, nfsd_open() */
+#include "netns.h"	/* nfsd_copy_write_verifier() */
+#include "vfs.h"	/* nfsd_open(): fh_verify + the client's own open */
+
+/*
+ * One whole encoded extent plus the descriptor and XDR overhead around it.
+ * sunrpc sizes both the request and the reply page budget from this number, and
+ * RPCSVC_MAXPAYLOAD_TCP (4 MiB) is the transport's own ceiling. A backend whose
+ * unit_max is larger than this cannot be served in one call and falls back;
+ * btrfs (128 KiB) and bcachefs (up to 2 MiB) both fit.
+ */
+#define ENCODED_DS_BUFSIZE	(ENCODED_DS_MAX_PAYLOAD + 2 * PAGE_SIZE)
+
+/* status, descriptor, opaque header, payload, in XDR words. */
+#define ENCODED_DS_READ_WORDS	(1 + 8 + 1 + ENCODED_DS_MAX_PAYLOAD / XDR_UNIT)
+
+static unsigned short encoded_ds_port = 2050;
+module_param(encoded_ds_port, ushort, 0444);
+MODULE_PARM_DESC(encoded_ds_port,
+	"TCP port the encoded-extent data service listens on (0 = pick one)");
+
+static unsigned int encoded_ds_nthreads = 8;
+module_param(encoded_ds_nthreads, uint, 0444);
+MODULE_PARM_DESC(encoded_ds_nthreads,
+	"Number of encoded-extent data service threads");
+
+/*
+ * The port actually bound, which is what a layout hands to a client: 0 until
+ * the service is running, which is also how a layout says "no data service".
+ */
+static unsigned short encoded_ds_bound_port;
+
+static struct svc_serv *encoded_ds_serv;
+static struct dentry *encoded_ds_debugfs;
+
+static atomic_t ds_nr_probe = ATOMIC_INIT(0);
+static atomic_t ds_nr_read = ATOMIC_INIT(0);
+static atomic_t ds_nr_write = ATOMIC_INIT(0);
+/* What the backends reported: a write left in the page cache, and one synced. */
+static atomic_t ds_nr_write_unstable = ATOMIC_INIT(0);
+/*
+ * Time spent inside the backend, per direction, in nanoseconds: the service's
+ * cost is this plus the transport, and a throughput number cannot tell the two
+ * apart. Written under a lock - this is a test and debug counter, not part of
+ * the data path's own accounting.
+ */
+static DEFINE_SPINLOCK(ds_ns_lock);
+static u64 ds_read_ns, ds_write_ns;
+static atomic_t ds_nr_write_file_sync = ATOMIC_INIT(0);
+static atomic_t ds_nr_not_encoded = ATOMIC_INIT(0);
+static atomic_t ds_nr_codec_unknown = ATOMIC_INIT(0);
+static atomic_t ds_nr_errors = ATOMIC_INIT(0);
+/*
+ * How many calls the service had inside the backend at once, and the high-water
+ * mark of that. The thread count says how many it *can* have; this says how many
+ * the client actually kept in its hands, which is what a wide workload is about
+ * - a client that walks one unit per request leaves a service with twelve
+ * threads running one deep.
+ */
+static atomic_t ds_inflight = ATOMIC_INIT(0);
+static atomic_t ds_inflight_max = ATOMIC_INIT(0);
+
+static void ds_inflight_enter(void)
+{
+	int n = atomic_inc_return(&ds_inflight), max;
+
+	for (;;) {
+		max = atomic_read(&ds_inflight_max);
+		if (n <= max || atomic_cmpxchg(&ds_inflight_max, max, n) == max)
+			return;
+	}
+}
+
+static void ds_inflight_leave(void)
+{
+	atomic_dec(&ds_inflight);
+}
+
+/* ------------------------------------------------------------- arguments -- */
+
+/*
+ * A file is named the way NFS names one: by the file handle the MDS handed out.
+ * It is opaque bytes on the wire because that is what nfsd gives us, and the
+ * exportfs fid inside it is a word array, so the conversion happens in exactly
+ * one place below.
+ */
+struct encoded_ds_addr {
+	u8		fh[ENCODED_DS_MAX_FH];
+	u32		fh_len;
+};
+
+struct encoded_ds_probeargs {
+	struct encoded_ds_addr addr;
+	u64		offset;
+	u64		len;
+};
+
+struct encoded_ds_readargs {
+	struct encoded_ds_addr addr;
+	u64		offset;
+	u32		buf_size;
+};
+
+struct encoded_ds_writeargs {
+	struct encoded_ds_addr addr;
+	u64		offset;
+	struct encoded_extent_desc desc;
+	u32		codec;		/* wire position, before translation */
+	u32		stable;		/* NFS's levels, see the wire header */
+	void		*payload;	/* kvmalloc'd, freed by pc_release */
+	u32		payload_len;
+};
+
+struct encoded_ds_reply {
+	s32		status;
+	/* PROBE and READ only: what the range was answered with. */
+	struct encoded_extent_desc desc;
+	u32		codec;		/* wire position, translated from desc */
+	/* WRITE only: what the backend reached, and the netns write verifier. */
+	enum encoded_extent_stable committed;
+	__be32		verf[2];
+	/* READ only: the encoded payload, freed by pc_release. */
+	void		*payload;
+	size_t		payload_len;
+};
+
+union encoded_ds_xdrstore {
+	struct encoded_ds_probeargs	probe;
+	struct encoded_ds_readargs	read;
+	struct encoded_ds_writeargs	write;
+	struct encoded_ds_reply		reply;
+};
+
+/* --------------------------------------------------------------- decoding -- */
+
+static bool
+encoded_ds_decode_addr(struct xdr_stream *xdr, struct encoded_ds_addr *addr)
+{
+	void *p;
+	ssize_t len;
+
+	len = xdr_stream_decode_opaque_inline(xdr, &p, sizeof(addr->fh));
+	if (len < 0)
+		return false;
+	addr->fh_len = len;
+	if (len)
+		memcpy(addr->fh, p, len);
+
+	return true;
+}
+
+/* NULL: no arguments to decode and nothing to send back. */
+static bool
+encoded_ds_void(struct svc_rqst *rqstp, struct xdr_stream *xdr)
+{
+	return true;
+}
+
+static bool
+encoded_ds_decode_probe(struct svc_rqst *rqstp, struct xdr_stream *xdr)
+{
+	struct encoded_ds_probeargs *args = rqstp->rq_argp;
+
+	if (!encoded_ds_decode_addr(xdr, &args->addr))
+		return false;
+
+	return xdr_stream_decode_u64(xdr, &args->offset) == 0 &&
+	       xdr_stream_decode_u64(xdr, &args->len) == 0;
+}
+
+static bool
+encoded_ds_decode_read(struct svc_rqst *rqstp, struct xdr_stream *xdr)
+{
+	struct encoded_ds_readargs *args = rqstp->rq_argp;
+
+	if (!encoded_ds_decode_addr(xdr, &args->addr))
+		return false;
+
+	return xdr_stream_decode_u64(xdr, &args->offset) == 0 &&
+	       xdr_stream_decode_u32(xdr, &args->buf_size) == 0;
+}
+
+/*
+ * The wire carries a codec's position in the layout's list; the backend speaks
+ * its filesystem's own numbering. Translating between them is this file's job
+ * because it is the only place that sees both, and it is what keeps each
+ * numbering on its own side. A position that names no registered codec, or an
+ * extent whose codec the filesystem has not registered, is not served encoded.
+ */
+static bool
+encoded_ds_translate_codec(const struct encoded_extent_ops *ops, u32 codec,
+			   struct encoded_extent_desc *desc)
+{
+	const struct encoded_extent_codec *c;
+
+	/*
+	 * The position is in the layout's list, which is *this* filesystem's
+	 * list: two filesystems can be exported under one layout type, and a
+	 * lookup that ignored which one the file is on would translate a
+	 * position into another filesystem's numbering.
+	 */
+	c = encoded_extent_codec_by_position(ops, codec);
+	if (!c)
+		return false;
+	desc->compression = c->compression;
+	return true;
+}
+
+static bool
+encoded_ds_encode_codec(const struct encoded_extent_ops *ops,
+			struct encoded_extent_desc *desc, u32 *codec)
+{
+	/*
+	 * A layout's list is capped, so a filesystem with more codecs than that
+	 * would produce positions the peer cannot see. Those extents are not
+	 * served encoded rather than numbered ambiguously.
+	 */
+	return encoded_extent_codec_by_compression(ops, desc->compression,
+						   codec) &&
+	       *codec < ENCODED_DS_MAX_CODECS;
+}
+
+static bool
+encoded_ds_decode_desc(struct xdr_stream *xdr, struct encoded_extent_desc *desc,
+		       u32 *codec)
+{
+	struct encoded_ds_desc wire;
+	u32 encrypted;
+
+	if (xdr_stream_decode_u64(xdr, &wire.unit_offset) < 0)
+		return false;
+	if (xdr_stream_decode_u64(xdr, &wire.unit_len) < 0)
+		return false;
+	if (xdr_stream_decode_u64(xdr, &wire.unencoded_offset) < 0)
+		return false;
+	if (xdr_stream_decode_u32(xdr, &wire.codec) < 0)
+		return false;
+	if (xdr_stream_decode_u32(xdr, &encrypted) < 0)
+		return false;
+	wire.encrypted = encrypted != 0;
+
+	desc->unit_offset	= wire.unit_offset;
+	desc->unit_len		= wire.unit_len;
+	desc->unencoded_offset	= wire.unencoded_offset;
+	desc->encrypted		= wire.encrypted;
+	desc->compression	= 0;
+	*codec			= wire.codec;
+
+	return true;
+}
+
+static bool
+encoded_ds_decode_write(struct svc_rqst *rqstp, struct xdr_stream *xdr)
+{
+	struct encoded_ds_writeargs *args = rqstp->rq_argp;
+	struct xdr_buf payload;
+	u32 len;
+
+	if (!encoded_ds_decode_addr(xdr, &args->addr))
+		return false;
+	if (xdr_stream_decode_u64(xdr, &args->offset) < 0)
+		return false;
+	if (!encoded_ds_decode_desc(xdr, &args->desc, &args->codec))
+		return false;
+	if (xdr_stream_decode_u32(xdr, &args->stable) < 0)
+		return false;
+	/*
+	 * Refuse rather than round up: a level this service does not understand
+	 * must not be answered as though it were one it does. The caller falls
+	 * back to the MDS, which is always correct.
+	 */
+	if (args->stable > ENCODED_EXTENT_FILE_SYNC)
+		return false;
+
+	/*
+	 * The payload is up to ENCODED_DS_MAX_PAYLOAD, which the stream's
+	 * one-page inline/scratch path cannot express: take it as a sub-buffer
+	 * and copy it out, exactly as nfsd's WRITE decoder does. The backend
+	 * vtable takes a linear buffer, so the copy is unavoidable for now.
+	 */
+	if (xdr_stream_decode_u32(xdr, &len) < 0)
+		return false;
+	if (len > ENCODED_DS_MAX_PAYLOAD ||
+	    len > svc_max_payload(rqstp))
+		return false;
+	if (!xdr_stream_subsegment(xdr, &payload, len))
+		return false;
+
+	args->payload = kvmalloc(len, GFP_KERNEL);
+	if (!args->payload)
+		return false;
+	args->payload_len = len;
+
+	if (read_bytes_from_xdr_buf(&payload, 0, args->payload, len)) {
+		kvfree(args->payload);
+		args->payload = NULL;
+		args->payload_len = 0;
+		return false;
+	}
+
+	return true;
+}
+
+/* --------------------------------------------------------------- encoding -- */
+
+/*
+ * A payload larger than a page cannot be encoded through the xdr_stream's
+ * inline path - xdr_reserve_space() refuses anything over a page - so it goes
+ * into reply pages and is attached with svcxdr_encode_opaque_pages(), the same
+ * way nfsd sends an NFS READ. rq_next_page is what the release path uses to
+ * find the pages again, so it must be advanced over them.
+ */
+static bool
+encoded_ds_encode_payload(struct svc_rqst *rqstp, struct xdr_stream *xdr,
+			  const void *payload, size_t len)
+{
+	struct page **first = rqstp->rq_respages + 1;
+	unsigned int npages = DIV_ROUND_UP(len, PAGE_SIZE);
+	const u8 *p = payload;
+	size_t left = len;
+	unsigned int i;
+
+	if (first + npages > rqstp->rq_page_end)
+		return false;
+	if (xdr_stream_encode_u32(xdr, len) < 0)
+		return false;
+
+	for (i = 0; i < npages; i++) {
+		size_t n = min_t(size_t, left, PAGE_SIZE);
+
+		memcpy(page_address(first[i]), p, n);
+		p += n;
+		left -= n;
+	}
+
+	rqstp->rq_next_page = first + npages;
+	svcxdr_encode_opaque_pages(rqstp, xdr, first, 0, len);
+	return true;
+}
+
+/*
+ * The head every reply shares: the status, and the descriptor and codec the
+ * status refers to. A refused request still carries the descriptor - the
+ * counters and a fallback caller both want to know what was asked for.
+ */
+static bool
+encoded_ds_encode_reply_head(struct xdr_stream *xdr,
+			     const struct encoded_ds_reply *reply)
+{
+	if (xdr_stream_encode_u32(xdr, (u32)reply->status) < 0)
+		return false;
+	if (xdr_stream_encode_u64(xdr, reply->desc.unit_offset) < 0)
+		return false;
+	if (xdr_stream_encode_u64(xdr, reply->desc.unit_len) < 0)
+		return false;
+	if (xdr_stream_encode_u64(xdr, reply->desc.unencoded_offset) < 0)
+		return false;
+	if (xdr_stream_encode_u32(xdr, reply->codec) < 0)
+		return false;
+	if (xdr_stream_encode_u32(xdr, reply->desc.encrypted ? 1 : 0) < 0)
+		return false;
+	return true;
+}
+
+static bool
+encoded_ds_encode_reply(struct svc_rqst *rqstp, struct xdr_stream *xdr)
+{
+	const struct encoded_ds_reply *reply = rqstp->rq_resp;
+
+	if (!encoded_ds_encode_reply_head(xdr, reply))
+		return false;
+	if (reply->payload &&
+	    !encoded_ds_encode_payload(rqstp, xdr, reply->payload,
+				       reply->payload_len))
+		return false;
+
+	return true;
+}
+
+/*
+ * A write reply says what the service did with the bytes, not just that it
+ * accepted them: @committed is the level the backend reached, and the verifier
+ * is the netns's own, so a client that commits later can tell whether a server
+ * restart lost the data.
+ */
+static bool
+encoded_ds_encode_write_reply(struct svc_rqst *rqstp, struct xdr_stream *xdr)
+{
+	const struct encoded_ds_reply *reply = rqstp->rq_resp;
+
+	/*
+	 * No descriptor: a write's reply is about the bytes, and the caller
+	 * already knows which unit it sent. A read's reply needs one because
+	 * the unit the service answers with is the one covering the offset it
+	 * asked about, which may be wider than the request.
+	 */
+	if (xdr_stream_encode_u32(xdr, (u32)reply->status) < 0)
+		return false;
+	if (xdr_stream_encode_u32(xdr, (u32)reply->committed) < 0)
+		return false;
+	if (xdr_stream_encode_opaque_fixed(xdr, reply->verf,
+					   ENCODED_DS_WRITEVERF) < 0)
+		return false;
+	return true;
+}
+
+static void
+encoded_ds_release_read(struct svc_rqst *rqstp)
+{
+	struct encoded_ds_reply *reply = rqstp->rq_resp;
+
+	kvfree(reply->payload);
+	reply->payload = NULL;
+}
+
+static void
+encoded_ds_release_write(struct svc_rqst *rqstp)
+{
+	struct encoded_ds_writeargs *args = rqstp->rq_argp;
+
+	kvfree(args->payload);
+	args->payload = NULL;
+}
+
+/* ------------------------------------------------------- resolving a file -- */
+
+struct encoded_ds_file {
+	struct file			*file;
+	const struct encoded_extent_ops	*ops;
+};
+
+static void encoded_ds_close(struct encoded_ds_file *f)
+{
+	fput(f->file);
+}
+
+/*
+ * nfsd_open() reports nfsd's own __be32 status; this wire carries a plain
+ * errno. nfsd has no generic nfs-status-to-errno helper (nfserrno() goes the
+ * other way), so map the ones a refusal can actually be, as lockd does with its
+ * switch. The client falls back to the MDS on any non-zero status, so an
+ * unmapped one costs only the precision of the debug counter.
+ */
+static int encoded_ds_nfserr(__be32 status)
+{
+	switch (status) {
+	case nfs_ok:		return 0;
+	case nfserr_stale:
+	case nfserr_badhandle:	return -ESTALE;
+	case nfserr_acces:	return -EACCES;
+	case nfserr_wrongsec:	return -EACCES;
+	case nfserr_perm:	return -EPERM;
+	case nfserr_rofs:	return -EROFS;
+	case nfserr_noent:	return -ENOENT;
+	case nfserr_isdir:
+	case nfserr_notdir:	return -EISDIR;
+	case nfserr_inval:	return -EINVAL;
+	case nfserr_nospc:	return -ENOSPC;
+	case nfserr_jukebox:	return -EAGAIN;
+	case nfserr_io:
+	case nfserr_serverfault:return -EIO;
+	default:		return -EPERM;
+	}
+}
+
+/*
+ * Resolve a client-supplied nfsd file handle to an open file, with nfsd's own
+ * authorization. This is deliberately lockd's nlm_fopen() shape: build an
+ * svc_fh from the wire handle and hand it to nfsd_open(), which runs
+ * fh_verify() - the export is found by fsid for *this* client (rq_client, set
+ * by encoded_ds_authenticate), the handle is checked to be inside the export
+ * (nfsd_acceptable), the task is dropped to the client's credentials with
+ * root/all-squash, and the inode mode and the export's read-only flag are
+ * checked - and then opens the file.
+ *
+ * That is the same access decision an MDS READ or WRITE gets, which is the
+ * parity this service promises. The export path the layout carries is no longer
+ * part of the trust path at all: the export comes from the handle's fsid and the
+ * presenting client, so a caller cannot name an export it is not allowed.
+ */
+static int
+encoded_ds_open(struct svc_rqst *rqstp, const struct encoded_ds_addr *addr,
+		int flags, struct encoded_ds_file *out)
+{
+	struct svc_fh fh;
+	struct file *file;
+	__be32 nfserr;
+	int access;
+
+	/*
+	 * nfsd's handle: one word of version/auth/fsid_type/fileid_type, the
+	 * fsid, then the fid. Refuse anything that is not one, rather than hand
+	 * a malformed handle to the verifier.
+	 */
+	if (addr->fh_len < 2 * XDR_UNIT || addr->fh_len > NFS4_FHSIZE ||
+	    addr->fh_len % XDR_UNIT)
+		return -EINVAL;
+	if (addr->fh[0] != 1 || addr->fh[1] != 0)
+		return -EINVAL;
+
+	fh_init(&fh, NFS4_FHSIZE);
+	fh.fh_handle.fh_size = addr->fh_len;
+	memcpy(fh.fh_handle.fh_raw, addr->fh, addr->fh_len);
+
+	/*
+	 * The layout was granted through this client's OPEN, so the holder
+	 * already has the file; NFSD_MAY_NOT_BREAK_LEASE is what nfsd's COMMIT
+	 * uses for the same reason (fs/nfsd/nfs4proc.c). Without it, opening a
+	 * file the client holds a delegation on tries to recall that delegation
+	 * from the very client that is asking us to write, and nfsd_open
+	 * returns nfserr_jukebox.
+	 */
+	access = (flags & O_ACCMODE) == O_RDONLY ? NFSD_MAY_READ : NFSD_MAY_WRITE;
+	access |= NFSD_MAY_NOT_BREAK_LEASE;
+	nfserr = nfsd_open(rqstp, &fh, S_IFREG, access, &file);
+	fh_put(&fh);
+	if (nfserr) {
+		pr_warn_ratelimited("encoded_ds: open refused: nfserr=%08x fh_len=%u access=%d\n",
+				    be32_to_cpu(nfserr), addr->fh_len, access);
+		return encoded_ds_nfserr(nfserr);
+	}
+
+	out->ops = file_inode(file)->i_sb->s_export_op->encoded_extent_ops;
+	if (WARN_ON_ONCE(!out->ops)) {
+		fput(file);
+		return -ENODATA;
+	}
+
+	out->file = file;
+	return 0;
+}
+
+/* ------------------------------------------------------------- procedures -- */
+
+static void
+encoded_ds_failed(struct encoded_ds_reply *reply, int ret)
+{
+	if (ret == -ENODATA)
+		atomic_inc(&ds_nr_not_encoded);
+	else
+		atomic_inc(&ds_nr_errors);
+	reply->status = ret;
+}
+
+static __be32
+encoded_ds_proc_null(struct svc_rqst *rqstp)
+{
+	return rpc_success;
+}
+
+static __be32
+encoded_ds_proc_probe(struct svc_rqst *rqstp)
+{
+	struct encoded_ds_probeargs *args = rqstp->rq_argp;
+	struct encoded_ds_reply *reply = rqstp->rq_resp;
+	struct encoded_ds_file f;
+	int ret;
+
+	atomic_inc(&ds_nr_probe);
+
+	ret = encoded_ds_open(rqstp, &args->addr, O_RDONLY, &f);
+	if (ret)
+		goto out_err;
+
+	ret = f.ops->probe(f.file, args->offset, args->len, &reply->desc);
+	encoded_ds_close(&f);
+	if (ret)
+		goto out_err;
+	if (!encoded_ds_encode_codec(f.ops, &reply->desc, &reply->codec)) {
+		atomic_inc(&ds_nr_codec_unknown);
+		ret = -ENODATA;
+		goto out_err;
+	}
+
+	return rpc_success;
+
+out_err:
+	encoded_ds_failed(reply, ret);
+	return rpc_success;
+}
+
+static __be32
+encoded_ds_proc_read(struct svc_rqst *rqstp)
+{
+	struct encoded_ds_readargs *args = rqstp->rq_argp;
+	struct encoded_ds_reply *reply = rqstp->rq_resp;
+	struct encoded_ds_file f;
+	u64 start;
+	size_t len;
+	void *buf;
+	int ret;
+
+	atomic_inc(&ds_nr_read);
+
+	ret = encoded_ds_open(rqstp, &args->addr, O_RDONLY, &f);
+	if (ret)
+		goto out_err;
+
+	/*
+	 * The caller says how much room it has for the encoded payload; the
+	 * backend is asked for the unit covering the offset and answers with
+	 * what it actually needed.
+	 */
+	len = min_t(u32, args->buf_size, f.ops->unit_max(file_inode(f.file)));
+	if (!len) {
+		encoded_ds_close(&f);
+		ret = -EINVAL;
+		goto out_err;
+	}
+
+	buf = kvzalloc(len, GFP_KERNEL);
+	if (!buf) {
+		encoded_ds_close(&f);
+		ret = -ENOMEM;
+		goto out_err;
+	}
+
+	start = ktime_get_ns();
+	ds_inflight_enter();
+	ret = f.ops->read(f.file, args->offset, args->buf_size, buf, &len,
+			  &reply->desc);
+	spin_lock(&ds_ns_lock);
+	ds_read_ns += ktime_get_ns() - start;
+	spin_unlock(&ds_ns_lock);
+	ds_inflight_leave();
+	encoded_ds_close(&f);
+	if (ret) {
+		kvfree(buf);
+		goto out_err;
+	}
+
+	/*
+	 * The backend named the codec in its own numbering; the peer is told
+	 * which one it is by position in the layout's list. A codec the
+	 * filesystem stores but has not registered is one this service cannot
+	 * hand out, so the range is not served encoded.
+	 */
+	if (!encoded_ds_encode_codec(f.ops, &reply->desc, &reply->codec)) {
+		atomic_inc(&ds_nr_codec_unknown);
+		kvfree(buf);
+		ret = -ENODATA;
+		goto out_err;
+	}
+
+	reply->payload = buf;
+	reply->payload_len = len;
+
+	return rpc_success;
+
+out_err:
+	encoded_ds_failed(reply, ret);
+	return rpc_success;
+}
+
+static __be32
+encoded_ds_proc_write(struct svc_rqst *rqstp)
+{
+	struct encoded_ds_writeargs *args = rqstp->rq_argp;
+	struct encoded_ds_reply *reply = rqstp->rq_resp;
+	struct encoded_ds_file f;
+	u64 start;
+	int ret;
+
+	atomic_inc(&ds_nr_write);
+
+	if (!args->payload_len) {
+		ret = -EINVAL;
+		goto out_err;
+	}
+
+	ret = encoded_ds_open(rqstp, &args->addr, O_RDWR, &f);
+	if (ret)
+		goto out_err;
+
+	/*
+	 * The peer named the codec by position in the layout's list and this
+	 * filesystem's own numbering is what its backend is written against.
+	 */
+	if (!encoded_ds_translate_codec(f.ops, args->codec, &args->desc)) {
+		atomic_inc(&ds_nr_codec_unknown);
+		encoded_ds_close(&f);
+		ret = -ENODATA;
+		goto out_err;
+	}
+
+	start = ktime_get_ns();
+	ds_inflight_enter();
+	ret = f.ops->write(f.file, args->offset, args->payload,
+			   args->payload_len, &args->desc,
+			   (enum encoded_extent_stable)args->stable,
+			   &reply->committed);
+	spin_lock(&ds_ns_lock);
+	ds_write_ns += ktime_get_ns() - start;
+	spin_unlock(&ds_ns_lock);
+	ds_inflight_leave();
+	encoded_ds_close(&f);
+	if (ret)
+		goto out_err;
+
+	/*
+	 * The verifier has to come from the same place nfsd's own WRITE and
+	 * COMMIT replies get theirs: it is the value a later commit is checked
+	 * against, so handing out a different one would make every unstable
+	 * write look lost.
+	 */
+	if (reply->committed == ENCODED_EXTENT_UNSTABLE)
+		atomic_inc(&ds_nr_write_unstable);
+	else if (reply->committed == ENCODED_EXTENT_FILE_SYNC)
+		atomic_inc(&ds_nr_write_file_sync);
+
+	nfsd_copy_write_verifier(reply->verf,
+				 net_generic(SVC_NET(rqstp), nfsd_net_id));
+
+	return rpc_success;
+
+out_err:
+	encoded_ds_failed(reply, ret);
+	return rpc_success;
+}
+
+/*
+ * The standard decode, call, encode shape; lockd's dispatcher is the same
+ * twenty lines (sunrpc has no shared helper, only per-program copies).
+ */
+static int
+encoded_ds_dispatch(struct svc_rqst *rqstp)
+{
+	const struct svc_procedure *procp = rqstp->rq_procinfo;
+	__be32 *statp = rqstp->rq_accept_statp;
+
+	/*
+	 * Start the request on the thread's own credentials. nfsd_open() installs
+	 * the client's as an override and nothing else clears it, so without this
+	 * a request path that does not open a file - the NULL procedure, the XDR
+	 * decode, the counters - would run under whatever identity the previous
+	 * request left behind. This is the same reset nfsd_setuser() does at its
+	 * own entry.
+	 */
+	put_cred(revert_creds(get_cred(current_real_cred())));
+
+	if (!procp->pc_decode(rqstp, &rqstp->rq_arg_stream))
+		goto out_decode_err;
+
+	*statp = procp->pc_func(rqstp);
+	if (*statp == rpc_drop_reply)
+		return 0;
+	if (*statp != rpc_success)
+		return 1;
+
+	if (!procp->pc_encode(rqstp, &rqstp->rq_res_stream))
+		goto out_encode_err;
+
+	return 1;
+
+out_decode_err:
+	*statp = rpc_garbage_args;
+	return 1;
+
+out_encode_err:
+	*statp = rpc_system_err;
+	return 1;
+}
+
+static const struct svc_procedure encoded_ds_procedures[] = {
+	[ENCODED_DS_NULL] = {
+		.pc_func	= encoded_ds_proc_null,
+		.pc_decode	= encoded_ds_void,
+		.pc_encode	= encoded_ds_void,
+		.pc_xdrressize	= 1,
+		.pc_name	= "NULL",
+	},
+	[ENCODED_DS_PROBE] = {
+		.pc_func	= encoded_ds_proc_probe,
+		.pc_decode	= encoded_ds_decode_probe,
+		.pc_encode	= encoded_ds_encode_reply,
+		.pc_argzero	= sizeof(struct encoded_ds_probeargs),
+		.pc_ressize	= sizeof(struct encoded_ds_reply),
+		.pc_xdrressize	= 1 + 8,
+		.pc_name	= "PROBE",
+	},
+	[ENCODED_DS_READ] = {
+		.pc_func	= encoded_ds_proc_read,
+		.pc_decode	= encoded_ds_decode_read,
+		.pc_encode	= encoded_ds_encode_reply,
+		.pc_release	= encoded_ds_release_read,
+		.pc_argzero	= sizeof(struct encoded_ds_readargs),
+		.pc_ressize	= sizeof(struct encoded_ds_reply),
+		.pc_xdrressize	= ENCODED_DS_READ_WORDS,
+		.pc_name	= "READ",
+	},
+	[ENCODED_DS_WRITE] = {
+		.pc_func	= encoded_ds_proc_write,
+		.pc_decode	= encoded_ds_decode_write,
+		.pc_encode	= encoded_ds_encode_write_reply,
+		.pc_release	= encoded_ds_release_write,
+		.pc_argzero	= sizeof(struct encoded_ds_writeargs),
+		.pc_ressize	= sizeof(struct encoded_ds_reply),
+		/* status, committed, verifier. */
+		.pc_xdrressize	= 2 + ENCODED_DS_WRITEVERF / XDR_UNIT,
+		.pc_name	= "WRITE",
+	},
+};
+
+/*
+ * vs_count is bumped per procedure by the generic init (this_cpu_inc), so it
+ * has to exist even though nothing here reads it.
+ */
+static DEFINE_PER_CPU_ALIGNED(unsigned long,
+			      encoded_ds_counts[ENCODED_DS_NR_PROCS]);
+
+static const struct svc_version encoded_ds_version = {
+	.vs_vers	= ENCODED_DS_VERSION,
+	.vs_nproc	= ENCODED_DS_NR_PROCS,
+	.vs_proc	= encoded_ds_procedures,
+	.vs_count	= encoded_ds_counts,
+	.vs_xdrsize	= sizeof(union encoded_ds_xdrstore),
+	/*
+	 * A fixed port the layout carries in its body, so there is nothing to
+	 * register with rpcbind and nothing to advertise.
+	 */
+	.vs_hidden	= true,
+	.vs_dispatch	= encoded_ds_dispatch,
+};
+
+static const struct svc_version *encoded_ds_versions[] = {
+	[ENCODED_DS_VERSION] = &encoded_ds_version,
+};
+
+/*
+ * Authenticate as nfsd does, via lockd's template: AUTH_NULL and AUTH_UNIX
+ * only, the NULL procedure always accepted (the liveness probe needs no client
+ * identity), and every other procedure resolved against nfsd's client list by
+ * svc_set_client() - which sets rq_client and denies a caller nfsd does not
+ * know. That is the same list the exports use, because the program shares
+ * nfsd's authentication class ("nfsd" below), exactly as lockd does. It is what
+ * nfsd_open() then needs to find the right export.
+ */
+static enum svc_auth_status
+encoded_ds_authenticate(struct svc_rqst *rqstp)
+{
+	switch (rqstp->rq_authop->flavour) {
+	case RPC_AUTH_NULL:
+	case RPC_AUTH_UNIX:
+		rqstp->rq_auth_stat = rpc_auth_ok;
+		if (rqstp->rq_proc == 0)
+			return SVC_OK;
+		return svc_set_client(rqstp);
+	default:
+		rqstp->rq_auth_stat = rpc_autherr_badcred;
+		return SVC_DENIED;
+	}
+}
+
+static struct svc_program encoded_ds_program = {
+	.pg_prog		= ENCODED_DS_PROGRAM,
+	.pg_nvers		= ARRAY_SIZE(encoded_ds_versions),
+	.pg_vers		= encoded_ds_versions,
+	.pg_name		= "encoded_ds",
+	/* Share authentication with nfsd, as lockd does. */
+	.pg_class		= "nfsd",
+	.pg_authenticate	= encoded_ds_authenticate,
+	.pg_init_request	= svc_generic_init_request,
+	.pg_rpcbind_set		= svc_generic_rpcbind_set,
+};
+
+/* ----------------------------------------------------------------- thread -- */
+
+static int
+encoded_ds_thread(void *data)
+{
+	struct svc_rqst *rqstp = data;
+
+	/*
+	 * A kthread inherits init's fs_struct, whose root is not necessarily
+	 * where the export paths resolve from; nfsd unshares for the same
+	 * reason. svc_set_num_threads() waits for this status, so it is not
+	 * optional.
+	 */
+	svc_thread_init_status(rqstp, unshare_fs_struct());
+
+	set_freezable();
+	while (!svc_thread_should_stop(rqstp))
+		svc_recv(rqstp);
+
+	svc_exit_thread(rqstp);
+	return 0;
+}
+
+/* ------------------------------------------------------------- lifecycle -- */
+
+unsigned short encoded_ds_get_port(void)
+{
+	return encoded_ds_bound_port;
+}
+
+static void encoded_ds_debugfs_init(void)
+{
+	encoded_ds_debugfs = debugfs_create_dir("encoded_ds", NULL);
+	if (IS_ERR_OR_NULL(encoded_ds_debugfs))
+		return;
+
+	debugfs_create_atomic_t("probe", 0444, encoded_ds_debugfs, &ds_nr_probe);
+	debugfs_create_atomic_t("read", 0444, encoded_ds_debugfs, &ds_nr_read);
+	debugfs_create_atomic_t("write", 0444, encoded_ds_debugfs, &ds_nr_write);
+	debugfs_create_atomic_t("write_unstable", 0444, encoded_ds_debugfs,
+				&ds_nr_write_unstable);
+	debugfs_create_u64("read_ns", 0444, encoded_ds_debugfs, &ds_read_ns);
+	debugfs_create_u64("write_ns", 0444, encoded_ds_debugfs, &ds_write_ns);
+	debugfs_create_atomic_t("inflight", 0444, encoded_ds_debugfs,
+				&ds_inflight);
+	debugfs_create_atomic_t("inflight_max", 0444, encoded_ds_debugfs,
+				&ds_inflight_max);
+	debugfs_create_atomic_t("write_file_sync", 0444, encoded_ds_debugfs,
+				&ds_nr_write_file_sync);
+	debugfs_create_atomic_t("not_encoded", 0444, encoded_ds_debugfs,
+				&ds_nr_not_encoded);
+	debugfs_create_atomic_t("codec_unknown", 0444, encoded_ds_debugfs,
+				&ds_nr_codec_unknown);
+	debugfs_create_atomic_t("errors", 0444, encoded_ds_debugfs,
+				&ds_nr_errors);
+}
+
+/*
+ * Called from nfsd's pNFS init/exit, which is serialized with module load, so
+ * one service at a time; the mutex is for the module path where nfsd's own
+ * locking is not held.
+ */
+static DEFINE_MUTEX(encoded_ds_mutex);
+
+int encoded_ds_start(void)
+{
+	struct svc_serv *serv;
+	int ret;
+
+	mutex_lock(&encoded_ds_mutex);
+	if (encoded_ds_serv) {
+		mutex_unlock(&encoded_ds_mutex);
+		return 0;
+	}
+
+	serv = svc_create(&encoded_ds_program, ENCODED_DS_BUFSIZE,
+			  encoded_ds_thread);
+	if (!serv) {
+		mutex_unlock(&encoded_ds_mutex);
+		return -ENOMEM;
+	}
+
+	/* Listener first: svc_set_num_threads() can then fail cleanly. */
+	ret = svc_xprt_create(serv, "tcp", &init_net, AF_INET, encoded_ds_port,
+			      SVC_SOCK_ANONYMOUS, current_cred());
+	if (ret < 0)
+		goto out_destroy;
+
+	encoded_ds_bound_port = ret;
+
+#if IS_ENABLED(CONFIG_IPV6)
+	/*
+	 * The address the client gets in the layout is the one it reached the
+	 * MDS at, which may be IPv6 even when the MDS also has an IPv4
+	 * address; listen on both. Best effort: an IPv4-only host still works.
+	 */
+	ret = svc_xprt_create(serv, "tcp", &init_net, AF_INET6,
+			      encoded_ds_bound_port, SVC_SOCK_ANONYMOUS,
+			      current_cred());
+	if (ret < 0)
+		pr_info("encoded_ds: no IPv6 listener (%d)\n", ret);
+#endif
+
+	ret = svc_set_num_threads(serv, 0, encoded_ds_nthreads);
+	if (ret < 0) {
+		svc_xprt_destroy_all(serv, &init_net, true);
+		goto out_destroy;
+	}
+
+	encoded_ds_serv = serv;
+	mutex_unlock(&encoded_ds_mutex);
+
+	encoded_ds_debugfs_init();
+	pr_info("encoded_ds: listening on port %u with %u threads\n",
+		encoded_ds_bound_port, encoded_ds_nthreads);
+	return 0;
+
+out_destroy:
+	svc_destroy(&serv);
+	mutex_unlock(&encoded_ds_mutex);
+	return ret;
+}
+
+void encoded_ds_stop(void)
+{
+	mutex_lock(&encoded_ds_mutex);
+	if (encoded_ds_serv) {
+		svc_set_num_threads(encoded_ds_serv, 0, 0);
+		svc_xprt_destroy_all(encoded_ds_serv, &init_net, true);
+		svc_destroy(&encoded_ds_serv);
+		encoded_ds_bound_port = 0;
+	}
+	mutex_unlock(&encoded_ds_mutex);
+
+	debugfs_remove_recursive(encoded_ds_debugfs);
+	encoded_ds_debugfs = NULL;
+}
