diff --git a/fs/nfs/bcachefs_ds.c b/fs/nfs/bcachefs_ds.c
new file mode 100644
index 000000000..05d0d3c2e
--- /dev/null
+++ b/fs/nfs/bcachefs_ds.c
@@ -0,0 +1,721 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The client side of the encoded-extent data service.
+ *
+ * The layout body says where the data service is and how to name the file to
+ * it; this is the transport that asks it questions. It is deliberately the
+ * smallest RPC client that works: one rpc_clnt per mount, created lazily from
+ * the first layout's address, speaking the wire in
+ * linux/encoded_extent_ds.h, with no callback channel and no rpcbind (the
+ * port came in the layout).
+ *
+ * A failed call comes back as a negative errno - -ENODATA for "not stored
+ * encoded" - and the caller falls back to ordinary NFS I/O, which is always
+ * correct. There is no probe anywhere in this client: reading is the question,
+ * and -ENODATA is the answer.
+ */
+
+#include <linux/sunrpc/clnt.h>
+#include <linux/sunrpc/addr.h>
+#include <linux/vmalloc.h>
+#include <linux/encoded_extent.h>
+#include <linux/encoded_extent_ds.h>
+#include <linux/nfs_fs.h>
+
+#include "nfs4_fs.h"
+#include "pnfs.h"
+#include "internal.h"
+#include "bcachefs_ds.h"
+
+/* ------------------------------------------------------------ the program -- */
+
+struct bc_ds_read_args {
+	const struct bc_layout	*bl;
+	u64			offset;
+	u32			buf_size;
+	/* The caller's payload buffer, as pages: see bc_ds_enc_read(). */
+	struct page		**pages;
+};
+
+struct bc_ds_write_args {
+	const struct bc_layout	*bl;
+	u64			offset;
+	struct encoded_extent_desc desc;
+	/* Position of the codec in the layout's list, what the wire carries. */
+	u32			codec;
+	/* How durable this unit has to be; NFS's levels, see the wire header. */
+	u32			stable;
+	struct page		**pages;
+	u32			payload_len;
+};
+
+struct bc_ds_write_reply {
+	s32			status;
+	/* What the service reached, and the verifier a later commit must match. */
+	u32			committed;
+	u8			verf[ENCODED_DS_WRITEVERF];
+};
+
+struct bc_ds_read_reply {
+	s32			status;
+	struct encoded_extent_desc desc;
+	u32			codec;
+	/*
+	 * Where the encoded payload lands - the caller's buffer, which the
+	 * reply was received straight into - and what it can take. @payload_len
+	 * is what the reply announced.
+	 */
+	void			*payload;
+	size_t			capacity;
+	size_t			payload_len;
+};
+
+/*
+ * Argument and reply sizes in XDR words - all of these are words, including
+ * rpc_prepare_reply_pages()'s hdrsize, which is shifted into bytes inside. The
+ * address is one opaque, and the reply is a status, a descriptor, and - for
+ * READ - a payload that does not go through the reply buffer at all.
+ * BC_DS_READ_HEAD_WORDS is both what call_allocate() sizes that buffer from
+ * (p_replen) and what the receive is told is in front of the pages, so the two
+ * have to be the same number or the payload lands in the wrong place.
+ */
+#define BC_DS_ADDR_WORDS	(1 + XDR_QUADLEN(ENCODED_DS_MAX_FH))
+#define BC_DS_READ_HEAD_WORDS	(1 + 8 + 1)
+
+static void
+bc_ds_encode_addr(struct xdr_stream *xdr, const struct bc_layout *bl)
+{
+	xdr_stream_encode_opaque(xdr, bl->fh, bl->fh_len);
+}
+
+static void
+bc_ds_encode_desc(struct xdr_stream *xdr, const struct encoded_extent_desc *desc,
+		  u32 codec)
+{
+	xdr_stream_encode_u64(xdr, desc->unit_offset);
+	xdr_stream_encode_u64(xdr, desc->unit_len);
+	xdr_stream_encode_u64(xdr, desc->unencoded_offset);
+	xdr_stream_encode_u32(xdr, codec);
+	xdr_stream_encode_u32(xdr, desc->encrypted ? 1 : 0);
+}
+
+static int
+bc_ds_decode_desc(struct xdr_stream *xdr, struct encoded_extent_desc *desc,
+		  u32 *codec)
+{
+	u32 encrypted;
+
+	if (xdr_stream_decode_u64(xdr, &desc->unit_offset) < 0)
+		return -EIO;
+	if (xdr_stream_decode_u64(xdr, &desc->unit_len) < 0)
+		return -EIO;
+	if (xdr_stream_decode_u64(xdr, &desc->unencoded_offset) < 0)
+		return -EIO;
+	if (xdr_stream_decode_u32(xdr, codec) < 0)
+		return -EIO;
+	if (xdr_stream_decode_u32(xdr, &encrypted) < 0)
+		return -EIO;
+	desc->encrypted = encrypted != 0;
+	return 0;
+}
+
+static void
+bc_ds_enc_write(struct rpc_rqst *req, struct xdr_stream *xdr, const void *data)
+{
+	const struct bc_ds_write_args *args = data;
+
+	bc_ds_encode_addr(xdr, args->bl);
+	xdr_stream_encode_u64(xdr, args->offset);
+	bc_ds_encode_desc(xdr, &args->desc, args->codec);
+	xdr_stream_encode_u32(xdr, args->stable);
+	/*
+	 * The payload is a whole encoded unit, which does not fit in the
+	 * request head, so it goes in pages: the same shape as an NFSv3 WRITE
+	 * argument (length, then the pages).
+	 */
+	if (xdr_stream_encode_u32(xdr, args->payload_len) != XDR_UNIT)
+		return;
+	xdr_write_pages(xdr, args->pages, 0, args->payload_len);
+}
+
+static int
+bc_ds_dec_write(struct rpc_rqst *req, struct xdr_stream *xdr, void *data)
+{
+	struct bc_ds_write_reply *reply = data;
+	u32 status;
+
+	if (xdr_stream_decode_u32(xdr, &status) < 0)
+		return -EIO;
+	if (xdr_stream_decode_u32(xdr, &reply->committed) < 0)
+		return -EIO;
+	if (xdr_stream_decode_opaque_fixed(xdr, reply->verf,
+					   ENCODED_DS_WRITEVERF) < 0)
+		return -EIO;
+	reply->status = (s32)status;
+	return 0;
+}
+
+static void
+bc_ds_enc_read(struct rpc_rqst *req, struct xdr_stream *xdr, const void *data)
+{
+	const struct bc_ds_read_args *args = data;
+
+	bc_ds_encode_addr(xdr, args->bl);
+	xdr_stream_encode_u64(xdr, args->offset);
+	xdr_stream_encode_u32(xdr, args->buf_size);
+	/*
+	 * A whole encoded unit is more than a reply head's buffer will hold, and
+	 * the unit may be up to the wire's 2 MiB, so the receive goes straight
+	 * into the caller's pages - the same shape as an NFS READ reply, and the
+	 * reason p_replen covers only the head. @buf_size is both what the
+	 * service is asked for and what those pages can take.
+	 */
+	rpc_prepare_reply_pages(req, args->pages, 0, args->buf_size,
+				BC_DS_READ_HEAD_WORDS);
+}
+
+static int
+bc_ds_dec_read(struct rpc_rqst *req, struct xdr_stream *xdr, void *data)
+{
+	struct bc_ds_read_reply *reply = data;
+	u32 status, len;
+
+	if (xdr_stream_decode_u32(xdr, &status) < 0)
+		return -EIO;
+	if (bc_ds_decode_desc(xdr, &reply->desc, &reply->codec) < 0)
+		return -EIO;
+	reply->status = (s32)status;
+
+	if (reply->status)
+		return 0;
+
+	/*
+	 * The payload is already in the caller's buffer - the reply's pages are
+	 * its pages - so there is nothing to copy out, and what is left is to
+	 * check the length the head announced: against the buffer those pages
+	 * are, and against the reply that actually arrived, since the pages were
+	 * attached for the whole buffer and a short reply would otherwise be
+	 * read as if the bytes after it were data.
+	 */
+	if (xdr_stream_decode_u32(xdr, &len) < 0)
+		return -EIO;
+	if (len > reply->capacity)
+		return -E2BIG;
+	if (xdr_stream_pos(xdr) + len > xdr->buf->len)
+		return -EIO;
+
+	reply->payload_len = len;
+	return 0;
+}
+
+static const struct rpc_procinfo bc_ds_procs[] = {
+	[ENCODED_DS_WRITE] = {
+		.p_proc		= ENCODED_DS_WRITE,
+		.p_encode	= bc_ds_enc_write,
+		.p_decode	= bc_ds_dec_write,
+		.p_arglen	= BC_DS_ADDR_WORDS + 13,
+		.p_replen	= 2 + ENCODED_DS_WRITEVERF / XDR_UNIT,
+		.p_statidx	= ENCODED_DS_WRITE,
+		.p_name		= "WRITE",
+	},
+	[ENCODED_DS_READ] = {
+		.p_proc		= ENCODED_DS_READ,
+		.p_encode	= bc_ds_enc_read,
+		.p_decode	= bc_ds_dec_read,
+		.p_arglen	= BC_DS_ADDR_WORDS + 4,
+		.p_replen	= BC_DS_READ_HEAD_WORDS,
+		.p_statidx	= ENCODED_DS_READ,
+		.p_name		= "READ",
+	},
+	[ENCODED_DS_NULL] = {
+		.p_proc		= ENCODED_DS_NULL,
+		.p_statidx	= ENCODED_DS_NULL,
+		.p_name		= "NULL",
+	},
+	/*
+	 * PROBE exists for the userspace client (dsprobe.c) and for the service's
+	 * own checks: it asks whether a range would be served encoded, which is a
+	 * question the kernel client never has to ask - it just reads, and takes
+	 * -ENODATA for an answer. The slot stays because the table is indexed by
+	 * procedure number, with nothing in it to encode or decode.
+	 */
+	[ENCODED_DS_PROBE] = {
+		.p_proc		= ENCODED_DS_PROBE,
+		.p_statidx	= ENCODED_DS_PROBE,
+		.p_name		= "PROBE",
+	},
+};
+
+/*
+ * call_start() bumps version->counts[idx] and cl_stats->rpccnt on every call,
+ * without checking either for NULL, so both have to exist.
+ */
+static unsigned int bc_ds_counts[ENCODED_DS_NR_PROCS];
+
+static const struct rpc_version bc_ds_version = {
+	.number		= ENCODED_DS_VERSION,
+	.nrprocs	= ARRAY_SIZE(bc_ds_procs),
+	.procs		= bc_ds_procs,
+	.counts		= bc_ds_counts,
+};
+
+static const struct rpc_version *bc_ds_versions[] = {
+	[ENCODED_DS_VERSION] = &bc_ds_version,
+};
+
+static struct rpc_stat bc_ds_stats;
+
+static const struct rpc_program bc_ds_program = {
+	.name		= "encoded_ds",
+	.number		= ENCODED_DS_PROGRAM,
+	.nrvers		= ARRAY_SIZE(bc_ds_versions),
+	.version	= bc_ds_versions,
+	.stats		= &bc_ds_stats,
+};
+
+/* ------------------------------------------------------------- the client -- */
+
+struct bc_clnt_free {
+	struct work_struct	work;
+	struct rpc_clnt		*clnt;
+};
+
+static void bc_clnt_free_work(struct work_struct *work)
+{
+	struct bc_clnt_free *f = container_of(work, struct bc_clnt_free, work);
+
+	rpc_shutdown_client(f->clnt);
+	kfree(f);
+}
+
+/*
+ * RPC tasks do not hold a reference on their client, and rpc_shutdown_client()
+ * only drops the caller's, so a client has to be handed to this work item while
+ * the caller's reference is still held: the tasks in flight hold their own
+ * (bc_ds_clnt_get()) and the shutdown waits for them before the client is freed.
+ *
+ * The allocation is atomic because one caller, bc_free_layout_hdr(), runs under
+ * the inode lock; an allocation that fails leaks the client rather than freeing
+ * it from a context that cannot sleep, which is the right way round.
+ */
+void bc_ds_clnt_shutdown_async(struct rpc_clnt *clnt)
+{
+	struct bc_clnt_free *f = kmalloc(sizeof(*f), GFP_ATOMIC);
+
+	if (!f)
+		return;
+
+	INIT_WORK(&f->work, bc_clnt_free_work);
+	f->clnt = clnt;
+	schedule_work(&f->work);
+}
+
+/*
+ * Condemn the header's client so the next request builds a new one, which is a
+ * new connection.
+ *
+ * A soft RPC timeout gives up on the call without forcing the transport down
+ * (rpc_check_timeout(), net/sunrpc/clnt.c), and this driver keeps one client
+ * per layout header for as long as the layout lives. So a connection that goes
+ * away without a reset being seen - which is what a service restart, or any
+ * half-open TCP connection, leaves behind - costs one timeout for every unit
+ * for the rest of the layout's life: nothing ever reconnects, because sunrpc
+ * still believes the transport is connected, and the layout never recovers.
+ * That is the "the service answers, but this mount has stopped reading through
+ * it" state the perf section documents.
+ *
+ * Dropping the client here costs the timeouts already paid and nothing else:
+ * bc_ds_mark_down() sets a window when it calls this, so no new request uses
+ * the service until the window has passed, and the request that failed has
+ * already been given back to the MDS.
+ *
+ * This is reached from an RPC completion, so the client goes to a work item
+ * rather than being shut down here - see bc_ds_clnt_shutdown_async().
+ */
+void bc_ds_clnt_drop(struct bc_layout_hdr *blh)
+{
+	struct rpc_clnt *clnt;
+
+	mutex_lock(&blh->clnt_mutex);
+	clnt = blh->clnt;
+	blh->clnt = NULL;
+	mutex_unlock(&blh->clnt_mutex);
+
+	if (clnt)
+		bc_ds_clnt_shutdown_async(clnt);
+}
+
+static struct rpc_clnt *
+bc_ds_clnt_get(struct bc_layout_hdr *blh, const struct bc_layout *bl)
+{
+	struct nfs_client *clp = NFS_SERVER(blh->plh.plh_inode)->nfs_client;
+	struct rpc_create_args args = { };
+	struct sockaddr_storage ss;
+	struct rpc_timeout timeout = {
+		.to_initval	= 15 * HZ,
+		.to_maxval	= 15 * HZ,
+		.to_retries	= 1,
+	};
+	struct rpc_clnt *clnt;
+	int salen;
+
+	mutex_lock(&blh->clnt_mutex);
+	clnt = blh->clnt;
+	if (clnt)
+		goto out;
+
+	/*
+	 * A client is not built for a service that is inside the down window:
+	 * the request that got here was already in flight when the timeout
+	 * happened, and the answer for it is the MDS. The window is what makes
+	 * the recovery bounded - one client, and one connection, per timeout;
+	 * the caller sees this as the error it would have seen 15s later.
+	 */
+	if (bc_ds_is_down(blh)) {
+		clnt = ERR_PTR(-ETIMEDOUT);
+		goto out;
+	}
+
+	salen = rpc_pton(&init_net, bl->addr, bl->addr_len,
+			 (struct sockaddr *)&ss, sizeof(ss));
+	if (!salen) {
+		clnt = ERR_PTR(-EINVAL);
+		goto out;
+	}
+	switch (ss.ss_family) {
+	case AF_INET:
+		((struct sockaddr_in *)&ss)->sin_port = htons(bl->port);
+		break;
+#if IS_ENABLED(CONFIG_IPV6)
+	case AF_INET6:
+		((struct sockaddr_in6 *)&ss)->sin6_port = htons(bl->port);
+		break;
+#endif
+	default:
+		clnt = ERR_PTR(-EAFNOSUPPORT);
+		goto out;
+	}
+
+	args.net	= clp->cl_net;
+	args.protocol	= IPPROTO_TCP;
+	args.address	= (struct sockaddr *)&ss;
+	args.addrsize	= salen;
+	args.timeout	= &timeout;
+	args.servername	= "encoded_ds";
+	args.nodename	= clp->cl_rpcclient->cl_nodename;
+	args.program	= &bc_ds_program;
+	args.version	= ENCODED_DS_VERSION;
+	/*
+	 * Authenticate as the mount does, not anonymously. The data service runs
+	 * nfsd's own access checks, so it has to see the same principal the MDS
+	 * does; AUTH_NULL makes every request anonymous and is refused outright
+	 * by any export with an explicit sec=. The layout is only offered for
+	 * AUTH_UNIX mounts, so this is the mount's AUTH_UNIX credential. (GSS is
+	 * a separate piece of work - see doc/security.md in the product tree.)
+	 */
+	args.authflavor	= clp->cl_rpcclient->cl_auth->au_flavor;
+	args.cred	= clp->cl_rpcclient->cl_cred;
+	args.flags	= RPC_CLNT_CREATE_NOPING;
+
+	clnt = rpc_create(&args);
+	if (IS_ERR(clnt))
+		goto out;
+	blh->clnt = clnt;
+out:
+	/*
+	 * The reference returned here is the call's, not the header's, and it is
+	 * taken under the mutex that bc_ds_clnt_drop() clears the header's under.
+	 * That way a call cannot be set up on a client that has just been
+	 * condemned, and the client cannot be freed - by a drop, or by the layout
+	 * going away - while the call is being built or while its reply is still
+	 * arriving. The completion releases it: rpc_release_client() in
+	 * ->rpc_release.
+	 */
+	if (!IS_ERR(clnt))
+		rpc_hold_client(clnt);
+	mutex_unlock(&blh->clnt_mutex);
+	return clnt;
+}
+
+/* --------------------------------------------------------- asynchronous -- */
+
+struct bc_ds_read_call {
+	struct rpc_message	msg;
+	struct bc_ds_read_args	args;
+	struct bc_ds_read_reply	reply;
+	/* The reply's pages, freed in ->rpc_release. */
+	struct page		**pages;
+	unsigned int		npages;
+	/* The call's reference on the client; released in ->rpc_release. */
+	struct rpc_clnt		*clnt;
+	bc_ds_done_fn		done;
+	void			*ctx;
+};
+
+/*
+ * The pages of a buffer a reply is received into. rpc_prepare_reply_pages()
+ * takes pages, not an address, which is why the buffer has to start on a page
+ * boundary: payload byte 0 lands at offset 0 of the first page.
+ *
+ * kvmalloc() may have returned either allocator's memory and their page lookups
+ * differ. A page that cannot be found means the buffer is not what the caller
+ * thinks it is, so the call is refused rather than received into.
+ */
+static struct page **bc_ds_reply_pages(void *buf, size_t size,
+				       unsigned int *nr_pages)
+{
+	unsigned int i, n = DIV_ROUND_UP(size, PAGE_SIZE);
+	struct page **pages;
+
+	pages = kvmalloc_array(n, sizeof(*pages), GFP_NOFS);
+	if (!pages)
+		return NULL;
+
+	for (i = 0; i < n; i++) {
+		void *p = buf + i * PAGE_SIZE;
+
+		pages[i] = is_vmalloc_addr(p) ? vmalloc_to_page(p)
+					      : virt_to_page(p);
+		if (!pages[i]) {
+			kvfree(pages);
+			return NULL;
+		}
+	}
+
+	*nr_pages = n;
+	return pages;
+}
+
+static void
+bc_ds_read_call_done(struct rpc_task *task, void *calldata)
+{
+	struct bc_ds_read_call *call = calldata;
+	int status = task->tk_status;
+
+	if (!status && call->reply.status)
+		status = call->reply.status;
+	if (!status && !call->reply.payload_len)
+		status = -EIO;
+	/*
+	 * A soft RPC task that runs out of retransmits reports -EIO with
+	 * -ETIMEDOUT as its RPC status (net/sunrpc/clnt.c, rpc_check_timeout()).
+	 * The layout layer decides whether to keep using the service from this
+	 * one value, so the timeout has to survive the trip up: see
+	 * bc_ds_mark_down().
+	 */
+	if (task->tk_rpc_status == -ETIMEDOUT)
+		status = -ETIMEDOUT;
+
+	call->done(call->ctx, status, call->reply.codec, &call->reply.desc,
+		   call->reply.payload, call->reply.payload_len);
+}
+
+static void
+bc_ds_read_call_release(void *calldata)
+{
+	struct bc_ds_read_call *call = calldata;
+
+	kvfree(call->pages);
+	rpc_release_client(call->clnt);
+	kfree(call);
+}
+
+static const struct rpc_call_ops bc_ds_read_call_ops = {
+	.rpc_call_done	= bc_ds_read_call_done,
+	.rpc_release	= bc_ds_read_call_release,
+};
+
+int
+bc_ds_read_async(struct bc_layout_hdr *blh, const struct bc_layout *bl,
+		 u64 offset, void *payload, size_t capacity,
+		 bc_ds_done_fn done, void *ctx)
+{
+	struct bc_ds_read_call *call;
+	struct rpc_clnt *clnt;
+	int ret;
+
+	call = kzalloc(sizeof(*call), GFP_NOFS);
+	if (!call)
+		return -ENOMEM;
+
+	clnt = bc_ds_clnt_get(blh, bl);
+	if (IS_ERR(clnt)) {
+		ret = PTR_ERR(clnt);
+		kfree(call);
+		return ret;
+	}
+
+	/*
+	 * The reply is received into the caller's own buffer: hand its pages to
+	 * the reply instead of letting the payload go through the reply head's
+	 * buffer, which is what bounds a unit by the wire rather than by that
+	 * buffer's size. Nothing is copied, in either direction.
+	 */
+	call->pages = bc_ds_reply_pages(payload, capacity, &call->npages);
+	if (!call->pages) {
+		rpc_release_client(clnt);
+		kfree(call);
+		return -ENOMEM;
+	}
+
+	call->args.bl		= bl;
+	call->args.offset	= offset;
+	call->args.buf_size	= capacity;
+	call->args.pages	= call->pages;
+	call->reply.payload	= payload;
+	call->reply.capacity	= capacity;
+	call->clnt		= clnt;
+	call->done		= done;
+	call->ctx		= ctx;
+	call->msg.rpc_proc	= &clnt->cl_procinfo[ENCODED_DS_READ];
+	call->msg.rpc_argp	= &call->args;
+	call->msg.rpc_resp	= &call->reply;
+
+	/*
+	 * A call that could not be started - no memory for the task, or a client
+	 * rpc_run_task() refuses outright - has to be reported, because nothing
+	 * else will ever run: the completion is what carries the status, and a
+	 * call that has no task has no completion. Returning here is what turns
+	 * that into the fallback the caller already knows how to do.
+	 */
+	ret = rpc_call_async(clnt, &call->msg, RPC_TASK_SOFT,
+			     &bc_ds_read_call_ops, call);
+	if (ret) {
+		kvfree(call->pages);
+		rpc_release_client(clnt);
+		kfree(call);
+	}
+	return ret;
+}
+
+struct bc_ds_write_call {
+	struct rpc_message	msg;
+	struct bc_ds_write_args	args;
+	struct bc_ds_write_reply reply;
+	struct page		**pages;
+	unsigned int		npages;
+	/* The call's reference on the client; released in ->rpc_release. */
+	struct rpc_clnt		*clnt;
+	void			(*done)(void *ctx, int status, u32 committed,
+					const u8 *verf);
+	void			*ctx;
+};
+
+static void
+bc_ds_write_call_done(struct rpc_task *task, void *calldata)
+{
+	struct bc_ds_write_call *call = calldata;
+	int status = task->tk_status;
+
+	if (!status && call->reply.status)
+		status = call->reply.status;
+	/* As on the read side: a timeout keeps its own name. */
+	if (task->tk_rpc_status == -ETIMEDOUT)
+		status = -ETIMEDOUT;
+
+	call->done(call->ctx, status, call->reply.committed, call->reply.verf);
+}
+
+static void
+bc_ds_write_call_release(void *calldata)
+{
+	struct bc_ds_write_call *call = calldata;
+	unsigned int i;
+
+	for (i = 0; i < call->npages; i++)
+		__free_page(call->pages[i]);
+	kfree(call->pages);
+	rpc_release_client(call->clnt);
+	kfree(call);
+}
+
+static const struct rpc_call_ops bc_ds_write_call_ops = {
+	.rpc_call_done	= bc_ds_write_call_done,
+	.rpc_release	= bc_ds_write_call_release,
+};
+
+int
+bc_ds_write_async(struct bc_layout_hdr *blh, const struct bc_layout *bl,
+		  u64 offset, const void *payload, size_t payload_len,
+		  const struct encoded_extent_desc *desc, u32 codec,
+		  u32 stable,
+		  void (*done)(void *ctx, int status, u32 committed,
+			       const u8 *verf),
+		  void *ctx)
+{
+	struct bc_ds_write_call *call;
+	struct rpc_clnt *clnt;
+	unsigned int i, allocated = 0;
+	size_t sent = 0;
+	int ret;
+
+	call = kzalloc(sizeof(*call), GFP_NOFS);
+	if (!call)
+		return -ENOMEM;
+
+	/*
+	 * The request head cannot carry a unit, so the payload goes in pages,
+	 * and they have to outlive the call: they are freed in ->rpc_release.
+	 */
+	call->npages = DIV_ROUND_UP(payload_len, PAGE_SIZE);
+	call->pages = kcalloc(call->npages, sizeof(*call->pages), GFP_NOFS);
+	if (!call->pages) {
+		kfree(call);
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < call->npages; i++) {
+		size_t n = min_t(size_t, payload_len - sent, PAGE_SIZE);
+		void *kaddr;
+
+		call->pages[i] = alloc_page(GFP_NOFS);
+		if (!call->pages[i]) {
+			ret = -ENOMEM;
+			goto out_free;
+		}
+		allocated++;
+		kaddr = kmap_local_page(call->pages[i]);
+		memcpy(kaddr, payload + sent, n);
+		kunmap_local(kaddr);
+		sent += n;
+	}
+
+	clnt = bc_ds_clnt_get(blh, bl);
+	if (IS_ERR(clnt)) {
+		ret = PTR_ERR(clnt);
+		goto out_free;
+	}
+
+	call->args.bl		= bl;
+	call->args.offset	= offset;
+	call->args.desc		= *desc;
+	call->args.codec	= codec;
+	call->args.stable	= stable;
+	call->args.payload_len	= payload_len;
+	call->args.pages	= call->pages;
+	call->clnt		= clnt;
+	call->done		= done;
+	call->ctx		= ctx;
+	call->msg.rpc_proc	= &clnt->cl_procinfo[ENCODED_DS_WRITE];
+	call->msg.rpc_argp	= &call->args;
+	call->msg.rpc_resp	= &call->reply;
+
+	/* As on the read side: a call that never started has no completion. */
+	ret = rpc_call_async(clnt, &call->msg, RPC_TASK_SOFT,
+			     &bc_ds_write_call_ops, call);
+	if (ret) {
+		for (i = 0; i < call->npages; i++)
+			__free_page(call->pages[i]);
+		kfree(call->pages);
+		rpc_release_client(clnt);
+		kfree(call);
+	}
+	return ret;
+
+out_free:
+	for (i = 0; i < allocated; i++)
+		__free_page(call->pages[i]);
+	kfree(call->pages);
+	kfree(call);
+	return ret;
+}
diff --git a/fs/nfs/bcachefs_ds.h b/fs/nfs/bcachefs_ds.h
new file mode 100644
index 000000000..76cd1808f
--- /dev/null
+++ b/fs/nfs/bcachefs_ds.h
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Shared state for the pNFS encoded-extent client: the layout driver
+ * (bcachefs_layout.c) and the data-service client (bcachefs_ds.c).
+ *
+ * The layout body carries where the data service is and how to name the file to
+ * it; everything the driver learns from the server lands here. The data service
+ * client hangs an rpc_clnt off the layout header, so one mount talks to one
+ * data service over one transport.
+ */
+#ifndef _NFS_BCACHEFS_DS_H
+#define _NFS_BCACHEFS_DS_H
+
+#include <linux/encoded_extent.h>
+#include <linux/encoded_extent_ds.h>
+#include <linux/nfs4.h>
+
+/*
+ * The layout body's version. It is checked rather than assumed, so a peer built
+ * against a different body shape falls back to MDS I/O instead of misparsing:
+ * bump it whenever what the body carries changes.
+ */
+#define BC_LAYOUT_VERSION	4
+
+#define BC_ADDR_MAX		64
+
+struct rpc_clnt;
+
+struct bc_layout_hdr {
+	struct pnfs_layout_hdr	plh;
+	struct mutex		clnt_mutex;
+	struct rpc_clnt		*clnt;
+	/*
+	 * When a call to the data service times out, the mount stays off it
+	 * until this time passes. A timeout costs the client 15-30s and a request
+	 * is one call per unit, so without this a service that goes away turns
+	 * every read into a string of timeouts instead of the fallback to the MDS
+	 * the design promises - which is what the failure-mode test found before
+	 * this existed. Only a timeout sets it: a refusal the service sent back
+	 * says the service is answering. See bc_ds_mark_down().
+	 */
+	unsigned long		ds_down_until;
+};
+
+/*
+ * What the layout body carried: where the data service is, and the file handle
+ * that names the file to it. The handle is the MDS's, and the service resolves
+ * it with nfsd's own verification, so the export comes from the handle and the
+ * presenting client rather than from anything the layout says. The block size,
+ * encoded extent ceiling and codec set come from the data service itself, so
+ * they cannot go stale against its own view - here they arrived in the layout,
+ * because the MDS is the data service.
+ */
+struct bc_layout {
+	struct pnfs_layout_segment lseg;
+
+	char			addr[BC_ADDR_MAX];
+	u32			addr_len;
+	u32			port;
+
+	u32			fh_len;
+	u8			fh[ENCODED_DS_MAX_FH];
+
+	/*
+	 * The encoded extent ceiling and alignment the server's filesystem
+	 * applies, per inode, so they belong to the segment rather than the
+	 * mount.
+	 */
+	u32			unit_max;
+	u32			unit_align;
+
+	/*
+	 * The codecs the export may serve this file with, resolved from the
+	 * names the layout carried. A descriptor names a codec by position in
+	 * this list, so a position with no resolution is a range this client
+	 * cannot decode and does not serve encoded. @write_codec is the one the
+	 * client compresses with - the first it can encode, since which codec
+	 * to write with is the client's choice as long as the data service
+	 * accepts it.
+	 */
+	const struct encoded_extent_codec *codec[ENCODED_DS_MAX_CODECS];
+	u32			nr_codecs;
+	u32			write_codec;
+
+	/*
+	 * The names as the layout carried them, next to the resolutions above.
+	 * Nothing on the data path reads these - they are what the server said
+	 * it may serve the file with, which is the only place that is visible,
+	 * and the tests check which filesystem's codecs a file was offered.
+	 */
+	char			codec_name[ENCODED_DS_MAX_CODECS]
+					[ENCODED_DS_MAX_CODEC_NAME + 1];
+};
+
+typedef void (*bc_ds_done_fn)(void *ctx, int status, u32 codec,
+			      const struct encoded_extent_desc *desc,
+			      void *payload, size_t payload_len);
+
+/*
+ * Whether the service is inside the window a timeout set. Single requests check
+ * this before they start one (bc_read_pagelist(), bc_write_pagelist()), and so
+ * does bc_ds_clnt_get(): a request that reaches the client with the window set
+ * is one that was already in flight when the timeout happened, and paying
+ * another timeout for it - or opening another connection to a service that is
+ * not answering - is what the window exists to avoid.
+ */
+bool bc_ds_is_down(struct bc_layout_hdr *blh);
+
+/*
+ * Release the header's reference on its data-service client, from a work item:
+ * rpc_shutdown_client() sleeps, and it has to see the caller's own RPC task
+ * finish, so it can never be called from inside one. Used both when the header
+ * goes away (bc_free_layout_hdr()) and when a client is condemned
+ * (bc_ds_clnt_drop()).
+ */
+void bc_ds_clnt_shutdown_async(struct rpc_clnt *clnt);
+
+/*
+ * Throw away the header's data-service client, so that the next request builds
+ * a new one. Called when a call times out: see the comment on the definition
+ * for why the client is what has to go, and why this is safe to call from an
+ * RPC completion.
+ */
+void bc_ds_clnt_drop(struct bc_layout_hdr *blh);
+
+/*
+ * Fetch the encoded unit covering @offset into @payload (capacity @capacity),
+ * asynchronously; @done runs in the RPC task context with the unit's descriptor,
+ * the position of its codec in the layout's list, and the payload, and the
+ * caller owns the buffer throughout. A negative status is the data service's own
+ * errno (-ENODATA meaning "not stored encoded"), or the transport's.
+ *
+ * The payload is received straight into @payload: its pages are what the reply
+ * is received into (rpc_prepare_reply_pages(), the way an NFS READ reply lands
+ * in the pages it is reading into), so a unit is bounded by ENCODED_DS_MAX_PAYLOAD
+ * and by what the caller allocated, not by the size of a reply head's buffer,
+ * and nothing is copied on the way. Two things follow for the caller:
+ *
+ *   - @payload must start on a page boundary, because byte 0 of the payload is
+ *     received at offset 0 of the first page;
+ *   - @capacity is both what the service is asked to send and the most this
+ *     buffer will take; the service clamps it to the unit its file has, so a
+ *     unit that does not fit is refused by the backend rather than truncated.
+ *
+ * Asynchronous because the data path has to be: a synchronous call inside
+ * read_pagelist serialises every unit behind a round trip, and nothing else in
+ * the pgio can proceed.
+ */
+int bc_ds_read_async(struct bc_layout_hdr *blh, const struct bc_layout *bl,
+		     u64 offset, void *payload, size_t capacity,
+		     bc_ds_done_fn done, void *ctx);
+
+/*
+ * Store one encoded unit, asynchronously; @codec is the position of the codec it
+ * was encoded with, @stable is how durable the caller needs it to be (see
+ * enum encoded_extent_stable), and @done gets the service's status together
+ * with the level it actually reached and its write verifier - the value a later
+ * commit of this unit will be checked against, which the caller must keep.
+ */
+int bc_ds_write_async(struct bc_layout_hdr *blh, const struct bc_layout *bl,
+		      u64 offset, const void *payload, size_t payload_len,
+		      const struct encoded_extent_desc *desc, u32 codec,
+		      u32 stable,
+		      void (*done)(void *ctx, int status, u32 committed,
+				   const u8 *verf),
+		      void *ctx);
+
+#endif /* _NFS_BCACHEFS_DS_H */
diff --git a/fs/nfs/bcachefs_layout.c b/fs/nfs/bcachefs_layout.c
new file mode 100644
index 000000000..ed61f77f2
--- /dev/null
+++ b/fs/nfs/bcachefs_layout.c
@@ -0,0 +1,1177 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * pNFS layout driver for bcachefs encoded extents: the client side.
+ *
+ * The layout type says: this file's data is served as bcachefs encoded extents
+ * by a data service, not as plaintext NFS READ/WRITE. Page cache, readahead,
+ * writeback, mmap, dcache revalidation, attribute coherence, locking and
+ * recovery are all stock NFS - the layout driver only owns the data path.
+ *
+ * Where the encoded data path goes, and what the surrounding contract is:
+ *
+ *   ->pg_read_ops / ->pg_write_ops
+ *		coalescing and alignment. A request that does not line up with
+ *		an encoded extent is reset to the MDS with
+ *		nfs_pageio_reset_read_mds()/write_mds(), which is exactly what
+ *		blocklayout does with unaligned requests, and is also the
+ *		fallback when the data service declines a range.
+ *
+ *   ->read_pagelist
+ *		the encoded read. hdr->args.pages/page_array are the pages to
+ *		fill and hdr->args.offset/count the range; the driver may do
+ *		arbitrary I/O from here - blocklayout issues bios - and
+ *		completes through pnfs_ld_read_done(). Returning
+ *		PNFS_NOT_ATTEMPTED sends the request through the MDS instead,
+ *		which is both this skeleton's behaviour and the correct
+ *		fallback for a hole, an inline or encrypted extent, or a
+ *		refused encoded put.
+ *
+ *   ->write_pagelist
+ *		the encoded write: compress the dirty pages client-side with the
+ *		codec the layout negotiated, send the encoded extent, complete
+ *		through pnfs_ld_write_done(). Same fallback.
+ *
+ * What that buys over a filesystem of our own: the hard parts of the client
+ * are NFS's, and the only new code is the data path - which is also the only
+ * part that is genuinely new.
+ */
+
+#include <linux/module.h>
+#include <linux/debugfs.h>
+#include <linux/jiffies.h>
+#include <linux/nfs_fs.h>
+#include <linux/nfs4.h>
+#include <linux/encoded_extent_ds.h>
+
+#include "nfs4_fs.h"
+#include "pnfs.h"
+#include "internal.h"
+#include "bcachefs_ds.h"
+
+/*
+ * Counters, in debugfs, of the points where this driver either steps in or
+ * declines to. A layout driver has no other user-visible surface: whether the
+ * client negotiated our layout type, whether the data path was reached and how
+ * often it fell back are otherwise only visible in dprintk output. Tests and
+ * bug reports both need them, and so does measuring the fallback rate in the
+ * field, which is the number that says whether the data path is earning its
+ * keep.
+ */
+static struct dentry *bc_debugfs_dir;
+static atomic_t bc_stat_lseg_alloc = ATOMIC_INIT(0);
+static atomic_t bc_stat_lseg_alloc_err = ATOMIC_INIT(0);
+static atomic_t bc_stat_read_pagelist = ATOMIC_INIT(0);
+static atomic_t bc_stat_write_pagelist = ATOMIC_INIT(0);
+static atomic_t bc_stat_unit_max = ATOMIC_INIT(0);
+static atomic_t bc_stat_unit_align = ATOMIC_INIT(0);
+static atomic_t bc_stat_layout_codecs = ATOMIC_INIT(0);
+static atomic_t bc_stat_codec_missing = ATOMIC_INIT(0);
+/* Provider modules asked for, in the core's counter, mirrored for the tests. */
+static atomic_t bc_stat_codec_requests = ATOMIC_INIT(0);
+static atomic_t bc_stat_write_codec = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_read_not_encoded = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_read_ok = ATOMIC_INIT(0);
+/* Negative: the failing call's errno. Positive: a decoded length mismatch. */
+static atomic_t bc_stat_ds_last_read_err = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_last_unit_len = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_last_payload_len = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_read_err = ATOMIC_INIT(0);
+/*
+ * Encoded bytes the service handed over, and the part of them the request had no
+ * use for. The service answers with the whole unit an offset falls in, so a
+ * request smaller than a unit asks for that unit again for every request inside
+ * it and throws the rest away - which is what the pgio sizing exists to stop,
+ * and what these two count. 64-bit and lock-guarded, like the service's own
+ * counters: these run to megabytes.
+ */
+static u64 bc_ds_read_bytes, bc_ds_read_wasted;
+static DEFINE_SPINLOCK(bc_read_bytes_lock);
+static atomic_t bc_stat_ds_write_ok = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_write_err = ATOMIC_INIT(0);
+/* Times the mount decided the service was not answering, and requests that then
+ * went straight to the MDS without paying a timeout first. */
+static atomic_t bc_stat_ds_down = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_down_skips = ATOMIC_INIT(0);
+
+/*
+ * How long to stay off a data service that is not answering. Long enough that
+ * the per-request fallback is the MDS rather than a timeout, short enough that
+ * the service coming back is noticed without anything having to tell us.
+ */
+#define BC_DS_DOWN_SECS		30
+
+/*
+ * Whether the service is inside the window bc_ds_mark_down() set. Single
+ * requests check this before they start one, and so does bc_ds_clnt_get():
+ * a request that arrives at the client while the window is set is one that was
+ * already in flight when the timeout happened, and the promise is that it goes
+ * to the MDS rather than paying a timeout the service has already been given.
+ */
+bool bc_ds_is_down(struct bc_layout_hdr *blh)
+{
+	return time_before(jiffies, READ_ONCE(blh->ds_down_until));
+}
+
+static void bc_ds_mark_down(struct bc_layout_hdr *blh, int status)
+{
+	/*
+	 * The window only exists to stop a request paying a timeout the service
+	 * has already been given. So it is a timeout, and nothing else: an
+	 * error the service sent back - a full filesystem, a stale handle, a
+	 * range it does not have - says the service is answering, and turning
+	 * those into thirty seconds of not using it would be wrong in both
+	 * directions. bc_ds_read_async() and bc_ds_write_async() report a
+	 * timeout as -ETIMEDOUT whatever the RPC layer's tk_status is.
+	 */
+	if (status != -ETIMEDOUT)
+		return;
+
+	if (time_before(jiffies, READ_ONCE(blh->ds_down_until)))
+		return;
+	WRITE_ONCE(blh->ds_down_until, jiffies + BC_DS_DOWN_SECS * HZ);
+	atomic_inc(&bc_stat_ds_down);
+	/*
+	 * The timeout also condemns the client that carried it, so the next
+	 * request after the window builds a new one - a new connection - rather
+	 * than paying this timeout again for the rest of the layout's life.
+	 * Nothing else reconnects: a soft RPC timeout gives up without forcing
+	 * the transport down. The window checked above is what keeps this to one
+	 * client per BC_DS_DOWN_SECS when a whole request's worth of calls times
+	 * out at once. See bc_ds_clnt_drop().
+	 */
+	bc_ds_clnt_drop(blh);
+}
+static atomic_t bc_stat_ds_last_write_err = ATOMIC_INIT(0);
+/*
+ * Durability, as seen from the client: how many writes asked to be durable
+ * (hdr->args.stable), how many replies said they were, and the last reply's
+ * level. The pair is what says the driver passes the request down and the
+ * answer back rather than asserting either.
+ */
+static atomic_t bc_stat_ds_write_stable = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_write_file_sync = ATOMIC_INIT(0);
+static atomic_t bc_stat_ds_last_committed = ATOMIC_INIT(0);
+static atomic_t bc_stat_sync = ATOMIC_INIT(0);
+
+/*
+ * The last layout's file handle, in debugfs, for tests. It otherwise only
+ * exists inside an lseg the kernel owns, and the refusal tests need a real
+ * handle to present to the data service - and to mutate, to show that a handle
+ * for a file outside the export is refused. Debug-only and read-only: nothing
+ * in the driver reads it back.
+ */
+static DEFINE_MUTEX(bc_fh_dump_lock);
+static u8 bc_fh_dump[ENCODED_DS_MAX_FH];
+static u32 bc_fh_dump_len;
+
+static void bc_fh_dump_update(const struct bc_layout *bl)
+{
+	mutex_lock(&bc_fh_dump_lock);
+	bc_fh_dump_len = min_t(u32, bl->fh_len, sizeof(bc_fh_dump));
+	memcpy(bc_fh_dump, bl->fh, bc_fh_dump_len);
+	mutex_unlock(&bc_fh_dump_lock);
+}
+
+static ssize_t bc_fh_dump_read(struct file *file, char __user *ubuf,
+			       size_t count, loff_t *ppos)
+{
+	size_t size = 3 * ENCODED_DS_MAX_FH + 64;
+	char *buf = kzalloc(size, GFP_KERNEL);
+	ssize_t len = 0;
+
+	if (!buf)
+		return -ENOMEM;
+
+	mutex_lock(&bc_fh_dump_lock);
+	len += scnprintf(buf + len, size - len, "fh_len %u\n", bc_fh_dump_len);
+	len += scnprintf(buf + len, size - len, "fh ");
+	bin2hex(buf + len, bc_fh_dump, bc_fh_dump_len);
+	len += 2 * bc_fh_dump_len;
+	len += scnprintf(buf + len, size - len, "\n");
+	mutex_unlock(&bc_fh_dump_lock);
+
+	len = simple_read_from_buffer(ubuf, count, ppos, buf, len);
+	kfree(buf);
+	return len;
+}
+
+static const struct file_operations bc_fh_dump_fops = {
+	.read		= bc_fh_dump_read,
+	.llseek		= default_llseek,
+};
+
+/*
+ * The codec names the last layout carried, in position order: the server's list
+ * for that file, which is a property of the filesystem it is on - two
+ * filesystems under one layout type name different codecs, and this is how a
+ * test tells which one a file was offered. A name this client could not
+ * resolve is still printed; the resolution is a separate question.
+ */
+static DEFINE_MUTEX(bc_codec_dump_lock);
+static char bc_codec_dump[ENCODED_DS_MAX_CODECS][ENCODED_DS_MAX_CODEC_NAME + 1];
+static u32 bc_codec_dump_nr;
+
+static void bc_codec_dump_update(const struct bc_layout *bl)
+{
+	u32 i;
+
+	mutex_lock(&bc_codec_dump_lock);
+	bc_codec_dump_nr = min_t(u32, bl->nr_codecs, ENCODED_DS_MAX_CODECS);
+	for (i = 0; i < bc_codec_dump_nr; i++)
+		strscpy(bc_codec_dump[i], bl->codec_name[i],
+			sizeof(bc_codec_dump[i]));
+	mutex_unlock(&bc_codec_dump_lock);
+}
+
+static ssize_t bc_codec_dump_read(struct file *file, char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	char *buf = kzalloc(ENCODED_DS_MAX_CODECS *
+			    (ENCODED_DS_MAX_CODEC_NAME + 16), GFP_KERNEL);
+	ssize_t len = 0;
+	u32 i;
+
+	if (!buf)
+		return -ENOMEM;
+
+	mutex_lock(&bc_codec_dump_lock);
+	for (i = 0; i < bc_codec_dump_nr; i++)
+		len += scnprintf(buf + len, ENCODED_DS_MAX_CODECS *
+				 (ENCODED_DS_MAX_CODEC_NAME + 16) - len,
+				 "%u %s\n", i, bc_codec_dump[i]);
+	mutex_unlock(&bc_codec_dump_lock);
+
+	len = simple_read_from_buffer(ubuf, count, ppos, buf, len);
+	kfree(buf);
+	return len;
+}
+
+static const struct file_operations bc_codec_dump_fops = {
+	.read		= bc_codec_dump_read,
+	.llseek		= default_llseek,
+};
+
+/*
+ * The last write reply's verifier, in debugfs, for tests. It is the value the
+ * client checks a later commit against, so it is the one piece of the reply a
+ * counter cannot show: a test asks whether it is there at all, and whether a
+ * server restart changed it, which is how the client learns that uncommitted
+ * data is gone.
+ */
+static DEFINE_MUTEX(bc_verf_dump_lock);
+static u8 bc_write_verf[ENCODED_DS_WRITEVERF];
+
+static void bc_write_verf_update(const u8 *verf)
+{
+	mutex_lock(&bc_verf_dump_lock);
+	memcpy(bc_write_verf, verf, ENCODED_DS_WRITEVERF);
+	mutex_unlock(&bc_verf_dump_lock);
+}
+
+static ssize_t bc_write_verf_read(struct file *file, char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	char buf[2 * ENCODED_DS_WRITEVERF + 8];
+	ssize_t len = 0;
+
+	mutex_lock(&bc_verf_dump_lock);
+	bin2hex(buf, bc_write_verf, ENCODED_DS_WRITEVERF);
+	mutex_unlock(&bc_verf_dump_lock);
+	len = 2 * ENCODED_DS_WRITEVERF;
+	len += scnprintf(buf + len, sizeof(buf) - len, "\n");
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static const struct file_operations bc_write_verf_fops = {
+	.read		= bc_write_verf_read,
+	.llseek		= default_llseek,
+};
+
+static struct pnfs_layout_hdr *
+bc_alloc_layout_hdr(struct inode *inode, gfp_t gfp_flags)
+{
+	struct bc_layout_hdr *blh = kzalloc(sizeof(*blh), gfp_flags);
+
+	if (blh)
+		mutex_init(&blh->clnt_mutex);
+
+	return blh ? &blh->plh : NULL;
+}
+
+static void bc_free_layout_hdr(struct pnfs_layout_hdr *lo)
+{
+	struct bc_layout_hdr *blh = container_of(lo, struct bc_layout_hdr, plh);
+
+	/*
+	 * The client goes to a work item: this is reached under ->i_lock, and
+	 * rpc_shutdown_client() sleeps. If the allocation fails the client is
+	 * leaked rather than freed from atomic context, which is the right way
+	 * round.
+	 */
+	if (blh->clnt)
+		bc_ds_clnt_shutdown_async(blh->clnt);
+	kfree_rcu(blh, plh.plh_rcu);
+}
+
+/*
+ * Release the codecs a segment resolved; the lookups hold a reference so that a
+ * codec cannot be unloaded while a layout is still using it.
+ */
+static void bc_layout_put_codecs(struct bc_layout *bl)
+{
+	unsigned int i;
+
+	for (i = 0; i < bl->nr_codecs; i++) {
+		encoded_extent_codec_put(bl->codec[i]);
+		bl->codec[i] = NULL;
+	}
+	bl->nr_codecs = 0;
+}
+
+static struct pnfs_layout_segment *
+bc_alloc_lseg(struct pnfs_layout_hdr *lo, struct nfs4_layoutget_res *lgr,
+	      gfp_t gfp_flags)
+{
+	struct bc_layout *bl;
+	struct xdr_stream stream;
+	struct xdr_buf buf;
+	struct folio *scratch;
+	void *v;
+	__be32 *p;
+	ssize_t len;
+	u32 version, i, missing = 0;
+
+	scratch = folio_alloc(gfp_flags, 0);
+	if (!scratch)
+		return ERR_PTR(-ENOMEM);
+
+	bl = kzalloc(sizeof(*bl), gfp_flags);
+	if (!bl) {
+		folio_put(scratch);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	/* The layout body is ours, so it is decoded here, in place. */
+	xdr_init_decode_pages(&stream, &buf, lgr->layoutp->pages,
+			      lgr->layoutp->len);
+	xdr_set_scratch_folio(&stream, scratch);
+
+	p = xdr_inline_decode(&stream, 4 + 4);
+	if (!p)
+		goto out_err;
+	version = be32_to_cpup(p++);
+	bl->port = be32_to_cpup(p++);
+	if (version != BC_LAYOUT_VERSION)
+		goto out_err;
+
+	len = xdr_stream_decode_opaque_inline(&stream, &v, sizeof(bl->addr));
+	if (len < 0)
+		goto out_err;
+	bl->addr_len = len;
+	memcpy(bl->addr, v, len);
+
+	len = xdr_stream_decode_opaque_inline(&stream, &v, sizeof(bl->fh));
+	if (len < 0)
+		goto out_err;
+	bl->fh_len = len;
+	memcpy(bl->fh, v, len);
+
+	p = xdr_inline_decode(&stream, 4 + 4);
+	if (!p)
+		goto out_err;
+	bl->unit_max = be32_to_cpup(p++);
+	bl->unit_align = be32_to_cpup(p);
+
+	/*
+	 * The codecs the export may serve this file with. Each is resolved to a
+	 * local implementation now, once per segment, so the data path only
+	 * ever indexes this array - and a name this client does not have stays
+	 * in place as a hole, because the positions are the server's numbering
+	 * and must not shift.
+	 */
+	p = xdr_inline_decode(&stream, 4);
+	if (!p)
+		goto out_err;
+	bl->nr_codecs = be32_to_cpup(p);
+	if (bl->nr_codecs > ENCODED_DS_MAX_CODECS)
+		goto out_err;
+
+	for (i = 0; i < bl->nr_codecs; i++) {
+		char name[ENCODED_DS_MAX_CODEC_NAME + 1];
+
+		len = xdr_stream_decode_opaque_inline(&stream, &v,
+						      ENCODED_DS_MAX_CODEC_NAME);
+		if (len < 0)
+			goto out_err;
+		memcpy(name, v, len);
+		name[len] = '\0';
+		memcpy(bl->codec_name[i], name, len + 1);
+
+		/*
+		 * A name this client cannot resolve is asked for as a module
+		 * once before it is left as a hole: a codec's provider is a
+		 * module, the layout only names the codec, and the module that
+		 * implements it advertises MODULE_ALIAS_ENCODED_EXTENT_CODEC()
+		 * - so the first layout for a codec can load it. Whether it
+		 * resolves or not, the hole stays a hole: the positions are the
+		 * server's numbering and must not shift, and the ranges that
+		 * use a name we do not have fall back to the MDS.
+		 */
+		bl->codec[i] = encoded_extent_codec_find_or_load(
+						LAYOUT_BCACHEFS_ENCODED, name);
+		if (!bl->codec[i])
+			missing++;
+	}
+
+	/* The first codec we can encode with is the one writes use. */
+	bl->write_codec = ENCODED_DS_MAX_CODECS;
+	for (i = 0; i < bl->nr_codecs; i++)
+		if (bl->codec[i] && bl->codec[i]->encode) {
+			bl->write_codec = i;
+			break;
+		}
+
+	folio_put(scratch);
+	atomic_inc(&bc_stat_lseg_alloc);
+	atomic_set(&bc_stat_unit_max, bl->unit_max);
+	atomic_set(&bc_stat_unit_align, bl->unit_align);
+	atomic_set(&bc_stat_layout_codecs, bl->nr_codecs);
+	atomic_add(missing, &bc_stat_codec_missing);
+	atomic_set(&bc_stat_write_codec,
+		   bl->write_codec < bl->nr_codecs ? (int)bl->write_codec : -1);
+	atomic_set(&bc_stat_codec_requests,
+		   (int)encoded_extent_codec_load_attempts());
+	bc_fh_dump_update(bl);
+	bc_codec_dump_update(bl);
+	return &bl->lseg;
+
+out_err:
+	bc_layout_put_codecs(bl);
+	folio_put(scratch);
+	kfree(bl);
+	atomic_inc(&bc_stat_lseg_alloc_err);
+	return ERR_PTR(-EIO);
+}
+
+static void bc_free_lseg(struct pnfs_layout_segment *lseg)
+{
+	struct bc_layout *bl = container_of(lseg, struct bc_layout, lseg);
+
+	bc_layout_put_codecs(bl);
+	kfree(bl);
+}
+
+/*
+ * How big a request should be, from what the layout says a unit is. A request
+ * has to cover a whole unit: the service answers with the unit an offset falls
+ * in, so a request smaller than a unit asks for that unit again for every
+ * request inside it and the same bytes cross the wire twice - which is what was
+ * happening to every read on bcachefs, whose units are 256 KiB against a 128 KiB
+ * NFS read size. The same holds the other way for writes: a request smaller than
+ * a unit stores a smaller unit than the backend would take, which is a btree
+ * transaction per request instead of per unit.
+ *
+ * Beyond that there is nothing to gain by making requests bigger. The NFS
+ * layer's own window is what keeps several in flight, and a coarser request
+ * just means fewer of them - measured: an eight-unit read request was slower
+ * than a one-unit one on every shape, and a two-deep walk inside a request was
+ * faster only for direct I/O, which issues one request at a time.
+ *
+ * When there is no layout - the request is going to the MDS - the pgio keeps
+ * the size the MDS path gave it, which is why this is applied only after the
+ * layout is resolved.
+ */
+/*
+ * How many units a request should cover.
+ *
+ * The service answers with the whole unit an offset falls in, so a request that
+ * ends inside a unit makes the *next* request fetch that unit again. Measured
+ * on a production deployment whose units are ~944 KB and whose requests were one
+ * unit long: 1.8 service calls per stored unit, ds_read_wasted 0.68 - about 45%
+ * of the service's work, and of a single stream's time, spent re-fetching units
+ * the neighbouring request had already pulled. Covering N units amortises it,
+ * waste falling as ~1/N, at the cost of N units of page cache per request in
+ * flight and a proportionally longer unit walk inside the request (the walk is
+ * one unit deep, so a request's units are still fetched one after another).
+ *
+ * 1 is the previous behaviour - one request, one unit - and also the control, so
+ * it stays the default until a real workload says otherwise; the right value
+ * depends on the stored unit size, the storage's latency and how much readahead
+ * the mount is given, and it is writable in debugfs so it can be swept without
+ * a rebuild or a remount. See doc/gotchas.md.
+ */
+#define BC_PG_UNITS_MAX		16
+#define BC_PG_BSIZE_MAX		(8U << 20)
+static unsigned int bc_pg_units = 1;
+
+static size_t
+bc_pg_bsize(struct nfs_pageio_descriptor *pgio, size_t mds_bsize)
+{
+	struct bc_layout *bl;
+	size_t unit_max, units;
+
+	if (!pgio->pg_lseg)
+		return 0;
+	bl = container_of(pgio->pg_lseg, struct bc_layout, lseg);
+	if (!bl->unit_max)
+		return 0;
+
+	/*
+	 * The debugfs file is not validated on write, so the clamp is where the
+	 * value is trusted, and unit_max is clamped the same way before the
+	 * multiplication so that neither can overflow it.
+	 */
+	unit_max = min_t(size_t, bl->unit_max, (size_t)ENCODED_DS_MAX_PAYLOAD);
+	units = clamp_t(size_t, READ_ONCE(bc_pg_units), 1, BC_PG_UNITS_MAX);
+
+	return min_t(size_t, max_t(size_t, unit_max * units, mds_bsize),
+		     (size_t)BC_PG_BSIZE_MAX);
+}
+
+static void
+bc_pg_init_read(struct nfs_pageio_descriptor *pgio, struct nfs_page *req)
+{
+	size_t bsize;
+
+	/*
+	 * TODO: if this request cannot be served as part of an encoded extent
+	 * (sub-block, or a range the data service has no encoded extent for),
+	 * reset to the MDS here, as blocklayout does.
+	 */
+	pnfs_generic_pg_init_read(pgio, req);
+
+	bsize = bc_pg_bsize(pgio, NFS_SERVER(pgio->pg_inode)->rsize);
+	if (bsize)
+		pgio->pg_mirrors[0].pg_bsize = bsize;
+}
+
+static void
+bc_pg_init_write(struct nfs_pageio_descriptor *pgio, struct nfs_page *req)
+{
+	loff_t size = i_size_read(pgio->pg_inode);
+	loff_t off = req_offset(req);
+	u64 wb_size = size > off ? size - off : req->wb_bytes;
+	size_t bsize;
+
+	pnfs_generic_pg_init_write(pgio, req, wb_size);
+
+	/*
+	 * A write should cover a whole unit as well: the unit is what the client
+	 * compresses and the service stores, so a request smaller than one makes
+	 * the backend do a unit's worth of work - a btree transaction, the
+	 * checksum, the copy - for a fraction of a unit's bytes.
+	 */
+	bsize = bc_pg_bsize(pgio, NFS_SERVER(pgio->pg_inode)->wsize);
+	if (bsize)
+		pgio->pg_mirrors[0].pg_bsize = bsize;
+}
+
+static const struct nfs_pageio_ops bc_pg_read_ops = {
+	.pg_init	= bc_pg_init_read,
+	.pg_test	= pnfs_generic_pg_test,
+	.pg_doio	= pnfs_generic_pg_readpages,
+	.pg_cleanup	= pnfs_generic_pg_cleanup,
+};
+
+static const struct nfs_pageio_ops bc_pg_write_ops = {
+	.pg_init	= bc_pg_init_write,
+	.pg_test	= pnfs_generic_pg_test,
+	.pg_doio	= pnfs_generic_pg_writepages,
+	.pg_cleanup	= pnfs_generic_pg_cleanup,
+};
+
+/* The pages of a request, in order, starting at args.pgbase + skip. */
+static void
+bc_copy_to_pages(struct nfs_pgio_header *hdr, size_t skip, const void *src,
+		 size_t len)
+{
+	unsigned int pgindex = (hdr->args.pgbase + skip) >> PAGE_SHIFT;
+	unsigned int pgoff = (hdr->args.pgbase + skip) & (PAGE_SIZE - 1);
+
+	while (len) {
+		struct page *page = hdr->args.pages[pgindex];
+		size_t n = min_t(size_t, len, PAGE_SIZE - pgoff);
+
+		memcpy_to_page(page, pgoff, src, n);
+		src += n;
+		len -= n;
+		pgoff = 0;
+		pgindex++;
+	}
+}
+
+static void
+bc_copy_from_pages(struct nfs_pgio_header *hdr, size_t skip, void *dst,
+		   size_t len)
+{
+	unsigned int pgindex = (hdr->args.pgbase + skip) >> PAGE_SHIFT;
+	unsigned int pgoff = (hdr->args.pgbase + skip) & (PAGE_SIZE - 1);
+
+	while (len) {
+		struct page *page = hdr->args.pages[pgindex];
+		size_t n = min_t(size_t, len, PAGE_SIZE - pgoff);
+
+		memcpy_from_page(dst, page, pgoff, n);
+		dst += n;
+		len -= n;
+		pgoff = 0;
+		pgindex++;
+	}
+}
+
+/* ------------------------------------------------------------ the read -- */
+
+/*
+ * The most encoded payload one READ may ask for: the layout's whole unit, unless
+ * the unit is larger than the wire allows. ENCODED_DS_MAX_PAYLOAD is the
+ * service's own ceiling, and the reply is received into the caller's pages, so
+ * this is a limit of the protocol rather than of a reply buffer. A unit that
+ * does not fit is refused by the backend - it checks the length against the
+ * buffer it was given - rather than truncated, so the range falls back to the
+ * MDS, which is always correct.
+ */
+static size_t bc_ds_payload_max(const struct bc_layout *bl)
+{
+	return min_t(size_t, bl->unit_max ?: ENCODED_DS_MAX_PAYLOAD,
+		     (size_t)ENCODED_DS_MAX_PAYLOAD);
+}
+
+/*
+ * One read request, in flight. A request can cover several whole units (a
+ * 1 MiB read is eight of them), so the units are fetched one at a time and the
+ * completion of each issues the next: asynchronous, so the rest of the pgio -
+ * and every other request on this mount - keeps moving while a unit is in
+ * flight.
+ */
+struct bc_read_io {
+	struct nfs_pgio_header	*hdr;
+	struct bc_layout	*bl;
+	struct bc_layout_hdr	*blh;
+	void			*payload;	/* one encoded unit */
+	void			*plain;		/* decoded, unit_max */
+	u64			offset;		/* next byte to fetch */
+	u64			end;
+};
+
+static void
+bc_read_finish(struct bc_read_io *io, int status)
+{
+	struct nfs_pgio_header *hdr = io->hdr;
+	struct bc_layout_hdr *blh = io->blh;
+
+	kvfree(io->plain);
+	kvfree(io->payload);
+	kfree(io);
+
+	if (status) {
+		if (status == -ENODATA)
+			atomic_inc(&bc_stat_ds_read_not_encoded);
+		else {
+			atomic_inc(&bc_stat_ds_read_err);
+			atomic_set(&bc_stat_ds_last_read_err, status);
+		}
+		bc_ds_mark_down(blh, status);
+		/*
+		 * Give it back. pnfs_ld_read_done() with pnfs_error set sends
+		 * the request through the MDS instead, which is always correct.
+		 */
+		hdr->pnfs_error = status;
+		pnfs_ld_read_done(hdr);
+		return;
+	}
+
+	atomic_inc(&bc_stat_ds_read_ok);
+	hdr->res.count = hdr->args.count;
+	hdr->res.eof = false;
+	hdr->pnfs_error = 0;
+	hdr->task.tk_status = 0;
+	pnfs_ld_read_done(hdr);
+}
+
+static void
+bc_read_done(void *ctx, int status, u32 codec,
+	     const struct encoded_extent_desc *desc,
+	     void *payload, size_t payload_len)
+{
+	const struct encoded_extent_codec *c;
+	struct bc_read_io *io = ctx;
+	u64 unit_end, len;
+	size_t declen;
+	int ret;
+
+	if (status)
+		goto out_status;
+
+	if (desc->encrypted)
+		goto out_not_encoded;
+
+	/*
+	 * The descriptor names its codec by position in the layout's list. A
+	 * position this client did not resolve - a codec it does not have - is
+	 * a range it cannot decode, so it goes back to the MDS rather than
+	 * being guessed at.
+	 */
+	if (codec >= io->bl->nr_codecs || !io->bl->codec[codec] ||
+	    !io->bl->codec[codec]->decode)
+		goto out_not_encoded;
+	c = io->bl->codec[codec];
+
+	unit_end = desc->unit_offset + desc->unit_len;
+	if (io->offset < desc->unit_offset || io->offset >= unit_end)
+		goto out_not_encoded;
+
+	/* A unit larger than the segment allowed would overrun @plain. */
+	if (desc->unit_len > io->bl->unit_max)
+		goto out_failed;
+
+	atomic_set(&bc_stat_ds_last_unit_len, desc->unit_len);
+	atomic_set(&bc_stat_ds_last_payload_len, payload_len);
+
+	ret = c->decode(payload, payload_len, io->plain, desc->unit_len,
+			&declen);
+	if (ret || declen != desc->unit_len)
+		goto out_failed;
+
+	len = min(io->end, unit_end) - io->offset;
+	bc_copy_to_pages(io->hdr, io->offset - io->hdr->args.offset,
+			 io->plain + (io->offset - desc->unit_offset), len);
+	spin_lock(&bc_read_bytes_lock);
+	bc_ds_read_bytes += len;
+	bc_ds_read_wasted += desc->unit_len - len;
+	spin_unlock(&bc_read_bytes_lock);
+
+	io->offset += len;
+	if (io->offset < io->end) {
+		ret = bc_ds_read_async(io->blh, io->bl, io->offset, io->payload,
+				       bc_ds_payload_max(io->bl),
+				       bc_read_done, io);
+		if (!ret)
+			return;
+		/*
+		 * The next call was refused outright - no client is built while
+		 * the service is marked down, or a task could not be started -
+		 * so the rest of the range goes back with that reason rather
+		 * than waiting for one that is not coming.
+		 */
+		status = ret;
+		goto out_status;
+	}
+
+	bc_read_finish(io, 0);
+	return;
+
+out_failed:
+	status = -EIO;
+out_status:
+	bc_read_finish(io, status);
+	return;
+out_not_encoded:
+	bc_read_finish(io, -ENODATA);
+}
+
+static enum pnfs_try_status
+bc_read_pagelist(struct nfs_pgio_header *hdr)
+{
+	struct bc_layout *bl;
+	struct bc_layout_hdr *blh;
+	struct bc_read_io *io;
+	size_t bufsize;
+	int ret;
+
+	atomic_inc(&bc_stat_read_pagelist);
+
+	if (!hdr->lseg)
+		return PNFS_NOT_ATTEMPTED;
+
+	bl = container_of(hdr->lseg, struct bc_layout, lseg);
+	blh = container_of(bl->lseg.pls_layout, struct bc_layout_hdr, plh);
+
+	/*
+	 * The service did not answer recently: send this request to the MDS
+	 * rather than spending a timeout finding out again. See bc_ds_mark_down().
+	 */
+	if (bc_ds_is_down(blh)) {
+		atomic_inc(&bc_stat_ds_down_skips);
+		return PNFS_NOT_ATTEMPTED;
+	}
+
+	io = kzalloc(sizeof(*io), GFP_NOFS);
+	if (!io)
+		return PNFS_NOT_ATTEMPTED;
+
+	bufsize = bl->unit_max ?: ENCODED_DS_MAX_PAYLOAD;
+	io->hdr = hdr;
+	io->bl = bl;
+	io->blh = blh;
+	io->offset = hdr->args.offset;
+	io->end = hdr->args.offset + hdr->args.count;
+	/*
+	 * The plaintext buffer holds a whole unit, which is the most the service
+	 * may decode one into; the encoded payload is bounded by bc_ds_payload_max().
+	 * They are the same number unless a layout promises a unit larger than the
+	 * wire allows, in which case the units that do not fit are refused and
+	 * fall back.
+	 */
+	io->payload = kvmalloc(bc_ds_payload_max(bl), GFP_NOFS);
+	io->plain = kvmalloc(bufsize, GFP_NOFS);
+	if (!io->payload || !io->plain)
+		goto out_free;
+
+	/*
+	 * The payload is received straight into this buffer's pages, so it has
+	 * to start on a page boundary: byte 0 of the payload is offset 0 of the
+	 * first page, and an unaligned buffer would be received into the page
+	 * before it. Every allocator returns page-aligned memory for a size this
+	 * large, so this is a guard rather than a hope, and a buffer that failed
+	 * it would be a bug worth knowing about - see bc_ds_read_async().
+	 */
+	if (WARN_ON_ONCE(!PAGE_ALIGNED(io->payload)))
+		goto out_free;
+
+	ret = bc_ds_read_async(blh, bl, io->offset, io->payload,
+			       bc_ds_payload_max(bl), bc_read_done, io);
+	if (ret)
+		goto out_free;
+
+	return PNFS_ATTEMPTED;
+
+out_free:
+	kvfree(io->payload);
+	kvfree(io->plain);
+	kfree(io);
+	return PNFS_NOT_ATTEMPTED;
+}
+
+/* ----------------------------------------------------------- the write -- */
+
+struct bc_write_io {
+	struct nfs_pgio_header	*hdr;
+	struct bc_layout	*bl;
+	struct bc_layout_hdr	*blh;
+	void			*plain;
+	void			*comp;
+	u64			offset;
+	size_t			left;
+	size_t			unit;		/* the unit in flight */
+	/*
+	 * What the data service said it reached, across the units sent so far,
+	 * and its write verifier - the value a later commit of this range is
+	 * checked against, so it has to come back exactly as it arrived.
+	 */
+	u32			committed;
+	u8			verf[ENCODED_DS_WRITEVERF];
+};
+
+static void bc_write_step(struct bc_write_io *io);
+
+static void
+bc_write_finish(struct bc_write_io *io, int status)
+{
+	struct nfs_pgio_header *hdr = io->hdr;
+	struct bc_layout_hdr *blh = io->blh;
+	u32 committed = io->committed;
+	u8 verf[ENCODED_DS_WRITEVERF];
+
+	memcpy(verf, io->verf, ENCODED_DS_WRITEVERF);
+	kvfree(io->plain);
+	kvfree(io->comp);
+	kfree(io);
+
+	if (status) {
+		atomic_inc(&bc_stat_ds_write_err);
+		atomic_set(&bc_stat_ds_last_write_err, status);
+		bc_ds_mark_down(blh, status);
+		/* Same hand-back as the read side: through the MDS. */
+		hdr->pnfs_error = status;
+		pnfs_ld_write_done(hdr);
+		return;
+	}
+
+	atomic_inc(&bc_stat_ds_write_ok);
+	hdr->res.count = hdr->args.count;
+	hdr->pnfs_error = 0;
+	hdr->task.tk_status = 0;
+	/*
+	 * Report what the service reached, not what was asked for. It stored the
+	 * unit through the filesystem's own write path, which is a page cache
+	 * write unless it synced, so a durable answer is the only one that may
+	 * be passed on: claiming FILE_SYNC for an unsynced write is how an
+	 * acknowledged write is lost on a power cut.
+	 *
+	 * A DATA_SYNC answer is reported as UNSTABLE, one step down, because it
+	 * promises the data and not the metadata and this driver has no commit
+	 * hook of its own to finish the second half. The client then commits
+	 * through the MDS, which is the same filesystem here and flushes the
+	 * range either way. Anything a service should not have said is treated
+	 * the same way.
+	 */
+	BUILD_BUG_ON(ENCODED_DS_WRITEVERF != sizeof(hdr->verf.verifier.data));
+	if (committed == NFS_FILE_SYNC)
+		atomic_inc(&bc_stat_ds_write_file_sync);
+	atomic_set(&bc_stat_ds_last_committed, committed);
+	hdr->verf.committed = committed == NFS_FILE_SYNC ?
+			      NFS_FILE_SYNC : NFS_UNSTABLE;
+	memcpy(hdr->verf.verifier.data, verf, ENCODED_DS_WRITEVERF);
+	bc_write_verf_update(verf);
+	pnfs_ld_write_done(hdr);
+}
+
+static void
+bc_write_done(void *ctx, int status, u32 committed, const u8 *verf)
+{
+	struct bc_write_io *io = ctx;
+
+	if (status) {
+		bc_write_finish(io, status);
+		return;
+	}
+
+	/*
+	 * The whole write is only as durable as its least durable unit, and the
+	 * verifier is the service's for the whole run - all the units went to
+	 * the same service, so the last one's is the one a commit will see. Both
+	 * are only remembered here; the completion reports them once.
+	 */
+	if (committed < io->committed)
+		io->committed = committed;
+	memcpy(io->verf, verf, ENCODED_DS_WRITEVERF);
+
+	io->offset += io->unit;
+	io->left -= io->unit;
+	bc_write_step(io);
+}
+
+static void
+bc_write_step(struct bc_write_io *io)
+{
+	const struct encoded_extent_codec *c = io->bl->codec[io->bl->write_codec];
+	struct encoded_extent_desc desc;
+	size_t done, complen;
+	int ret;
+
+	if (!io->left) {
+		bc_write_finish(io, 0);
+		return;
+	}
+
+	io->unit = min_t(size_t, io->left, io->bl->unit_max);
+	done = io->hdr->args.count - io->left;
+
+	memset(&desc, 0, sizeof(desc));
+	desc.unit_offset = io->offset;
+	desc.unit_len = io->unit;
+
+	bc_copy_from_pages(io->hdr, done, io->plain, io->unit);
+	complen = io->bl->unit_max;
+	ret = c->encode(io->plain, io->unit, io->comp, io->bl->unit_max,
+			&complen);
+	if (ret) {
+		bc_write_finish(io, ret);
+		return;
+	}
+	if (!complen) {
+		bc_write_finish(io, -EIO);
+		return;
+	}
+
+	ret = bc_ds_write_async(io->blh, io->bl, io->offset, io->comp, complen,
+				&desc, io->bl->write_codec,
+				(u32)io->hdr->args.stable, bc_write_done, io);
+	if (ret)
+		bc_write_finish(io, ret);
+}
+
+/*
+ * The encoded write: whole, aligned units only, compressed here, stored by the
+ * data service. Anything else - an unaligned or partial request, a unit the
+ * service will not take - is handed back to the MDS, so ordinary NFS writes are
+ * what happens whenever this cannot.
+ */
+static enum pnfs_try_status
+bc_write_pagelist(struct nfs_pgio_header *hdr, int sync)
+{
+	struct bc_layout *bl;
+	struct bc_layout_hdr *blh;
+	struct bc_write_io *io;
+
+	atomic_inc(&bc_stat_write_pagelist);
+
+	if (!hdr->lseg)
+		return PNFS_NOT_ATTEMPTED;
+
+	if (hdr->args.stable != NFS_UNSTABLE)
+		atomic_inc(&bc_stat_ds_write_stable);
+
+	bl = container_of(hdr->lseg, struct bc_layout, lseg);
+	blh = container_of(bl->lseg.pls_layout, struct bc_layout_hdr, plh);
+
+	/* As on the read side: a service that just failed does not get asked
+	 * again for every unit of every request. */
+	if (bc_ds_is_down(blh)) {
+		atomic_inc(&bc_stat_ds_down_skips);
+		return PNFS_NOT_ATTEMPTED;
+	}
+
+	if (!bl->unit_align || !bl->unit_max ||
+	    bl->write_codec >= bl->nr_codecs ||
+	    hdr->args.offset % bl->unit_align ||
+	    hdr->args.count % bl->unit_align ||
+	    hdr->args.pgbase % bl->unit_align)
+		return PNFS_NOT_ATTEMPTED;
+
+	io = kzalloc(sizeof(*io), GFP_NOFS);
+	if (!io)
+		return PNFS_NOT_ATTEMPTED;
+
+	io->hdr = hdr;
+	io->bl = bl;
+	io->blh = blh;
+	io->offset = hdr->args.offset;
+	io->left = hdr->args.count;
+	/*
+	 * Every unit is asked for the level this request needs, so the run starts
+	 * at that level and each reply can only lower it.
+	 */
+	io->committed = (u32)hdr->args.stable;
+	io->plain = kvmalloc(bl->unit_max, GFP_NOFS);
+	io->comp = kvmalloc(bl->unit_max, GFP_NOFS);
+	if (!io->plain || !io->comp) {
+		kvfree(io->plain);
+		kvfree(io->comp);
+		kfree(io);
+		return PNFS_NOT_ATTEMPTED;
+	}
+
+	bc_write_step(io);
+	return PNFS_ATTEMPTED;
+}
+
+/*
+ * Reached from nfs_wb_all() on flush of a written file. The generic NFS version
+ * below it sends LAYOUTCOMMIT if a write through the data service marked the
+ * inode for one - which is how the server's own view of the file gets a chance
+ * to catch up. This only counts that we got there.
+ */
+static int
+bc_sync(struct inode *inode, bool datasync)
+{
+	atomic_inc(&bc_stat_sync);
+	return pnfs_nfs_generic_sync(inode, datasync);
+}
+
+static struct pnfs_layoutdriver_type bc_layout_type = {
+	.id			= LAYOUT_BCACHEFS_ENCODED,
+	.name			= "LAYOUT_BCACHEFS_ENCODED",
+	.owner			= THIS_MODULE,
+	.flags			= PNFS_LAYOUTGET_ON_OPEN,
+	.max_layoutget_response	= 4096,
+	.alloc_layout_hdr	= bc_alloc_layout_hdr,
+	.free_layout_hdr	= bc_free_layout_hdr,
+	.alloc_lseg		= bc_alloc_lseg,
+	.free_lseg		= bc_free_lseg,
+	.pg_read_ops		= &bc_pg_read_ops,
+	.pg_write_ops		= &bc_pg_write_ops,
+	.read_pagelist		= bc_read_pagelist,
+	.write_pagelist		= bc_write_pagelist,
+	/*
+	 * pnfs_sync_inode() calls this without a NULL check, and it is reached
+	 * from nfs_wb_all() on every flush of a file on this mount; leaving it
+	 * out is a call to address zero on the first write. The generic NFS
+	 * version commits any outstanding layout segment, which for a driver
+	 * with no prepare/cleanup_layoutcommit is a no-op.
+	 */
+	.sync			= bc_sync,
+};
+
+static int __init bc_layout_init(void)
+{
+	int ret;
+
+	bc_debugfs_dir = debugfs_create_dir("pnfs_bcachefs", NULL);
+	if (!IS_ERR_OR_NULL(bc_debugfs_dir)) {
+		debugfs_create_atomic_t("lseg_alloc", 0444, bc_debugfs_dir,
+					&bc_stat_lseg_alloc);
+		debugfs_create_atomic_t("lseg_alloc_err", 0444, bc_debugfs_dir,
+					&bc_stat_lseg_alloc_err);
+		debugfs_create_atomic_t("read_pagelist", 0444, bc_debugfs_dir,
+					&bc_stat_read_pagelist);
+		debugfs_create_atomic_t("write_pagelist", 0444, bc_debugfs_dir,
+					&bc_stat_write_pagelist);
+		debugfs_create_atomic_t("unit_max", 0444, bc_debugfs_dir,
+					&bc_stat_unit_max);
+		/* Writable: units per request, the experiment's one knob. */
+		debugfs_create_u32("pg_units", 0644, bc_debugfs_dir,
+				   &bc_pg_units);
+		debugfs_create_atomic_t("unit_align", 0444, bc_debugfs_dir,
+					&bc_stat_unit_align);
+		debugfs_create_atomic_t("layout_codecs", 0444, bc_debugfs_dir,
+					&bc_stat_layout_codecs);
+		debugfs_create_atomic_t("codec_missing", 0444, bc_debugfs_dir,
+					&bc_stat_codec_missing);
+		debugfs_create_atomic_t("codec_requests", 0444, bc_debugfs_dir,
+					&bc_stat_codec_requests);
+		debugfs_create_atomic_t("write_codec", 0444, bc_debugfs_dir,
+					&bc_stat_write_codec);
+		debugfs_create_atomic_t("ds_read_not_encoded", 0444, bc_debugfs_dir,
+					&bc_stat_ds_read_not_encoded);
+		debugfs_create_atomic_t("ds_read_err", 0444, bc_debugfs_dir,
+					&bc_stat_ds_read_err);
+		debugfs_create_atomic_t("ds_read_ok", 0444, bc_debugfs_dir,
+					&bc_stat_ds_read_ok);
+		debugfs_create_u64("ds_read_bytes", 0444, bc_debugfs_dir,
+				   &bc_ds_read_bytes);
+		debugfs_create_u64("ds_read_wasted", 0444, bc_debugfs_dir,
+				   &bc_ds_read_wasted);
+		debugfs_create_atomic_t("ds_last_read_err", 0444, bc_debugfs_dir,
+					&bc_stat_ds_last_read_err);
+		debugfs_create_atomic_t("ds_last_unit_len", 0444, bc_debugfs_dir,
+					&bc_stat_ds_last_unit_len);
+		debugfs_create_atomic_t("ds_last_payload_len", 0444, bc_debugfs_dir,
+					&bc_stat_ds_last_payload_len);
+		debugfs_create_atomic_t("ds_write_ok", 0444, bc_debugfs_dir,
+					&bc_stat_ds_write_ok);
+		debugfs_create_atomic_t("ds_write_err", 0444, bc_debugfs_dir,
+					&bc_stat_ds_write_err);
+		debugfs_create_atomic_t("ds_down", 0444, bc_debugfs_dir,
+					&bc_stat_ds_down);
+		debugfs_create_atomic_t("ds_down_skips", 0444, bc_debugfs_dir,
+					&bc_stat_ds_down_skips);
+		debugfs_create_atomic_t("ds_last_write_err", 0444, bc_debugfs_dir,
+					&bc_stat_ds_last_write_err);
+		debugfs_create_atomic_t("ds_write_stable", 0444, bc_debugfs_dir,
+					&bc_stat_ds_write_stable);
+		debugfs_create_atomic_t("ds_write_file_sync", 0444, bc_debugfs_dir,
+					&bc_stat_ds_write_file_sync);
+		debugfs_create_atomic_t("ds_last_committed", 0444, bc_debugfs_dir,
+					&bc_stat_ds_last_committed);
+		debugfs_create_atomic_t("sync", 0444, bc_debugfs_dir,
+					&bc_stat_sync);
+		debugfs_create_file("layout_fh", 0444, bc_debugfs_dir, NULL,
+				    &bc_fh_dump_fops);
+		debugfs_create_file("codec_names", 0444, bc_debugfs_dir, NULL,
+				    &bc_codec_dump_fops);
+		debugfs_create_file("write_verf", 0444, bc_debugfs_dir, NULL,
+				    &bc_write_verf_fops);
+	}
+
+	ret = pnfs_register_layoutdriver(&bc_layout_type);
+	if (ret) {
+		debugfs_remove_recursive(bc_debugfs_dir);
+		bc_debugfs_dir = NULL;
+	}
+	return ret;
+}
+
+static void __exit bc_layout_exit(void)
+{
+	pnfs_unregister_layoutdriver(&bc_layout_type);
+	debugfs_remove_recursive(bc_debugfs_dir);
+	bc_debugfs_dir = NULL;
+}
+
+module_init(bc_layout_init);
+module_exit(bc_layout_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("pNFS layout driver for bcachefs encoded extents");
