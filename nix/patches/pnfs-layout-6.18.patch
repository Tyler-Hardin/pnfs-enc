diff --git a/fs/btrfs/encoded_extent.c b/fs/btrfs/encoded_extent.c
new file mode 100644
index 000000000..8ff34aea6
--- /dev/null
+++ b/fs/btrfs/encoded_extent.c
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Encoded extent I/O for btrfs, as an encoded_extent_ops backend.
+ *
+ * btrfs has had this data path since BTRFS_IOC_ENCODED_READ/ENCODED_WRITE were
+ * added for send/receive --compressed-data: move a compressed, checksummed
+ * extent - the bytes as they are on disk, verified, not decompressed - between
+ * a userspace buffer and the filesystem. This file exposes the same thing to
+ * in-kernel callers, so that a serving path (pNFS's read_pagelist/write_pagelist)
+ * can move encoded extents with the client doing the codec work.
+ *
+ * The two ioctls' bodies are factored out into btrfs_encoded_read_file() and
+ * btrfs_encoded_write_file() here; the ioctls keep the userspace half (cap
+ * check, copy_from_user, iovec import, accounting) and call them. Nothing
+ * about the I/O itself changed.
+ *
+ * Checksums stay btrfs's: it verifies them on read before handing the encoded
+ * bytes back, and computes them on write, so a caller never touches csum code
+ * and a client cannot store an extent whose checksum does not describe it.
+ * Compression is stored per extent as a type, which is all a reader needs.
+ *
+ * This file is also where btrfs's codecs are registered, because this is the
+ * boundary at which they leave the filesystem: the codec numbers in a
+ * descriptor are btrfs's own, and the codec table is what lets a peer decode an
+ * extent without knowing them. See the codec section at the end.
+ */
+
+#include <linux/encoded_extent.h>
+#include <linux/fsnotify.h>
+#include <linux/module.h>
+#include <linux/nfs4.h>
+#include <linux/slab.h>
+#include <linux/uio.h>
+#include <linux/zstd.h>
+
+#include "ctree.h"
+#include "btrfs_inode.h"
+#include "compression.h"
+#include "extent_map.h"
+#include "file.h"
+
+/*
+ * The in-kernel entry points. @args is the ioctl's argument block, already
+ * validated and with its metadata filled in; @iter carries the encoded data.
+ */
+int btrfs_encoded_read_file(struct file *file,
+			    struct btrfs_ioctl_encoded_io_args *args,
+			    struct iov_iter *iter)
+{
+	struct btrfs_inode *inode = BTRFS_I(file_inode(file));
+	struct btrfs_fs_info *fs_info = inode->root->fs_info;
+	struct extent_io_tree *io_tree = &inode->io_tree;
+	struct extent_state *cached_state = NULL;
+	u64 disk_bytenr, disk_io_size;
+	loff_t pos = args->offset;
+	struct kiocb kiocb;
+	ssize_t ret;
+
+	if (iov_iter_count(iter) == 0)
+		return 0;
+
+	ret = rw_verify_area(READ, file, &pos, args->len);
+	if (ret < 0)
+		return ret;
+
+	init_sync_kiocb(&kiocb, file);
+	kiocb.ki_pos = pos;
+
+	ret = btrfs_encoded_read(&kiocb, iter, args, &cached_state,
+				 &disk_bytenr, &disk_io_size);
+	if (ret == -EIOCBQUEUED) {
+		bool unlocked = false;
+		u64 start, lockend, count;
+
+		start = ALIGN_DOWN(kiocb.ki_pos, fs_info->sectorsize);
+		lockend = start + BTRFS_MAX_UNCOMPRESSED - 1;
+
+		if (args->compression)
+			count = disk_io_size;
+		else
+			count = args->len;
+
+		ret = btrfs_encoded_read_regular(&kiocb, iter, start, lockend,
+						 &cached_state, disk_bytenr,
+						 disk_io_size, count,
+						 args->compression, &unlocked);
+
+		if (!unlocked) {
+			btrfs_unlock_extent(io_tree, start, lockend, &cached_state);
+			btrfs_inode_unlock(inode, BTRFS_ILOCK_SHARED);
+		}
+	}
+
+	if (ret >= 0)
+		fsnotify_access(file);
+
+	return ret;
+}
+
+int btrfs_encoded_write_file(struct file *file,
+			     struct btrfs_ioctl_encoded_io_args *args,
+			     struct iov_iter *iter)
+{
+	loff_t pos = args->offset;
+	struct kiocb kiocb;
+	ssize_t ret;
+
+	if (iov_iter_count(iter) == 0)
+		return 0;
+
+	ret = rw_verify_area(WRITE, file, &pos, args->len);
+	if (ret < 0)
+		return ret;
+
+	init_sync_kiocb(&kiocb, file);
+	ret = kiocb_set_rw_flags(&kiocb, 0, WRITE);
+	if (ret)
+		return ret;
+	kiocb.ki_pos = pos;
+
+	file_start_write(file);
+
+	ret = btrfs_do_write_iter(&kiocb, iter, args);
+	if (ret > 0)
+		fsnotify_modify(file);
+
+	file_end_write(file);
+
+	return ret;
+}
+
+/* ------------------------------------------------- the encoded_extent_ops -- */
+
+static int btrfs_encoded_extent_read(struct file *file, u64 offset, size_t len,
+				     void *dst, size_t *dst_len,
+				     struct encoded_extent_desc *desc)
+{
+	struct btrfs_ioctl_encoded_io_args args = {
+		.offset		= offset,
+		.len		= len,
+		.unencoded_len	= *dst_len,
+	};
+	struct kvec kvec = { .iov_base = dst, .iov_len = *dst_len };
+	struct iov_iter iter;
+	int ret;
+
+	/*
+	 * A kvec iterator, not iov_iter_init(): the destination is a kernel
+	 * buffer, and iov_iter_init() builds an iterator over *user* iovecs, so
+	 * btrfs's copy_page_to_iter() would go through copy_to_user() on a
+	 * kernel address and fail with -EFAULT.
+	 */
+	iov_iter_kvec(&iter, ITER_DEST, &kvec, 1, *dst_len);
+
+	ret = btrfs_encoded_read_file(file, &args, &iter);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * No compression means the extent was a hole or stored uncompressed:
+	 * there is no codec work to offload, so the caller uses ordinary I/O.
+	 */
+	if (args.compression == BTRFS_ENCODED_IO_COMPRESSION_NONE)
+		return -ENODATA;
+
+	desc->unit_offset	= offset - args.unencoded_offset;
+	desc->unit_len		= args.unencoded_len;
+	desc->unencoded_offset	= args.unencoded_offset;
+	desc->compression	= args.compression;
+	desc->encrypted		= false;
+
+	*dst_len = ret;
+	return 0;
+}
+
+/*
+ * Store the encoded unit. A successful write has reached the page cache, not
+ * the disk, which is what the sync that follows settles: see
+ * encoded_extent_sync().
+ */
+static int btrfs_encoded_extent_write(struct file *file, u64 offset,
+				      const void *src, size_t len,
+				      const struct encoded_extent_desc *desc,
+				      enum encoded_extent_stable how,
+				      enum encoded_extent_stable *committed)
+{
+	struct btrfs_ioctl_encoded_io_args args = {
+		.offset			= offset,
+		.len			= desc->unit_len,
+		.unencoded_len		= desc->unit_len,
+		.unencoded_offset	= desc->unencoded_offset,
+		.compression		= desc->compression,
+		.encryption		= BTRFS_ENCODED_IO_ENCRYPTION_NONE,
+	};
+	struct kvec kvec = { .iov_base = (void *) src, .iov_len = len };
+	struct iov_iter iter;
+	int ret;
+
+	if (desc->encrypted)
+		return -ENODATA;
+	if (len > BTRFS_MAX_COMPRESSED)
+		return -E2BIG;
+
+	iov_iter_kvec(&iter, ITER_SOURCE, &kvec, 1, len);
+
+	ret = btrfs_encoded_write_file(file, &args, &iter);
+	if (ret < 0)
+		return ret;
+
+	return encoded_extent_sync(file, desc->unit_offset, desc->unit_len,
+				   how, committed);
+}
+
+static int btrfs_encoded_extent_probe(struct file *file, u64 offset, size_t len,
+				      struct encoded_extent_desc *desc)
+{
+	struct btrfs_inode *inode = BTRFS_I(file_inode(file));
+	struct btrfs_fs_info *fs_info = inode->root->fs_info;
+	struct extent_map *em;
+	int ret;
+
+	ret = btrfs_inode_lock(inode, BTRFS_ILOCK_SHARED);
+	if (ret)
+		return ret;
+
+	em = btrfs_get_extent(inode, NULL, offset, len);
+	if (IS_ERR(em)) {
+		ret = PTR_ERR(em);
+		goto out_unlock;
+	}
+
+	ret = -ENODATA;
+	if (em->disk_bytenr == EXTENT_MAP_HOLE ||
+	    em->disk_bytenr == EXTENT_MAP_INLINE)
+		goto out_free;
+
+	ret = btrfs_encoded_io_compression_from_extent(
+			fs_info, btrfs_extent_map_compression(em));
+	if (ret < 0)
+		goto out_free;
+
+	/*
+	 * No compression means there is no codec work to offload, so this is
+	 * the same "not served encoded" answer the read op gives: a probe that
+	 * said yes here would send the caller looking for a codec it does not
+	 * need and cannot use.
+	 */
+	if (ret == BTRFS_ENCODED_IO_COMPRESSION_NONE) {
+		ret = -ENODATA;
+		goto out_free;
+	}
+
+	desc->unit_offset	= em->start - em->offset;
+	desc->unit_len		= em->ram_bytes;
+	desc->unencoded_offset	= offset - desc->unit_offset;
+	desc->compression	= ret;
+	desc->encrypted		= false;
+	ret = 0;
+
+out_free:
+	btrfs_free_extent_map(em);
+out_unlock:
+	btrfs_inode_unlock(inode, BTRFS_ILOCK_SHARED);
+	return ret;
+}
+
+static u32 btrfs_encoded_extent_unit_max(struct inode *inode)
+{
+	return BTRFS_MAX_COMPRESSED;
+}
+
+static u32 btrfs_encoded_extent_unit_align(struct inode *inode)
+{
+	return BTRFS_I(inode)->root->fs_info->sectorsize;
+}
+
+/* --------------------------------------------------------------- codecs -- */
+
+/*
+ * The codecs btrfs may store an encoded extent with, which is what makes this
+ * the owner of the naming: the numbers here are the ones the read and probe
+ * paths above put in a descriptor, and the names are what a peer resolves them
+ * back from. btrfs also stores zlib and lzo, and their numbers are just as
+ * valid to a descriptor; they are simply not registered, so those extents are
+ * not served encoded and fall back to ordinary I/O - which is the correct
+ * degradation, and is why this table rather than the backend's numbering is
+ * what decides.
+ *
+ * The framing is btrfs's, so a peer decodes exactly what btrfs would decode and
+ * encodes what btrfs's reader accepts. The window is the part that is not
+ * obvious: btrfs's decoder is given ZSTD_BTRFS_MAX_INPUT and will not read a
+ * frame that needs more, so the encoder must not produce one.
+ *
+ * The level is the encoder's own choice and nothing else's: a zstd frame
+ * carries no level, so a peer - or btrfs itself, reading the extent later - does
+ * not need to know it. This is the client spending its own CPU to save the
+ * server's, which is the point of the whole path, so it is the cheap end.
+ */
+#define BTRFS_ENCODED_ZSTD_LEVEL	1
+
+static int btrfs_encoded_zstd_decode(const void *src, size_t src_len,
+				     void *dst, size_t dst_cap, size_t *dst_len)
+{
+	zstd_dstream *stream;
+	zstd_in_buffer in = { .src = src, .size = src_len, .pos = 0 };
+	zstd_out_buffer out = { .dst = dst, .size = dst_cap, .pos = 0 };
+	size_t workspace_size, ret, prev;
+	void *workspace;
+
+	workspace_size = zstd_dstream_workspace_bound(ZSTD_BTRFS_MAX_INPUT);
+	workspace = kvmalloc(workspace_size, GFP_NOFS);
+	if (!workspace)
+		return -ENOMEM;
+
+	stream = zstd_init_dstream(ZSTD_BTRFS_MAX_INPUT, workspace,
+				   workspace_size);
+	if (!stream) {
+		kvfree(workspace);
+		return -EIO;
+	}
+
+	/*
+	 * A btrfs encoded extent is one or more zstd frames, so this runs until
+	 * the input or the output is exhausted. How much plaintext came out is
+	 * the caller's to check against the unit length it was promised - that
+	 * check is what binds a payload to the pages it may fill.
+	 */
+	do {
+		prev = in.pos + out.pos;
+		ret = zstd_decompress_stream(stream, &out, &in);
+		if (zstd_is_error(ret)) {
+			kvfree(workspace);
+			return -EIO;
+		}
+	} while (in.pos < in.size && out.pos < out.size &&
+		 in.pos + out.pos != prev);
+
+	*dst_len = out.pos;
+	kvfree(workspace);
+	return 0;
+}
+
+static int btrfs_encoded_zstd_encode(const void *src, size_t src_len,
+				     void *dst, size_t dst_cap, size_t *dst_len)
+{
+	zstd_parameters params = zstd_get_params(BTRFS_ENCODED_ZSTD_LEVEL,
+						 src_len);
+	zstd_in_buffer in = { .src = src, .size = src_len, .pos = 0 };
+	zstd_out_buffer out = { .dst = dst, .size = dst_cap, .pos = 0 };
+	zstd_cstream *cstream;
+	void *workspace;
+	size_t workspace_size, ret;
+
+	if (params.cParams.windowLog > ZSTD_BTRFS_MAX_WINDOWLOG)
+		params.cParams.windowLog = ZSTD_BTRFS_MAX_WINDOWLOG;
+
+	workspace_size = zstd_cstream_workspace_bound(&params.cParams);
+	workspace = kvmalloc(workspace_size, GFP_NOFS);
+	if (!workspace)
+		return -ENOMEM;
+
+	cstream = zstd_init_cstream(&params, src_len, workspace, workspace_size);
+	if (!cstream) {
+		kvfree(workspace);
+		return -EIO;
+	}
+
+	do {
+		ret = zstd_compress_stream(cstream, &out, &in);
+		if (zstd_is_error(ret)) {
+			kvfree(workspace);
+			return -EIO;
+		}
+		if (out.pos == out.size && in.pos < in.size) {
+			kvfree(workspace);
+			return -E2BIG;
+		}
+	} while (in.pos < in.size);
+
+	do {
+		ret = zstd_end_stream(cstream, &out);
+		if (zstd_is_error(ret)) {
+			kvfree(workspace);
+			return -EIO;
+		}
+		if (ret && out.pos == out.size) {
+			kvfree(workspace);
+			return -E2BIG;
+		}
+	} while (ret);
+
+	*dst_len = out.pos;
+	kvfree(workspace);
+	return 0;
+}
+
+static const struct encoded_extent_codec btrfs_encoded_zstd_codec = {
+	.owner		= THIS_MODULE,
+	.compression	= BTRFS_ENCODED_IO_COMPRESSION_ZSTD,
+	.name		= "zstd",
+	.decode		= btrfs_encoded_zstd_decode,
+	.encode		= btrfs_encoded_zstd_encode,
+};
+
+static const struct encoded_extent_codec * const btrfs_encoded_extent_codecs[] = {
+	&btrfs_encoded_zstd_codec,
+};
+
+/* What a peer sees of this filesystem's encoded extents: the flags, the ops, and
+ * the codec table above, which is where a descriptor's codec position is
+ * resolved - this filesystem's positions, not every registrant's. */
+const struct encoded_extent_ops btrfs_encoded_extent_ops = {
+	.codecs		= btrfs_encoded_extent_codecs,
+	.nr_codecs	= ARRAY_SIZE(btrfs_encoded_extent_codecs),
+	.unit_max	= btrfs_encoded_extent_unit_max,
+	.unit_align	= btrfs_encoded_extent_unit_align,
+	.read		= btrfs_encoded_extent_read,
+	.write		= btrfs_encoded_extent_write,
+	.probe		= btrfs_encoded_extent_probe,
+};
+
+/*
+ * How a peer that does not have this codec finds the module that does: it asks
+ * for the alias, and modprobe loads this module. (btrfs is usually built in,
+ * where the alias simply does not exist and there is nothing to load.)
+ */
+MODULE_ALIAS_ENCODED_EXTENT_CODEC("zstd");
+
+/*
+ * Registered under the layout type the spike exports under; a real btrfs
+ * encoded extent reaches a peer over whatever layout type an export negotiates,
+ * and this is the one wired to this table. The registration's lifetime is the
+ * module's, which is what keeps a codec from being unloaded under a layout.
+ */
+int btrfs_encoded_extent_codecs_init(void)
+{
+#if IS_ENABLED(CONFIG_ENCODED_EXTENT_CODECS)
+	return encoded_extent_codec_register(LAYOUT_BCACHEFS_ENCODED,
+			btrfs_encoded_extent_codecs,
+			ARRAY_SIZE(btrfs_encoded_extent_codecs));
+#else
+	return 0;
+#endif
+}
+
+void btrfs_encoded_extent_codecs_exit(void)
+{
+#if IS_ENABLED(CONFIG_ENCODED_EXTENT_CODECS)
+	encoded_extent_codec_unregister(LAYOUT_BCACHEFS_ENCODED,
+					btrfs_encoded_extent_codecs);
+#endif
+}
